# Dependencies
node_modules

# Build output & framework caches
.output
.vercel
.netlify
.wrangler
.turbo
dist
/.svelte-kit
/build

# Local grammar draft/build artifacts (regenerable, heavy)
# (note: `.grammar-build/*` not `.grammar-build/` so the qa/ subdir can be re-included —
#  git cannot re-include children of an excluded directory)
.grammar-build/*
# QA campaign plan + findings ledger are NOT regenerable — keep versioned
!.grammar-build/qa/

# Generated full-text search index (built by scripts/gen-grammar-search.ts)
static/grammar-search.json

# OS
.DS_Store
Thumbs.db

# Env / secrets
.env
.env.*
!.env.example
!.env.test

# Logs
*.log
devserver.log

# Vite
vite.config.js.timestamp-*
vite.config.ts.timestamp-*
.playwright-mcp/

# Dumps of published sources — rights managed via rights.json, not tracked
books/

# aynu MCP manifest cache
.archive/

# Generated knowledge-base projections (built by scripts/kb/build.ts)
static/kb/

# Source full texts stay local: OCR and text dumps of the sources, and the
# Handbook section leaves. Statements quote them at their locus.
kb/imports/ocr/
kb/imports/handbook-2022/

# Extraction progress and logs (resumable runs; regenerated)
kb/statements/.progress/

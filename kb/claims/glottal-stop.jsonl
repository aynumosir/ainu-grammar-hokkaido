{"id":"claim:phon/glottal-stop--onset-glottal-stop-before-vowels","revision":1,"topic":"topic:phon/glottal-stop","topics":["topic:phon/glottal-stop","topic:phon/glottal-stop--distribution"],"statement":{"en":"Vowel-initial syllables phonetically take an onset glottal stop.","ja":"母音で始まる音節の初頭には音声的に声門閉鎖音が現れる。"},"type":"distribution","scope":{"doculects":["doculect:ainu"],"quantifier":"all","modality":"assertive","conditions":[]},"forms":[],"statements":[{"id":"stmt:shibatani1990@gemini-3-flash-preview/l0014-06","stance":"asserts"},{"id":"stmt:shiraishi2022@handbook-epub/l0083-12","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-06-38-590Z","status":"grouped"}
{"id":"claim:phon/glottal-stop--glottal-stop-boundary-marker-not-phoneme","revision":1,"topic":"topic:phon/glottal-stop","topics":["topic:phon/glottal-stop","topic:phon/glottal-stop--phonemicity"],"statement":{"en":"The glottal stop is not an independent phoneme but a phonetic boundary marker indicating a syllable boundary before a vowel.","ja":"声門閉鎖音は独立した音素ではなく、母音の前に音節の区切りを示す音声的境界指標である。"},"type":"analysis","scope":{"doculects":["doculect:ainu"],"quantifier":"all","modality":"assertive","conditions":[]},"forms":["ʼ"],"statements":[{"id":"stmt:nakagawa2024@gemini-3-flash-preview/l0030-02","stance":"asserts"},{"id":"stmt:nakagawa2024@gemini-3-flash-preview/l0031-02","stance":"asserts"}],"relations":[{"kind":"supports","claim":"claim:phon/glottal-stop--onset-glottal-stop-before-vowels","differs_in":"level-of-analysis","note":"Interprets the predictable onset glottal stop as a subphonemic boundary marker rather than an underlying segment."}],"grouped_by":"act:group/2026-09-10T15-06-38-590Z","status":"grouped"}
{"id":"claim:phon/glottal-stop--shizunai-hi-initial-h-deletion","revision":1,"topic":"topic:phon/glottal-stop","topics":["topic:phon/glottal-stop","topic:phon/glottal-stop--h-onset"],"statement":{"en":"In the Shizunai dialect, the consonant [h] of the nominalizer hi is usually elided in all but very slow speech.","ja":"静内方言において、形式名詞 hi の語頭の [h] は極めて遅い発話を除いて通常脱落する。"},"type":"alternation","scope":{"doculects":["doculect:hokkaido/southwest/shizunai"],"quantifier":"all","modality":"assertive","conditions":["in all but very slow speech"]},"forms":["hi"],"statements":[{"id":"stmt:refsing1986@gemini-3-flash-preview/l0226-02","stance":"asserts"},{"id":"stmt:refsing1986@gemini-3-flash-preview/l0227-02","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-06-38-590Z","status":"grouped"}
{"id":"claim:phon/glottal-stop--the-glottal-stop-occurs-syllable-initially-when-there","revision":1,"topic":"topic:phon/glottal-stop","topics":["topic:phon/glottal-stop","topic:phon/glottal-stop--distribution"],"statement":{"en":"The glottal stop /ʔ/ occurs syllable-initially when there is no other initial consonant.","ja":"声門閉鎖音/ʔ/は、他に頭子音がない場合に音節頭に生じる。"},"type":"distribution","scope":{"doculects":["doculect:hokkaido/southwest"],"quantifier":"all","modality":"necessary","conditions":["when there is no other initial consonant"]},"forms":["/ʔ/"],"statements":[{"id":"stmt:bugaeva2012@gemini-3-flash-preview/l0004-02","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-06-38-590Z","status":"grouped"}
{"id":"claim:phon/glottal-stop--in-sakhalin-ainu-vowel-initial-syllables-are-analyzed","revision":1,"topic":"topic:phon/glottal-stop","topics":["topic:phon/glottal-stop","topic:phon/glottal-stop--distribution"],"statement":{"en":"In Sakhalin Ainu, vowel-initial syllables are analyzed as having an onset glottal stop /ʔ/, resulting in C1V, C1VV, or C1VC2 structures.","ja":"樺太アイヌ語では母音で始まる音節は母音の前に声門閉鎖音/ʔ/があると見なされ、C1V、C1VV、あるいはC1VC2の音節構造となる。"},"type":"analysis","scope":{"doculects":["doculect:sakhalin"],"quantifier":"all","modality":"necessary","conditions":["in vowel-initial syllables"]},"forms":["ʔ"],"statements":[{"id":"stmt:itabashi2001@pdftotext-pieces/l0004-02","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-06-38-590Z","status":"grouped"}
{"id":"claim:phon/glottal-stop--in-kuril-ainu-syllables-beginning-with-a-vowel","revision":1,"topic":"topic:phon/glottal-stop","topics":["topic:phon/glottal-stop","topic:phon/glottal-stop--distribution"],"statement":{"en":"In Kuril Ainu, syllables beginning with a vowel are regarded as having a glottal stop /ʔ/ before the vowel, yielding C1V or C1VC2 syllables.","ja":"千島アイヌ語において、母音で始まる音節は母音の前に声門閉鎖音/ʔ/があると見なすので、C1VまたはC1VC2の音節となる。"},"type":"analysis","scope":{"doculects":["doculect:kuril"],"quantifier":"all","modality":"actual","conditions":[]},"forms":["ʔ"],"statements":[{"id":"stmt:itabashi2001@pdftotext-pieces/l0006-02","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-06-38-590Z","status":"grouped"}
{"id":"claim:phon/glottal-stop--the-glottal-stop-does-not-distinguish-lexical-meaning","revision":1,"topic":"topic:phon/glottal-stop","topics":["topic:phon/glottal-stop","topic:phon/glottal-stop--distribution"],"statement":{"en":"The glottal stop does not distinguish lexical meaning word-initially (e.g. [e] vs. [ʼe]) or across consonant-vowel boundaries (e.g. [itakʼan] vs. [itakan]).","ja":"アイヌ語において、語頭における声門破裂音の有無（例：[e] と [ʼe]）や子音・母音間での有無（例：[itakʼan] と [itakan]）が単語の意味を区別することはない。"},"type":"absence","scope":{"doculects":["doculect:ainu"],"quantifier":"none","modality":"actual","conditions":[]},"forms":["ʼ","itak-an"],"statements":[{"id":"stmt:nakagawa2024@gemini-3-flash-preview/l0030-01","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-06-38-590Z","status":"grouped"}
{"id":"claim:phon/glottal-stop--the-glottal-stop-is-pronounced-by-breaking-the","revision":1,"topic":"topic:phon/glottal-stop","topics":["topic:phon/glottal-stop","topic:phon/glottal-stop--distribution"],"statement":{"en":"The glottal stop [ʔ] is pronounced by breaking the transition between vowels or between a consonant and a vowel.","ja":"喉音音素（声門閉鎖音 [ʔ]）は、母音と母音、または子音と母音の間を区切って発音される音である。"},"type":"form-function","scope":{"doculects":["doculect:ainu"],"quantifier":"unstated","modality":"actual","conditions":[]},"forms":["o'ohoy","sinot-'an"],"statements":[{"id":"stmt:sato2008@gemini-3-flash-preview/l0013-03","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-06-38-590Z","status":"grouped"}
{"id":"claim:phon/glottal-stop--in-this-phonemic-analysis-of-sakhalin-ainu-vowel","revision":1,"topic":"topic:phon/glottal-stop","topics":["topic:phon/glottal-stop","topic:phon/glottal-stop--glottal"],"statement":{"en":"In this phonemic analysis of Sakhalin Ainu, vowel-initial syllables are not recognized, and a weak glottal consonant phoneme /'/ is posited before vowels.","ja":"樺太アイヌ語の音素分析において母音で始まる音節は認められず、母音の前には微弱な喉子音音素 /'/ が立つと考えられる。"},"type":"analysis","scope":{"doculects":["doculect:sakhalin"],"quantifier":"all","modality":"necessary","conditions":[]},"forms":["'"],"statements":[{"id":"stmt:murasaki2025@gemini-3-flash-preview/l0007-01","stance":"proposes"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-06-38-590Z","status":"grouped"}
{"id":"claim:phon/glottal-stop--the-glottal-stop-is-at-syllable-onset-and","revision":1,"topic":"topic:phon/glottal-stop","topics":["topic:phon/glottal-stop","topic:phon/glottal-stop--glottal"],"statement":{"en":"The glottal stop /'/ is [ʔ] at syllable onset and weak laryngeal tension intervocalically, but /V'V/ and /VV/ are distinctly contrasted.","ja":"/'/ は音節頭では声門閉鎖音 [ʔ]、母音間では弱い喉頭の緊張となるが、/V'V/ と /VV/ ははっきりと区別される。"},"type":"form-function","scope":{"doculects":["doculect:sakhalin"],"quantifier":"all","modality":"necessary","conditions":[]},"forms":["/'/"],"statements":[{"id":"stmt:murasaki2025@gemini-3-flash-preview/l0011-02","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-06-38-590Z","status":"grouped"}
{"id":"claim:phon/glottal-stop--a-morpheme-initial-glottal-stop-is-deleted-after","revision":1,"topic":"topic:phon/glottal-stop","topics":["topic:phon/glottal-stop","topic:phon/glottal-stop--glottal"],"statement":{"en":"A morpheme-initial glottal stop /'/ is deleted after -n, yielding -nV- or -niV-.","ja":"-n の後の形態素頭の声門閉鎖音 /'/ は消去され、-nV- または -niV- となる。"},"type":"alternation","scope":{"doculects":["doculect:sakhalin"],"quantifier":"generic","modality":"actual","conditions":[]},"forms":["-nV-","-niV-"],"statements":[{"id":"stmt:murasaki2025@gemini-3-flash-preview/l0096-03","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-06-38-590Z","status":"grouped"}
{"id":"claim:phon/glottal-stop--after-i-syllable-final-h-is-phonetically-neutralized","revision":1,"topic":"topic:phon/glottal-stop","topics":["topic:phon/glottal-stop","topic:phon/glottal-stop--h-coda"],"statement":{"en":"After /i/, syllable-final /-h/ is phonetically neutralized with /-s/, fluctuating between [ɕ] and [ʃ] (usually closer to [ʃ]).","ja":"音節末の /-h/ は /i/ の後に来た場合、/-s/ と中和されて発音され、[ɕ] と [ʃ] の間を動揺するが [ʃ] に近く発音されることが多い。"},"type":"alternation","scope":{"doculects":["doculect:sakhalin"],"quantifier":"generic","modality":"actual","conditions":["after /i/"]},"forms":["-h","-s"],"statements":[{"id":"stmt:murasaki2025@gemini-3-flash-preview/l0011-01","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-06-38-590Z","status":"grouped"}
{"id":"claim:phon/glottal-stop--morpheme-initial-h-is-deleted-after-n-and","revision":1,"topic":"topic:phon/glottal-stop","topics":["topic:phon/glottal-stop","topic:phon/glottal-stop--h-coda"],"statement":{"en":"Morpheme-initial h- is deleted after -n, and word-initial h- can alternate with glottal stop plus vowel ('V-).","ja":"-n の後の形態素頭の h- は消去され、また語頭の h- は 'V- になることがある。"},"type":"alternation","scope":{"doculects":["doculect:sakhalin"],"quantifier":"generic","modality":"actual","conditions":[]},"forms":["-nV-","'V-"],"statements":[{"id":"stmt:murasaki2025@gemini-3-flash-preview/l0096-02","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-06-38-590Z","status":"grouped"}
{"id":"claim:phon/glottal-stop--in-sakhalin-ainu-syllable-final-x-h-after","revision":1,"topic":"topic:phon/glottal-stop","topics":["topic:phon/glottal-stop","topic:phon/glottal-stop--h-coda"],"statement":{"en":"In Sakhalin Ainu, syllable-final -x (-h) after i may be pronounced from a sound close to [çi] to a sound transcribed by small ㇱ.","ja":"樺太方言の音節末 -x (-h) は、直前に i が来た場合に、ヒに近い音から小文字のㇱで書き表されるような音で発音される場合がある。"},"type":"variation","scope":{"doculects":["doculect:sakhalin"],"quantifier":"exists","modality":"possible","conditions":["preceded by i"]},"forms":["kema-rix"],"statements":[{"id":"stmt:nakagawa2024@gemini-3-flash-preview/l0062-01","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-06-38-590Z","status":"grouped"}
{"id":"claim:phon/glottal-stop--the-weak-fricative-h-often-becomes-before-u","revision":1,"topic":"topic:phon/glottal-stop","topics":["topic:phon/glottal-stop","topic:phon/glottal-stop--h-coda"],"statement":{"en":"The weak fricative /h/ often becomes [ɸ] before /-u/, and is not found as a final consonant.","ja":"弱い摩擦音 /h/ は /-u/ の前でしばしば [ɸ] となり、音節末子音としては現れない。"},"type":"alternation","scope":{"doculects":["doculect:hokkaido"],"quantifier":"generic","modality":"actual","conditions":[]},"forms":["h","u"],"statements":[{"id":"stmt:refsing1986@gemini-3-flash-preview/l0063-10","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-06-38-590Z","status":"grouped"}
{"id":"claim:phon/glottal-stop--in-bihoro-initial-syllables-that-had-high-pitch","revision":1,"topic":"topic:phon/glottal-stop","topics":["topic:phon/glottal-stop","topic:phon/glottal-stop--h-onset"],"statement":{"en":"In Bihoro, initial syllables that had high pitch accent in Proto-Hokkaido Ainu developed a prothetic /h-/, while those with low pitch did not.","ja":"美幌方言では、祖北海道アイヌ語で高ピッチアクセントを持っていた語頭音節に前置的/h-/が発生したが、低ピッチ音節には発生しなかった。"},"type":"diachrony","scope":{"doculects":["doculect:hokkaido/northeast/kitami"],"quantifier":"generic","modality":"actual","conditions":["initial stressed syllables (< PHA high pitch accent)"]},"forms":["h-"],"statements":[{"id":"stmt:alonso2022@handbook-epub/l0033-05","stance":"reports"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-06-38-590Z","status":"grouped"}
{"id":"claim:phon/glottal-stop--early-sources-of-kuril-ainu-attest-both-prothetic","revision":1,"topic":"topic:phon/glottal-stop","topics":["topic:phon/glottal-stop","topic:phon/glottal-stop--h-onset"],"statement":{"en":"Early sources of Kuril Ainu attest both prothetic h- and the loss of original h-.","ja":"千島アイヌ語の初期資料は前置的h-の存在と本来のh-の消失の双方を証拠づけている。"},"type":"diachrony","scope":{"doculects":["doculect:kuril"],"quantifier":"generic","modality":"actual","conditions":[]},"forms":["h-"],"statements":[{"id":"stmt:alonso2022@handbook-epub/l0033-06","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-06-38-590Z","status":"grouped"}
{"id":"claim:phon/glottal-stop--the-phoneme-h-is-hardly-distinguishable-in-intervocalic","revision":1,"topic":"topic:phon/glottal-stop","topics":["topic:phon/glottal-stop","topic:phon/glottal-stop--h-onset"],"statement":{"en":"The phoneme /h/ is hardly distinguishable in intervocalic position, where it is frequently weakened and voiced to [ɦ].","ja":"音素/h/は母音間ではほとんど聞き分けられず、しばしば弱化して有声化し[ɦ]になる。"},"type":"alternation","scope":{"doculects":["doculect:hokkaido/southwest"],"quantifier":"usually","modality":"actual","conditions":["intervocalic position"]},"forms":["/h/","[ɦ]"],"statements":[{"id":"stmt:bugaeva2012@gemini-3-flash-preview/l0005-06","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-06-38-590Z","status":"grouped"}
{"id":"claim:phon/glottal-stop--before-u-h-is-often-realized-as-a","revision":1,"topic":"topic:phon/glottal-stop","topics":["topic:phon/glottal-stop","topic:phon/glottal-stop--h-onset"],"statement":{"en":"Before /u/, /h/ is often realized as a voiceless bilabial fricative [ɸ].","ja":"/u/の前において、/h/はしばしば無声両唇摩擦音[ɸ]として実現する。"},"type":"alternation","scope":{"doculects":["doculect:hokkaido/southwest"],"quantifier":"usually","modality":"actual","conditions":["before /u/"]},"forms":["/h/","/u/","[ɸ]"],"statements":[{"id":"stmt:bugaeva2012@gemini-3-flash-preview/l0005-07","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-06-38-590Z","status":"grouped"}
{"id":"claim:phon/glottal-stop--cases-of-h-insertion-are-restricted-to-specific","revision":1,"topic":"topic:phon/glottal-stop","topics":["topic:phon/glottal-stop","topic:phon/glottal-stop--h-onset"],"statement":{"en":"Cases of h-insertion are restricted to specific morphological contexts such as possessive formation.","ja":"h挿入の事例は、所有形形成などの特定の形態論的文脈に限定される。"},"type":"distribution","scope":{"doculects":["doculect:ainu"],"quantifier":"all","modality":"actual","conditions":["restricted to specific morphological contexts like possessive formation"]},"forms":["-ha","-hi"],"statements":[{"id":"stmt:bugaeva2022@handbook-epub/l0134-16","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-06-38-590Z","status":"grouped"}
{"id":"claim:phon/glottal-stop--the-fricative-h-palatalizes-to-before-i-and","revision":1,"topic":"topic:phon/glottal-stop","topics":["topic:phon/glottal-stop","topic:phon/glottal-stop--h-onset"],"statement":{"en":"The fricative h palatalizes to [ç] before i and labializes toward [F] before u, but represents the same phoneme.","ja":"摩擦音 h は i と結合するとき口蓋化して [ç] に、u と結合するとき唇音化して [F] に近づくが、同一の音素である。"},"type":"alternation","scope":{"doculects":["doculect:ainu"],"quantifier":"all","modality":"actual","conditions":[]},"forms":["h"],"statements":[{"id":"stmt:kindaichi1936@gemini-3-flash-preview/l0016-03","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-06-38-590Z","status":"grouped"}
{"id":"claim:phon/glottal-stop--h-is-h-at-syllable-onset-sometimes-voiced","revision":1,"topic":"topic:phon/glottal-stop","topics":["topic:phon/glottal-stop","topic:phon/glottal-stop--h-onset"],"statement":{"en":"/h/ is [h] at syllable onset (sometimes voiced [ɦ] intervocalically); in syllable coda it is [ɦ] ~ [ç] after /i/, [ɸ] after /u/, and after other vowels a voiceless breath with the shape of the preceding vowel.","ja":"/h/ は音節頭では [h]（母音間では有声の [ɦ] になることがある）、音節末では /i/ の後で [ɦ] 〜 [ç]、/u/ の後で [ɸ]、それ以外の母音後では前の母音と同じ口の形の弱い息となる。"},"type":"alternation","scope":{"doculects":["doculect:sakhalin"],"quantifier":"all","modality":"actual","conditions":[]},"forms":["/h/"],"statements":[{"id":"stmt:murasaki2025@gemini-3-flash-preview/l0010-08","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-06-38-590Z","status":"grouped"}
{"id":"claim:phon/glottal-stop--particles-and-formal-nouns-beginning-with-h-or","revision":1,"topic":"topic:phon/glottal-stop","topics":["topic:phon/glottal-stop","topic:phon/glottal-stop--h-onset"],"statement":{"en":"Particles and formal nouns beginning with h- or y- often drop the initial consonant and are pronounced continuously with the preceding word.","ja":"特に h- や y- で始まる助詞や形式名詞は、その音が脱落して前の語と連続して発音されることが多い。"},"type":"alternation","scope":{"doculects":["doculect:ainu"],"quantifier":"usually","modality":"possible","conditions":["particles or formal nouns beginning with h- or y-"]},"forms":["h-","y-"],"statements":[{"id":"stmt:nakagawa2024@gemini-3-flash-preview/l0037-01","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-06-38-590Z","status":"grouped"}
{"id":"claim:phon/glottal-stop--in-dialects-such-as-tokachi-eastern-hokkaido-and","revision":1,"topic":"topic:phon/glottal-stop","topics":["topic:phon/glottal-stop","topic:phon/glottal-stop--h-onset"],"statement":{"en":"In dialects such as Tokachi, Eastern Hokkaido, and Ishikari, initial h has a strong tendency not to occur, especially at the beginning of unaccented words.","ja":"十勝方言、道東方言、石狩方言などでは、特にアクセントの無い語頭に h が立たない傾向が強い。"},"type":"variation","scope":{"doculects":["doculect:hokkaido/central/tokachi","doculect:hokkaido/central/ishikari","doculect:hokkaido/northeast"],"quantifier":"generic","modality":"actual","conditions":["unaccented word-initial position"]},"forms":["h"],"statements":[{"id":"stmt:nakagawa2024@gemini-3-flash-preview/l0037-02","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-06-38-590Z","status":"grouped"}
{"id":"claim:phon/glottal-stop--in-dialects-such-as-tokachi-kushiro-and-ishikari","revision":1,"topic":"topic:phon/glottal-stop","topics":["topic:phon/glottal-stop","topic:phon/glottal-stop--h-onset"],"statement":{"en":"In dialects such as Tokachi, Kushiro, and Ishikari, unaccented word-initial h- regularly drops.","ja":"十勝・釧路・石狩などの諸方言では、アクセントのない語頭の h- が規則的に脱落する。"},"type":"alternation","scope":{"doculects":["doculect:hokkaido/central/tokachi","doculect:hokkaido/northeast/kushiro","doculect:hokkaido/central/ishikari"],"quantifier":"all","modality":"actual","conditions":["unaccented word-initial h-"]},"forms":["h-"],"statements":[{"id":"stmt:nakagawa2024@gemini-3-flash-preview/l0107-01","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-06-38-590Z","status":"grouped"}
{"id":"claim:phon/glottal-stop--in-the-urakawa-and-samani-dialects-there-is","revision":1,"topic":"topic:phon/glottal-stop","topics":["topic:phon/glottal-stop","topic:phon/glottal-stop--h-onset"],"statement":{"en":"In the Urakawa and Samani dialects, there is a tendency to add an initial h- to words that begin with a vowel in other dialects.","ja":"浦河・様似方言では、他方言で母音始まりである語頭に h- を加える傾向がある。"},"type":"variation","scope":{"doculects":["doculect:hokkaido/southwest/samani"],"quantifier":"usually","modality":"actual","conditions":["word-initial position before vowels"]},"forms":["h-"],"statements":[{"id":"stmt:nakagawa2024@gemini-3-flash-preview/l0108-01","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-06-38-590Z","status":"grouped"}
{"id":"claim:phon/glottal-stop--in-normal-speed-speech-word-initial-h-of","revision":1,"topic":"topic:phon/glottal-stop","topics":["topic:phon/glottal-stop","topic:phon/glottal-stop--h-onset"],"statement":{"en":"In normal-speed speech, word-initial h- of hine is not pronounced, and i- often forms a single syllable with the coda consonant of the preceding word.","ja":"通常のスピードの発話では、hine の語頭の h は発音されず、i- が前の語の末尾子音とひとつの音節をなして発音されることが多い。"},"type":"alternation","scope":{"doculects":["doculect:hokkaido"],"quantifier":"usually","modality":"actual","conditions":["in normal-speed speech"]},"forms":["hine"],"statements":[{"id":"stmt:nakagawa2024@gemini-3-flash-preview/l0335-02","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-06-38-590Z","status":"grouped"}
{"id":"claim:phon/glottal-stop--in-dialects-such-as-ishikari-where-word-initial","revision":1,"topic":"topic:phon/glottal-stop","topics":["topic:phon/glottal-stop","topic:phon/glottal-stop--h-onset"],"statement":{"en":"In dialects such as Ishikari where word-initial h- in other dialects is often absent, hine may be written as ine.","ja":"石狩方言のように他方言での語頭の h が無いことが多い方言では、hine は ine のように記されることもある。"},"type":"variation","scope":{"doculects":["doculect:hokkaido/central/ishikari"],"quantifier":"unstated","modality":"actual","conditions":[]},"forms":["ine","hine"],"statements":[{"id":"stmt:nakagawa2024@gemini-3-flash-preview/l0335-03","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-06-38-590Z","status":"grouped"}
{"id":"claim:phon/glottal-stop--when-accent-falls-on-the-second-syllable-because","revision":1,"topic":"topic:phon/glottal-stop","topics":["topic:phon/glottal-stop","topic:phon/glottal-stop--h-onset"],"statement":{"en":"When accent falls on the second syllable because the first syllable is open, word-initial /h/ is often elided in geographically eastern dialects.","ja":"第1音節が開音節であるために第2音節にアクセントが落ちる場合、地理的により東方の方言において語頭の /h/ が脱落することが多い。"},"type":"alternation","scope":{"doculects":["doculect:hokkaido/central","doculect:hokkaido/northeast"],"quantifier":"usually","modality":"actual","conditions":["accent falls on the second syllable"]},"forms":["huráye","uráye","hokú","okú"],"statements":[{"id":"stmt:nakagawafukazawa2022@handbook-epub/l0050-06","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-06-38-590Z","status":"grouped"}
{"id":"claim:phon/glottal-stop--insertion-of-word-initial-h-is-prominent-in","revision":1,"topic":"topic:phon/glottal-stop","topics":["topic:phon/glottal-stop","topic:phon/glottal-stop--h-onset"],"statement":{"en":"Insertion of word-initial /h/ is prominent in unaccented-type dialects located in the northeastern part of Hokkaido.","ja":"語頭の /h/ の添加は、北海道北東部に位置する無アクセント型方言において顕著である。"},"type":"alternation","scope":{"doculects":["doculect:hokkaido/northeast"],"quantifier":"generic","modality":"actual","conditions":[]},"forms":["úrar","hurar","ám","ham"],"statements":[{"id":"stmt:nakagawafukazawa2022@handbook-epub/l0050-09","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-06-38-590Z","status":"grouped"}
{"id":"claim:phon/glottal-stop--initial-h-tends-to-disappear-in-unstressed-suffixes","revision":1,"topic":"topic:phon/glottal-stop","topics":["topic:phon/glottal-stop","topic:phon/glottal-stop--h-onset"],"statement":{"en":"Initial /h-/ tends to disappear in unstressed suffixes, occurring without exception in rapid speech and almost always in normal speech unless there is a pause or hesitation.","ja":"無強勢の接尾辞における語頭の/h-/は脱落する傾向があり、早口の発話では例外なく、通常の発話でも休止やためらいがない限りほぼ常に脱落する。"},"type":"alternation","scope":{"doculects":["doculect:hokkaido/southwest/shizunai"],"quantifier":"usually","modality":"actual","conditions":["in unstressed suffixes"]},"forms":["h-"],"statements":[{"id":"stmt:refsing1986@gemini-3-flash-preview/l0066-03","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-06-38-590Z","status":"grouped"}
{"id":"claim:phon/glottal-stop--in-the-pronunciation-of-hine-word-initial-h","revision":1,"topic":"topic:phon/glottal-stop","topics":["topic:phon/glottal-stop","topic:phon/glottal-stop--h-onset"],"statement":{"en":"In the pronunciation of hine, word-initial [h] is frequently dropped, and in rapid speech [i] may also be dropped so that only [ne] remains.","ja":"hine の発音において語頭の [h] は頻繁に脱落し、早口では [i] も脱落して [ne] のみが残ることがある。"},"type":"alternation","scope":{"doculects":["doculect:hokkaido/southwest/shizunai"],"quantifier":"unstated","modality":"possible","conditions":["in rapid speech"]},"forms":["hine","ne"],"statements":[{"id":"stmt:refsing1986@gemini-3-flash-preview/l0236-09","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-06-38-590Z","status":"grouped"}
{"id":"claim:phon/glottal-stop--hike-tends-to-drop-the-initial-h-in","revision":1,"topic":"topic:phon/glottal-stop","topics":["topic:phon/glottal-stop","topic:phon/glottal-stop--h-onset"],"statement":{"en":"hike tends to drop the initial [h] in rapid speech.","ja":"hike は早口において語頭の [h] を脱落させる傾向がある。"},"type":"alternation","scope":{"doculects":["doculect:hokkaido/southwest/shizunai"],"quantifier":"unstated","modality":"actual","conditions":["in rapid speech"]},"forms":["hike"],"statements":[{"id":"stmt:refsing1986@gemini-3-flash-preview/l0236-10","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-06-38-590Z","status":"grouped"}
{"id":"claim:phon/glottal-stop--across-word-boundaries-an-initial-hv-sequence-can","revision":1,"topic":"topic:phon/glottal-stop","topics":["topic:phon/glottal-stop","topic:phon/glottal-stop--h-onset"],"statement":{"en":"Across word boundaries, an initial hV- sequence can drop h- after a consonant-final word.","ja":"-C + hV- → -CV- : kamuy ek um < kamuy「クマ」, ek「来る」, hum「音」"},"type":"alternation","scope":{"doculects":["doculect:ainu"],"quantifier":"generic","modality":"possible","conditions":["after a consonant-final form"]},"forms":["-C","hV-","-CV-"],"statements":[{"id":"stmt:sato2008@gemini-3-flash-preview/l0030-10","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-06-38-590Z","status":"grouped"}
{"id":"claim:phon/glottal-stop--the-sound-change-or-alternation-s-h-occurs","revision":1,"topic":"topic:phon/glottal-stop","topics":["topic:phon/glottal-stop","topic:phon/glottal-stop--h-phoneme"],"statement":{"en":"The sound change or alternation s -> h occurs in certain words.","ja":"語によって s から h への交替（s→h）が見られる。"},"type":"alternation","scope":{"doculects":[],"quantifier":"unstated","modality":"actual","conditions":[]},"forms":["s","h"],"statements":[{"id":"stmt:kindaichi1936@gemini-3-flash-preview/l0028-05","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-06-38-590Z","status":"grouped"}
{"id":"claim:phon/glottal-stop--when-morphophonemic-h-is-followed-by-a-vowel","revision":1,"topic":"topic:phon/glottal-stop","topics":["topic:phon/glottal-stop","topic:phon/glottal-stop--h-phoneme"],"statement":{"en":"When morphophonemic /h/ is followed by a vowel or y-, an underlying plosive or liquid (-t-, -p-, -k-, or -r-) surfaces.","ja":"形態音素 /h/ の後に母音や y- が続くと、本来の子音（-t-, -p-, -k-, -r-）が現れる。"},"type":"alternation","scope":{"doculects":["doculect:sakhalin"],"quantifier":"generic","modality":"actual","conditions":[]},"forms":["-t-","-p-","-k-","-r-"],"statements":[{"id":"stmt:murasaki2025@gemini-3-flash-preview/l0096-08","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-06-38-590Z","status":"grouped"}
{"id":"claim:phon/glottal-stop--the-glottal-stop-tends-to-weaken-in-intervocalic","revision":1,"topic":"topic:phon/glottal-stop","topics":["topic:phon/glottal-stop","topic:phon/glottal-stop--juncture"],"statement":{"en":"The glottal stop /ʔ/ tends to weaken in intervocalic positions, but does not weaken in accented syllables.","ja":"声門閉鎖音/ʔ/は母音間において弱化する傾向があるが、アクセントのある音節では弱化しない。"},"type":"alternation","scope":{"doculects":["doculect:hokkaido/southwest"],"quantifier":"generic","modality":"actual","conditions":["intervocalic position","unaccented syllables"]},"forms":["/ʔ/"],"statements":[{"id":"stmt:bugaeva2012@gemini-3-flash-preview/l0005-08","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-06-38-590Z","status":"grouped"}
{"id":"claim:phon/glottal-stop--in-saru-ainu-the-glottal-stop-is-often","revision":1,"topic":"topic:phon/glottal-stop","topics":["topic:phon/glottal-stop","topic:phon/glottal-stop--juncture"],"statement":{"en":"In Saru Ainu, the glottal stop is often omitted in the syllable immediately following an accented syllable.","ja":"沙流アイヌ語では、声門閉鎖音はアクセントのある音節の直後の音節においてしばしば脱落する。"},"type":"alternation","scope":{"doculects":["doculect:hokkaido/southwest/saru"],"quantifier":"usually","modality":"actual","conditions":["immediately following an accented syllable"]},"forms":["/ʔ/"],"statements":[{"id":"stmt:bugaeva2012@gemini-3-flash-preview/l0005-09","stance":"reports"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-06-38-590Z","status":"grouped"}
{"id":"claim:phon/glottal-stop--when-the-suffixes-as-and-an-attach-to","revision":1,"topic":"topic:phon/glottal-stop","topics":["topic:phon/glottal-stop","topic:phon/glottal-stop--juncture"],"statement":{"en":"When the suffixes -as and -an attach to verbs ending in a consonant other than n, a glottal stop may be inserted before them, whereas after verbs ending in n they are generally pronounced continuously.","ja":"-as「私達（除外的）が」、-an「私達（包括的）が」は、n 以外の子音で終わる動詞に付く場合は声門閉鎖音を入れて発音されることがあり、n で終わる動詞に付く場合は続けて発音されるのが一般的である。"},"type":"alternation","scope":{"doculects":["doculect:ainu"],"quantifier":"all","modality":"possible","conditions":[]},"forms":["-as","-an"],"statements":[{"id":"stmt:sato2008@gemini-3-flash-preview/l0128-06","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-06-38-590Z","status":"grouped"}
{"id":"claim:phon/glottal-stop--a-glottal-stop-or-tension-is-clearly-audible","revision":1,"topic":"topic:phon/glottal-stop","topics":["topic:phon/glottal-stop","topic:phon/glottal-stop--juncture"],"statement":{"en":"A glottal stop (or tension) is clearly audible when V2 bears accent and/or when V2 is followed by a consonant in a closed syllable.","ja":"V2にアクセントがある場合、および／またはV2が閉音節にあり後続子音を伴う場合、声門閉鎖音（または緊張）が明瞭に聞き取れる。"},"type":"distribution","scope":{"doculects":["doculect:ainu"],"quantifier":"generic","modality":"actual","conditions":["V2 bears accent","V2 in closed syllable"]},"forms":[],"statements":[{"id":"stmt:shiraishi2022@handbook-epub/l0085-12","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-06-38-590Z","status":"grouped"}
{"id":"claim:phon/glottal-stop--when-v2-does-not-bear-accent-and-is","revision":1,"topic":"topic:phon/glottal-stop","topics":["topic:phon/glottal-stop","topic:phon/glottal-stop--juncture"],"statement":{"en":"When V2 does not bear accent and is not in a closed syllable, a clear glottal stop is not audible and the transition between the two vowels is gradual.","ja":"V2にアクセントがなく閉音節でもない場合、明瞭な声門閉鎖音は聞こえず、2つの母音間の移行は緩慢である。"},"type":"distribution","scope":{"doculects":["doculect:ainu"],"quantifier":"generic","modality":"actual","conditions":["V2 does not bear accent","V2 is in open syllable"]},"forms":[],"statements":[{"id":"stmt:shiraishi2022@handbook-epub/l0085-13","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-06-38-590Z","status":"grouped"}
{"id":"claim:phon/glottal-stop--the-phonological-status-of-the-glottal-stop-is","revision":1,"topic":"topic:phon/glottal-stop","topics":["topic:phon/glottal-stop","topic:phon/glottal-stop--phonemicity"],"statement":{"en":"The phonological status of the glottal stop is unclear in the Chitose dialect.","ja":"千歳方言において声門閉鎖音の音韻的地位は明確ではない。"},"type":"analysis","scope":{"doculects":["doculect:hokkaido/chitose"],"quantifier":"unstated","modality":"actual","conditions":[]},"forms":["'"],"statements":[{"id":"stmt:bugaeva2022@handbook-epub/l0130-03","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-06-38-590Z","status":"grouped"}
{"id":"claim:phon/glottal-stop--kirsten-refsing-1986-does-not-recognize-the-existence","revision":1,"topic":"topic:phon/glottal-stop","topics":["topic:phon/glottal-stop","topic:phon/glottal-stop--phonemicity"],"statement":{"en":"Kirsten Refsing (1986) does not recognize the existence of the glottal stop in Ainu at all.","ja":"キーステン・レフシン（Refsing 1986）は、アイヌ語における声門破裂音の存在そのものを認めていない。"},"type":"analysis","scope":{"doculects":["doculect:hokkaido/chitose"],"quantifier":"none","modality":"actual","conditions":[]},"forms":["ʼ"],"statements":[{"id":"stmt:nakagawa2024@gemini-3-flash-preview/l0029-05","stance":"reports"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-06-38-590Z","status":"grouped"}
{"id":"claim:phon/glottal-stop--recognizing-the-glottal-stop-as-a-phonemic-consonant","revision":1,"topic":"topic:phon/glottal-stop","topics":["topic:phon/glottal-stop","topic:phon/glottal-stop--phonemicity"],"statement":{"en":"Recognizing the glottal stop as a phonemic consonant eliminates vowel-initial syllables, simplifying the syllable template of Hokkaido Ainu to just CV and CVC.","ja":"声門破裂音を子音として認めると母音始まりの音節がなくなり、北海道アイヌ語の音節構造はCVとCVCの2つだけに簡略化できる。"},"type":"analysis","scope":{"doculects":["doculect:hokkaido"],"quantifier":"all","modality":"actual","conditions":["if glottal stop is analyzed as a phoneme"]},"forms":["ʼ"],"statements":[{"id":"stmt:nakagawa2024@gemini-3-flash-preview/l0029-06","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-06-38-590Z","status":"grouped"}
{"id":"claim:phon/glottal-stop--setting-up-a-glottal-stop-phoneme-before-all","revision":1,"topic":"topic:phon/glottal-stop","topics":["topic:phon/glottal-stop","topic:phon/glottal-stop--phonemicity"],"statement":{"en":"Setting up a glottal-stop phoneme /'/ before all vowel-initial syllables would reduce syllable shapes to CV and CVC, but it is un-economical because it requires rules deleting /'/ at various stages of word formation to account for pitch accent in words like parunpe.","ja":"母音始まりの音節の前に声門破裂音音素 /'/ を設定すると音節構造は CV と CVC のみになるが、parunpe のような語のアクセントを説明するために各段階で /'/ を削除する規則が必要となり、記述上経済的ではない。"},"type":"analysis","scope":{"doculects":["doculect:hokkaido"],"quantifier":"unstated","modality":"actual","conditions":[]},"forms":["/'/","parunpe"],"statements":[{"id":"stmt:nakagawa2024@gemini-3-flash-preview/l0042-01","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-06-38-590Z","status":"grouped"}
{"id":"claim:phon/glottal-stop--hattori-1964-posits-a-glottal-plosive-before-all","revision":1,"topic":"topic:phon/glottal-stop","topics":["topic:phon/glottal-stop","topic:phon/glottal-stop--phonemicity"],"statement":{"en":"Hattori (1964) posits a glottal plosive /ʔ/ before all word-initial vowels and intervocalically, where it reduces to laryngeal tension, treating it as a separate consonant phoneme /'/.","ja":"服部（1964）はすべての語頭母音の前および母音間に声門破裂音 /ʔ/（後者では喉頭の緊張に弱まる）を立て、これを独立した子音音素 /'/ として扱っている。"},"type":"analysis","scope":{"doculects":["doculect:hokkaido"],"quantifier":"all","modality":"actual","conditions":[]},"forms":["ʔ","'"],"statements":[{"id":"stmt:refsing1986@gemini-3-flash-preview/l0062-04","stance":"reports"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-06-38-590Z","status":"grouped"}
{"id":"claim:phon/glottal-stop--asai-1969-recognizes-glottal-closure-seimon-heisa-but","revision":1,"topic":"topic:phon/glottal-stop","topics":["topic:phon/glottal-stop","topic:phon/glottal-stop--phonemicity"],"statement":{"en":"Asai (1969) recognizes glottal closure (seimon heisa) but does not treat it as a separate phoneme.","ja":"浅井（1969）も声門閉鎖という特徴を認めているが、独立した音素としては扱っていない。"},"type":"analysis","scope":{"doculects":["doculect:hokkaido"],"quantifier":"all","modality":"actual","conditions":[]},"forms":[],"statements":[{"id":"stmt:refsing1986@gemini-3-flash-preview/l0062-05","stance":"reports"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-06-38-590Z","status":"grouped"}
{"id":"claim:phon/glottal-stop--glottal-stop-can-be-analyzed-as-a-phoneme","revision":1,"topic":"topic:phon/glottal-stop","topics":["topic:phon/glottal-stop","topic:phon/glottal-stop--phonemicity"],"statement":{"en":"Glottal stop can be analyzed as a phoneme before word-initial vowels and between vowels, surfacing as throat tension or as an intervocalic vocal break.","ja":"母音で始まる語や，母音と母音の間に声門閉鎖音（アイヌ語学では ’ という記号で表す。音声記号では [ʔ] という記号で表す）を音素として立てることもある"},"type":"analysis","scope":{"doculects":["doculect:ainu"],"quantifier":"generic","modality":"possible","conditions":[]},"forms":["'"],"statements":[{"id":"stmt:sato2008@gemini-3-flash-preview/l0027-06","stance":"proposes"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-06-38-590Z","status":"grouped"}
{"id":"claim:phon/glottal-stop--in-ainu-the-glottal-stop-has-no-contrastive","revision":1,"topic":"topic:phon/glottal-stop","topics":["topic:phon/glottal-stop","topic:phon/glottal-stop--phonemicity"],"statement":{"en":"In Ainu, the glottal stop has no contrastive function in monomorphemic forms.","ja":"アイヌ語において、声門閉鎖音は単一形態素形式において対立的機能を一切持たない。"},"type":"absence","scope":{"doculects":["doculect:ainu"],"quantifier":"none","modality":"actual","conditions":["in monomorphemic forms"]},"forms":[],"statements":[{"id":"stmt:shiraishi2022@handbook-epub/l0085-14","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-06-38-590Z","status":"grouped"}
{"id":"claim:phon/glottal-stop--in-the-1950s-shiro-hattori-and-suzuko-tamura","revision":1,"topic":"topic:phon/glottal-stop","topics":["topic:phon/glottal-stop","topic:phon/glottal-stop--shizunai"],"statement":{"en":"In the 1950s, Shiro Hattori and Suzuko Tamura recognized the glottal stop as a phonemic consonant occurring before all vowels in Ainu.","ja":"1950年代に服部四郎や田村すゞ子らは、アイヌ語のすべての母音の前に声門破裂音があるとし、これを子音の音素として認定した。"},"type":"analysis","scope":{"doculects":["doculect:ainu"],"quantifier":"all","modality":"actual","conditions":["before all vowels"]},"forms":["ʼ"],"statements":[{"id":"stmt:nakagawa2024@gemini-3-flash-preview/l0029-04","stance":"reports"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-06-38-590Z","status":"grouped"}

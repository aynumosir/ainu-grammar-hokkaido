{"id":"claim:nominal/word-class-inventory-and-diagnostics--particles-bound-grammatical-relators","revision":1,"topic":"topic:nominal/word-class-inventory-and-diagnostics","topics":["topic:nominal/word-class-inventory-and-diagnostics","topic:nominal/word-class-inventory-and-diagnostics--particle-diagnostics"],"statement":{"en":"Particles in Ainu attach to free elements to express grammatical relationships.","ja":"アイヌ語の助詞は自立要素に後続して文法的関係を表す。"},"type":"form-function","scope":{"doculects":["doculect:ainu"],"quantifier":"all","modality":"assertive","conditions":[]},"forms":[],"statements":[{"id":"stmt:nakagawa2024@gemini-3-flash-preview/l0114-06","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-13-12-354Z","status":"grouped"}
{"id":"claim:nominal/word-class-inventory-and-diagnostics--tamura-adverbial-particle-combination-model","revision":1,"topic":"topic:nominal/word-class-inventory-and-diagnostics","topics":["topic:nominal/word-class-inventory-and-diagnostics","topic:nominal/word-class-inventory-and-diagnostics--particle-diagnostics"],"statement":{"en":"In Tamura's model, an adverbial particle combines with verbal, nominal, or adverbial forms to yield forms of the same category.","ja":"田村の体系では、副助詞は動詞形・名詞形・副詞形と結合してそれぞれ同種の形式を形成する。"},"type":"analysis","scope":{"doculects":["doculect:hokkaido/southwest/saru"],"quantifier":"all","modality":"assertive","conditions":[]},"forms":[],"statements":[{"id":"stmt:refsing1986@gemini-3-flash-preview/l0042-03","stance":"reports"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-13-12-354Z","status":"grouped"}
{"id":"claim:nominal/word-class-inventory-and-diagnostics--definition-of-restrictive-postposition","revision":1,"topic":"topic:nominal/word-class-inventory-and-diagnostics","topics":["topic:nominal/word-class-inventory-and-diagnostics","topic:nominal/word-class-inventory-and-diagnostics--particle-diagnostics"],"statement":{"en":"The term restrictive postposition covers focus particles, restrictives, quasi-restrictives, comparators, and distributives.","ja":"限定後置詞という用語は、取り立て助詞、限定助詞、準限定助詞、比況助詞、分配助詞を包括する。"},"type":"terminology","scope":{"doculects":["doculect:hokkaido/southwest/shizunai"],"quantifier":"all","modality":"assertive","conditions":[]},"forms":[],"statements":[{"id":"stmt:refsing1986@gemini-3-flash-preview/l0042-05","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-13-12-354Z","status":"grouped"}
{"id":"claim:nominal/word-class-inventory-and-diagnostics--definition-of-clitics-bound-non-predicative","revision":1,"topic":"topic:nominal/word-class-inventory-and-diagnostics","topics":["topic:nominal/word-class-inventory-and-diagnostics","topic:nominal/word-class-inventory-and-diagnostics--particle-diagnostics"],"statement":{"en":"Clitics are bound forms unable to appear independently either as predicates or as isolated adjuncts to a predicate.","ja":"接語類（クリティック）は、述語としても述語の単独の付加語としても自立して現れることができない結合形式である。"},"type":"membership","scope":{"doculects":["doculect:hokkaido/southwest/shizunai"],"quantifier":"all","modality":"assertive","conditions":[]},"forms":[],"statements":[{"id":"stmt:refsing1986@gemini-3-flash-preview/l0070-10","stance":"asserts"},{"id":"stmt:refsing1986@gemini-3-flash-preview/l0146-06","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-13-12-354Z","status":"grouped"}
{"id":"claim:nominal/word-class-inventory-and-diagnostics--predicate-position-headed-by-verb-or-auxiliary","revision":1,"topic":"topic:nominal/word-class-inventory-and-diagnostics","topics":["topic:nominal/word-class-inventory-and-diagnostics","topic:nominal/word-class-inventory-and-diagnostics--verb-diagnostics"],"statement":{"en":"The predicate position is invariably occupied by a verb phrase whose head is a verb or an auxiliary verb.","ja":"アイヌ語の述語位置は常に動詞句によって占められ、その主要部は動詞または助動詞である。"},"type":"distribution","scope":{"doculects":["doculect:ainu"],"quantifier":"all","modality":"assertive","conditions":[]},"forms":[],"statements":[{"id":"stmt:nakagawa2022pos@handbook-epub/l0091-01","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-13-12-354Z","status":"grouped"}
{"id":"claim:nominal/word-class-inventory-and-diagnostics--verb-distributional-and-affixal-properties","revision":1,"topic":"topic:nominal/word-class-inventory-and-diagnostics","topics":["topic:nominal/word-class-inventory-and-diagnostics","topic:nominal/word-class-inventory-and-diagnostics--verb-diagnostics"],"statement":{"en":"Verbs in Ainu can serve as predicates and take one or two personal affixes.","ja":"アイヌ語の動詞は述語になり、1つないし2つの人称接辞をとる。"},"type":"distribution","scope":{"doculects":["doculect:ainu"],"quantifier":"all","modality":"assertive","conditions":[]},"forms":[],"statements":[{"id":"stmt:nakagawa2024@gemini-3-flash-preview/l0114-01","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-13-12-354Z","status":"grouped"}
{"id":"claim:nominal/word-class-inventory-and-diagnostics--iomante-inherently-intransitive-verb","revision":1,"topic":"topic:nominal/word-class-inventory-and-diagnostics","topics":["topic:nominal/word-class-inventory-and-diagnostics","topic:nominal/word-class-inventory-and-diagnostics--verb-diagnostics"],"statement":{"en":"The word iomante is inherently an intransitive verb meaning 'to send the spirit of a kamuy'.","ja":"iomante は本来「（カムイの）霊を送る」という意味の自動詞である。"},"type":"membership","scope":{"doculects":["doculect:ainu"],"quantifier":"specific","modality":"assertive","conditions":[]},"forms":["iomante"],"statements":[{"id":"stmt:nakagawa2024@gemini-3-flash-preview/l0117-05","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-13-12-354Z","status":"grouped"}
{"id":"claim:nominal/word-class-inventory-and-diagnostics--definition-of-verb-basic-form","revision":1,"topic":"topic:nominal/word-class-inventory-and-diagnostics","topics":["topic:nominal/word-class-inventory-and-diagnostics","topic:nominal/word-class-inventory-and-diagnostics--verb-diagnostics"],"statement":{"en":"The smallest verbal form capable of functioning as an independent word is called the basic form of the verb.","ja":"自立語として成立する最小の動詞形式を動詞の基本形と呼ぶ。"},"type":"terminology","scope":{"doculects":["doculect:hokkaido"],"quantifier":"all","modality":"assertive","conditions":[]},"forms":["komke","komo","tuye","tuy"],"statements":[{"id":"stmt:nakagawa2024@gemini-3-flash-preview/l0133-01","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-13-12-354Z","status":"grouped"}
{"id":"claim:nominal/word-class-inventory-and-diagnostics--absence-of-conclusive-conjunctive-verb-distinction","revision":1,"topic":"topic:nominal/word-class-inventory-and-diagnostics","topics":["topic:nominal/word-class-inventory-and-diagnostics","topic:nominal/word-class-inventory-and-diagnostics--verb-diagnostics"],"statement":{"en":"Unlike Japanese verbs, Ainu verbs make no formal distinction between conclusive and conjunctive forms.","ja":"日本語と異なり、アイヌ語の動詞には終止形と連用形の形式的区別が存在しない。"},"type":"absence","scope":{"doculects":["doculect:ainu"],"quantifier":"all","modality":"assertive","conditions":[]},"forms":[],"statements":[{"id":"stmt:nakagawa2024@gemini-3-flash-preview/l0511-01","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-13-12-354Z","status":"grouped"}

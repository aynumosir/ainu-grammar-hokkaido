{"id":"claim:nominal/word-class-inventory-and-diagnostics--separable-verbs-terminology","revision":1,"topic":"topic:nominal/word-class-inventory-and-diagnostics","topics":["topic:nominal/word-class-inventory-and-diagnostics","topic:nominal/word-class-inventory-and-diagnostics--verb-diagnostics"],"statement":{"en":"Forms showing semantic unity but grammatically behaving as two words are tentatively called separable verbs.","ja":"意味的には一語のまとまりを示しながら文法的には二語として現れる形式は分離動詞と呼ばれる。"},"type":"terminology","scope":{"doculects":["doculect:ainu"],"quantifier":"all","modality":"assertive","conditions":[]},"forms":[],"statements":[{"id":"stmt:sato2008@gemini-3-flash-preview/l0247-03","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-13-12-354Z","status":"grouped"}
{"id":"claim:nominal/word-class-inventory-and-diagnostics--separable-verbs-frequency-and-basic-meaning","revision":1,"topic":"topic:nominal/word-class-inventory-and-diagnostics","topics":["topic:nominal/word-class-inventory-and-diagnostics","topic:nominal/word-class-inventory-and-diagnostics--verb-diagnostics"],"statement":{"en":"Separable verbs are limited in number, but many express basic meanings and are frequently used.","ja":"分離動詞は語数が限られているが、基本的な意味を表し頻繁に用いられるものが多い。"},"type":"frequency","scope":{"doculects":["doculect:ainu"],"quantifier":"most","modality":"assertive","conditions":[]},"forms":["kes anpa","ka opas","ka opiwki","ka ose","ka oyki","par oyki"],"statements":[{"id":"stmt:sato2008@gemini-3-flash-preview/l0247-04","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-13-12-354Z","status":"grouped"}
{"id":"claim:nominal/word-class-inventory-and-diagnostics--intransitive-verbs-function-as-nouns","revision":1,"topic":"topic:nominal/word-class-inventory-and-diagnostics","topics":["topic:nominal/word-class-inventory-and-diagnostics","topic:nominal/word-class-inventory-and-diagnostics--verb-noun-continuum"],"statement":{"en":"All intransitive (one-place) verbs in Ainu can in principle function grammatically as nouns without morphological stem change.","ja":"アイヌ語のすべての自動詞（1項動詞）は、語幹の形態論的変化なしに原理的に名詞としても機能しうる。"},"type":"membership","scope":{"doculects":["doculect:ainu"],"quantifier":"all","modality":"assertive","conditions":[]},"forms":["uwepeker"],"statements":[{"id":"stmt:bugaeva2016@pdftotext-pieces/l0003-06","stance":"asserts"},{"id":"stmt:nakagawa2024@gemini-3-flash-preview/l0487-01","stance":"asserts"}],"relations":[{"kind":"refines","claim":"claim:nominal/word-class-inventory-and-diagnostics--sakhalin-verb-stems-as-verbal-nouns","differs_in":"scope","note":"Murasaki's claim of Sakhalin verb stems functioning as action verbal nouns is a regional instantiation of the general intransitive-to-noun conversion."}],"grouped_by":"act:group/2026-09-10T15-13-12-354Z","status":"grouped"}

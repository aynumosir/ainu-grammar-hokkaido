{"id":"claim:nominal/nominal-derivation-diminutive-augmentative--noun-prefixes-are-predominantly-directional-prefixes-forming-pairs","revision":1,"topic":"topic:nominal/nominal-derivation-diminutive-augmentative","topics":["topic:nominal/nominal-derivation-diminutive-augmentative"],"statement":{"en":"Noun prefixes are predominantly directional prefixes, forming pairs such as e-/o- and he-/ho- to denote direction towards and direction away from something.","ja":"名詞接頭辞は主に方向接頭辞であり、e-/o- や he-/ho- のように対をなして対象へ向かう方向と離れる方向を表す。"},"type":"form-function","scope":{"doculects":["doculect:hokkaido/southwest/shizunai"],"quantifier":"generic","modality":"actual","conditions":[]},"forms":["e-","o-","he-","ho-"],"statements":[{"id":"stmt:refsing1986@gemini-3-flash-preview/l0152-02","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-26T07-52-28-143Z","status":"grouped"}

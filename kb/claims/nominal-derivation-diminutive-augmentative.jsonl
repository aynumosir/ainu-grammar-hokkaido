{"id":"claim:nominal/nominal-derivation-diminutive-augmentative--diminutive-suffix-po-derives-small-noun","revision":1,"topic":"topic:nominal/nominal-derivation-diminutive-augmentative","topics":["topic:nominal/nominal-derivation-diminutive-augmentative","topic:nominal/nominal-derivation-diminutive-augmentative--overview"],"statement":{"en":"The diminutive suffix -po attaches to nouns to derive nouns meaning 'small X'.","ja":"指小接尾辞 -po は名詞に付いて「小さい〜」を意味する名詞を派生する。"},"type":"form-function","scope":{"doculects":["doculect:ainu"],"quantifier":"unstated","modality":"assertive","conditions":[]},"forms":["-po","cep-po","cheppo"],"statements":[{"id":"stmt:kindaichi1936@gemini-3-flash-preview/l0181-01","stance":"asserts"},{"id":"stmt:sato2008@gemini-3-flash-preview/l0283-03","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-26T07-52-28-143Z","status":"grouped"}
{"id":"claim:nominal/nominal-derivation-diminutive-augmentative--certain-nouns-express-the-feminine-by-prefixing-mat","revision":1,"topic":"topic:nominal/nominal-derivation-diminutive-augmentative","topics":["topic:nominal/nominal-derivation-diminutive-augmentative"],"statement":{"en":"Certain nouns express the feminine by prefixing mat- (e.g., ainu 'man' vs matainu 'woman', karku 'nephew' vs matkarku 'niece', ak 'younger brother' vs matak 'younger sister', hekachi 'boy' vs matkachi 'girl').","ja":"若干の名詞はmat-を冠して女性を表示する（例：ainu/matainu、karku/matkarku、ak/matak、hekachi/matkachi）。"},"type":"form-function","scope":{"doculects":[],"quantifier":"exists","modality":"actual","conditions":[]},"forms":["mat-","matainu","matkarku","matak","matkachi"],"statements":[{"id":"stmt:kindaichi1936@gemini-3-flash-preview/l0042-01","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-26T07-52-28-143Z","status":"grouped"}

{"id":"claim:negation/negation-polarity-items-scope--nothing-exists-and-nobody-exists-are-expressed-by","revision":1,"topic":"topic:negation/negation-polarity-items-scope","topics":["topic:negation/negation-polarity-items-scope","topic:negation/negation-polarity-items-scope--series"],"statement":{"en":"'Nothing exists' and 'nobody exists' are expressed by neera'ampe ka 'isam and nee 'aynu ka 'isam, respectively.","ja":"「何もない」「誰もいない」は neera'ampe ka 'isam, nee 'aynu ka 'isam という。"},"type":"form-function","scope":{"doculects":["doculect:sakhalin"],"quantifier":"generic","modality":"actual","conditions":[]},"forms":["neera'ampe ka 'isam","nee 'aynu ka 'isam"],"statements":[{"id":"stmt:murasaki2025@gemini-3-flash-preview/l0025-02","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-26T07-52-28-143Z","status":"grouped"}

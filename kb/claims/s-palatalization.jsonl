{"id":"claim:phon/s-palatalization--refsing-s-palatalization-conditioning","revision":1,"topic":"topic:phon/s-palatalization","topics":["topic:phon/s-palatalization","topic:phon/s-palatalization--overview"],"statement":{"en":"The fricative /s/ palatalizes to [ʃ] before /i/, and syllable-final /-s/ is often palatalized unless followed by a word commencing with [s].","ja":"摩擦音/s/は/i/の前で[ʃ]に口蓋化し、音節末の/-s/は[s]で始まる語が後続しない限りしばしば口蓋化する。"},"type":"alternation","scope":{"doculects":["doculect:hokkaido"],"quantifier":"often","modality":"assertive","conditions":["before /i/","syllable-finally unless followed by word-initial [s]"]},"forms":["s","i"],"statements":[{"id":"stmt:refsing1986@gemini-3-flash-preview/l0062-14","stance":"asserts"},{"id":"stmt:refsing1986@gemini-3-flash-preview/l0063-09","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-26T07-52-28-143Z","status":"grouped"}
{"id":"claim:phon/s-palatalization--in-chitose-ainu-s-is-as-a-rule","revision":1,"topic":"topic:phon/s-palatalization","topics":["topic:phon/s-palatalization","topic:phon/s-palatalization--coda-allophony"],"statement":{"en":"In Chitose Ainu, /s/ is as a rule not palatalized, unless it is preceded or followed by /i/.","ja":"千歳アイヌ語において、/s/は/i/に先行されるか後続されない限り、原則として口蓋化しない。"},"type":"distribution","scope":{"doculects":["doculect:hokkaido/chitose"],"quantifier":"usually","modality":"actual","conditions":["unless preceded or followed by /i/"]},"forms":["/s/","/i/"],"statements":[{"id":"stmt:bugaeva2012@gemini-3-flash-preview/l0004-07","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-26T07-52-28-143Z","status":"grouped"}
{"id":"claim:phon/s-palatalization--syllable-final-s-resembles-the-initial-sound-of","revision":1,"topic":"topic:phon/s-palatalization","topics":["topic:phon/s-palatalization","topic:phon/s-palatalization--coda-allophony"],"statement":{"en":"Syllable-final s resembles the initial sound of Japanese 'shi' ([ɕ]), but can also be pronounced close to [s].","ja":"音節末の s は日本語の「し」の頭音に似ているが，[s]に近い発音されることもある。"},"type":"variation","scope":{"doculects":["doculect:ainu"],"quantifier":"generic","modality":"actual","conditions":["syllable-final"]},"forms":["s"],"statements":[{"id":"stmt:sato2008@gemini-3-flash-preview/l0029-01","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-26T07-52-28-143Z","status":"grouped"}
{"id":"claim:phon/s-palatalization--the-sequence-si-is-pronounced-i-rather-than","revision":1,"topic":"topic:phon/s-palatalization","topics":["topic:phon/s-palatalization","topic:phon/s-palatalization--onset-realization"],"statement":{"en":"The sequence si is pronounced [ʃi] ('シ') rather than [si] ('スィ').","ja":"si は「スィ」ではなく，「シ」と発音される。"},"type":"other","scope":{"doculects":["doculect:ainu"],"quantifier":"all","modality":"actual","conditions":[]},"forms":["si"],"statements":[{"id":"stmt:sato2008@gemini-3-flash-preview/l0028-02","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-26T07-52-28-143Z","status":"grouped"}
{"id":"claim:phon/s-palatalization--s-and-sh-belong-to-the-same-phoneme","revision":1,"topic":"topic:phon/s-palatalization","topics":["topic:phon/s-palatalization","topic:phon/s-palatalization--overview"],"statement":{"en":"s and sh belong to the same phoneme, sh being merely a slightly palatalized variant of s.","ja":"s と sh も同一の音素であり、後者は前者が少し口蓋化した程度のものにすぎない。"},"type":"analysis","scope":{"doculects":["doculect:ainu"],"quantifier":"all","modality":"actual","conditions":[]},"forms":["s","sh"],"statements":[{"id":"stmt:kindaichi1936@gemini-3-flash-preview/l0016-06","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-26T07-52-28-143Z","status":"grouped"}
{"id":"claim:phon/s-palatalization--s-is-pronounced-syllable-finally-and-in-the","revision":1,"topic":"topic:phon/s-palatalization","topics":["topic:phon/s-palatalization","topic:phon/s-palatalization--overview"],"statement":{"en":"/s/ is pronounced [ʃ] syllable-finally and in the syllable /si/, and [s] elsewhere.","ja":"音節末と /si/ における /s/ は [ʃ] であり、それ以外の位置では [s] である。"},"type":"alternation","scope":{"doculects":["doculect:sakhalin"],"quantifier":"all","modality":"necessary","conditions":[]},"forms":["/s/","/si/"],"statements":[{"id":"stmt:murasaki2025@gemini-3-flash-preview/l0010-02","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-26T07-52-28-143Z","status":"grouped"}
{"id":"claim:phon/s-palatalization--the-fricative-s-is-realized-as-either-s","revision":1,"topic":"topic:phon/s-palatalization","topics":["topic:phon/s-palatalization","topic:phon/s-palatalization--overview"],"statement":{"en":"The fricative /s/ is realized as either [s] or [ʃ], occurring consistently as [ʃ] before [i] and in syllable-final position.","ja":"摩擦音 /s/ は [s] または [ʃ] として現れ、[i] の前および音節末の位置では常に [ʃ] として生起する。"},"type":"distribution","scope":{"doculects":["doculect:ainu"],"quantifier":"generic","modality":"actual","conditions":["before [i] and in syllable-final position"]},"forms":["s"],"statements":[{"id":"stmt:shibatani1990@gemini-3-flash-preview/l0014-14","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-26T07-52-28-143Z","status":"grouped"}
{"id":"claim:phon/s-palatalization--the-pronunciation-of-si-in-ainu-is-identical","revision":1,"topic":"topic:phon/s-palatalization","topics":["topic:phon/s-palatalization","topic:phon/s-palatalization--vs-japanese"],"statement":{"en":"The pronunciation of si in Ainu is identical to Japanese [ɕi] (shi), not [si].","ja":"アイヌ語の si の発音は「スィ」のような音ではなく、日本語の「し」と同じである。"},"type":"form-function","scope":{"doculects":["doculect:hokkaido"],"quantifier":"all","modality":"actual","conditions":[]},"forms":["si"],"statements":[{"id":"stmt:nakagawa2024@gemini-3-flash-preview/l0043-05","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-26T07-52-28-143Z","status":"grouped"}

{"id":"claim:diachrony/final-h-history-and-sakhalin-length-reflex--plural-suffix-alternation-reveals-underlying-stops","revision":1,"topic":"topic:diachrony/final-h-history-and-sakhalin-length-reflex","topics":["topic:diachrony/final-h-history-and-sakhalin-length-reflex","topic:diachrony/final-h-history-and-sakhalin-length-reflex--debuccalization-affiliative"],"statement":{"en":"In Sakhalin Ainu, the plural suffix -hci/-hcin shortens a preceding long vowel and surfaces as -ahci/-ahcin with underlying /p/, /t/, or /k/ surfacing from derived coda -h.","ja":"樺太アイヌ語において、複数接辞 -hci/-hcin は先行する長母音を短母音化し、派生的な末子音 -h の後では -ahci/-ahcin の前で基底の p, t, k が表面化する。"},"type":"alternation","scope":{"doculects":["doculect:sakhalin"],"quantifier":"all","modality":"assertive","conditions":["suffixation of plural marker"]},"forms":["-hci","-hcin","-ahci","-ahcin","p","t","k","-h"],"statements":[{"id":"stmt:tangiku2022@handbook-epub/l0059-10","stance":"asserts"}],"relations":[{"kind":"supports","claim":"claim:diachrony/final-h-history-and-sakhalin-length-reflex--sakhalin-coda-stops-debuccalize-to-h","differs_in":null,"note":"Morphophonemic alternations preserve underlying stops that otherwise debuccalize to /h/"}],"grouped_by":"act:group/2026-09-26T07-52-28-143Z","status":"grouped"}

{"id":"claim:diachrony/final-h-history-and-sakhalin-length-reflex--taraika-retention-of-coda-stops","revision":1,"topic":"topic:diachrony/final-h-history-and-sakhalin-length-reflex","topics":["topic:diachrony/final-h-history-and-sakhalin-length-reflex","topic:diachrony/final-h-history-and-sakhalin-length-reflex--debuccalization-affiliative"],"statement":{"en":"Retention of syllable-final /p/, /t/, and /k/ in Sakhalin Ainu is restricted to the Taraika dialect.","ja":"樺太アイヌ語における音節末 -p, -t, -k の保持はタライカ方言にのみ見られる。"},"type":"distribution","scope":{"doculects":["doculect:sakhalin_taraika"],"quantifier":"all","modality":"assertive","conditions":["syllable-final position"]},"forms":["-p","-t","-k"],"statements":[{"id":"stmt:nakagawa2024@gemini-3-flash-preview/l0104-04","stance":"asserts"}],"relations":[{"kind":"refines","claim":"claim:diachrony/final-h-history-and-sakhalin-length-reflex--sakhalin-coda-stops-debuccalize-to-h","differs_in":"dialect","note":"Taraika is an exception where coda stops are retained rather than debuccalized"}],"grouped_by":"act:group/2026-09-26T07-52-28-143Z","status":"grouped"}

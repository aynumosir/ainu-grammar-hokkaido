{"id":"claim:contact/northern-contact-nivkh-tungusic-manchu--sakhalin-ainu-tanku-tungusic-loan","revision":1,"topic":"topic:contact/northern-contact-nivkh-tungusic-manchu","topics":["topic:contact/northern-contact-nivkh-tungusic-manchu","topic:contact/northern-contact-nivkh-tungusic-manchu--tungusic-manchu-santan"],"statement":{"en":"Sakhalin Ainu numeral tanku '100' is a borrowing from Tungusic.","ja":"樺太アイヌ語の数詞 tanku「100」はツングース諸語からの借用語である。"},"type":"diachrony","scope":{"doculects":["doculect:sakhalin"],"quantifier":"unstated","modality":"assertive","conditions":[]},"forms":["tanku"],"statements":[{"id":"stmt:nakagawa2024@gemini-3-flash-preview/l0464-02","stance":"proposes"},{"id":"stmt:tangiku2022@handbook-epub/l0056-05","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-26T07-52-28-143Z","status":"grouped"}
{"id":"claim:contact/northern-contact-nivkh-tungusic-manchu--in-sakhalin-ainu-wheat-flour-was-called-moka","revision":1,"topic":"topic:contact/northern-contact-nivkh-tungusic-manchu","topics":["topic:contact/northern-contact-nivkh-tungusic-manchu"],"statement":{"en":"In Sakhalin Ainu, wheat flour was called moka, borrowed from Russian muka.","ja":"樺太アイヌ語では小麦粉をロシア語の muka に由来する moka と呼んだ。"},"type":"diachrony","scope":{"doculects":["doculect:sakhalin"],"quantifier":"generic","modality":"actual","conditions":[]},"forms":["moka"],"statements":[{"id":"stmt:ono2022@handbook-epub/l0080-10","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-26T07-52-28-143Z","status":"grouped"}
{"id":"claim:contact/northern-contact-nivkh-tungusic-manchu--the-form-sumer-en-kur-is-an-exonym","revision":1,"topic":"topic:contact/northern-contact-nivkh-tungusic-manchu","topics":["topic:contact/northern-contact-nivkh-tungusic-manchu","topic:contact/northern-contact-nivkh-tungusic-manchu--ainu-nivkh-lexical"],"statement":{"en":"The form Sumer-en-kur is an exonym used by the Ainu for the Amur Ghilyak.","ja":"語形 Sumer-en-kur は、アイヌがアムール・ギリヤークを指すのに用いる他称詞である。"},"type":"form-function","scope":{"doculects":["doculect:ainu"],"quantifier":"generic","modality":"actual","conditions":[]},"forms":["Sumer-en-kur"],"statements":[{"id":"stmt:janhunen2022@handbook-epub/l0010-12","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-26T07-52-28-143Z","status":"grouped"}
{"id":"claim:contact/northern-contact-nivkh-tungusic-manchu--ainu-tunakay-reindeer-reflects-early-lexical-interaction-with","revision":1,"topic":"topic:contact/northern-contact-nivkh-tungusic-manchu","topics":["topic:contact/northern-contact-nivkh-tungusic-manchu","topic:contact/northern-contact-nivkh-tungusic-manchu--ainu-nivkh-lexical"],"statement":{"en":"Ainu tunakay 'reindeer' reflects early lexical interaction with Nivkh, having been borrowed from Pre-Proto-Ghilyak *tola-ŋa.y 'pulling animal'.","ja":"アイヌ語 tunakay「トナカイ」はギリヤーク語（ニヴフ語）との初期の語彙接触を反映しており、プレ祖ギリヤーク語 *tola-ŋa.y「引く動物」からの借用である。"},"type":"diachrony","scope":{"doculects":["doculect:ainu"],"quantifier":"unstated","modality":"actual","conditions":[]},"forms":["tunakay"],"statements":[{"id":"stmt:janhunen2022@handbook-epub/l0011-04","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-26T07-52-28-143Z","status":"grouped"}
{"id":"claim:contact/northern-contact-nivkh-tungusic-manchu--ainu-shares-lexical-resemblances-with-surrounding-non-japanese","revision":1,"topic":"topic:contact/northern-contact-nivkh-tungusic-manchu","topics":["topic:contact/northern-contact-nivkh-tungusic-manchu","topic:contact/northern-contact-nivkh-tungusic-manchu--ainu-nivkh-lexical"],"statement":{"en":"Ainu shares lexical resemblances with surrounding non-Japanese languages, such as Ainu kotan 'settlement' with Nivkh xotaN 'town', and Ainu casi 'fortress' with Middle Korean čas 'fortress'.","ja":"アイヌ語の kotan「村」とニブフ語 xotaN「町」、アイヌ語 casi「砦」と中期朝鮮語 čas「城」のように、周辺言語との語彙的類似が存在する。"},"type":"existence","scope":{"doculects":["doculect:ainu"],"quantifier":"example_only","modality":"actual","conditions":[]},"forms":["kotan","casi"],"statements":[{"id":"stmt:sato2008@gemini-3-flash-preview/l0025-02","stance":"reports"}],"relations":[],"grouped_by":"act:group/2026-09-26T07-52-28-143Z","status":"grouped"}
{"id":"claim:contact/northern-contact-nivkh-tungusic-manchu--some-settlements-on-sakhalin-had-names-in-both","revision":1,"topic":"topic:contact/northern-contact-nivkh-tungusic-manchu","topics":["topic:contact/northern-contact-nivkh-tungusic-manchu","topic:contact/northern-contact-nivkh-tungusic-manchu--ainu-nivkh-lexical"],"statement":{"en":"Some settlements on Sakhalin had names in both Ainu and Nivkh, such as Ainu Poro kotan and Nivkh Pile vo, both meaning 'big settlement'.","ja":"サハリンの集落にはアイヌ語の Poro kotan とニヴフ語の Pile vo（いずれも「大集落」の意）のように、2言語で並行する地名をもつものがあった。"},"type":"existence","scope":{"doculects":["doculect:sakhalin"],"quantifier":"example_only","modality":"actual","conditions":[]},"forms":["Poro kotan"],"statements":[{"id":"stmt:shiraishitangiku2022@handbook-epub/l0045-01","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-26T07-52-28-143Z","status":"grouped"}
{"id":"claim:contact/northern-contact-nivkh-tungusic-manchu--sakhalin-ainu-nuso-or-nuhsu-dog-sled-is","revision":1,"topic":"topic:contact/northern-contact-nivkh-tungusic-manchu","topics":["topic:contact/northern-contact-nivkh-tungusic-manchu","topic:contact/northern-contact-nivkh-tungusic-manchu--ainu-nivkh-lexical"],"statement":{"en":"Sakhalin Ainu nuso or nuhsu 'dog sled' is a borrowing from Nivkh nuci.","ja":"樺太アイヌ語のnuso / nuhsu（犬ぞり一式）はニヴフ語nuciからの借用である。"},"type":"diachrony","scope":{"doculects":["doculect:sakhalin"],"quantifier":"all","modality":"actual","conditions":[]},"forms":["nuso","nuhsu"],"statements":[{"id":"stmt:shiraishitangiku2022@handbook-epub/l0046-04","stance":"reports"}],"relations":[],"grouped_by":"act:group/2026-09-26T07-52-28-143Z","status":"grouped"}
{"id":"claim:contact/northern-contact-nivkh-tungusic-manchu--nivkh-t-corresponds-to-sakhalin-ainu-r-in","revision":1,"topic":"topic:contact/northern-contact-nivkh-tungusic-manchu","topics":["topic:contact/northern-contact-nivkh-tungusic-manchu","topic:contact/northern-contact-nivkh-tungusic-manchu--ainu-nivkh-lexical"],"statement":{"en":"Nivkh [t] corresponds to Sakhalin Ainu [r] in loanwords between the two languages, as in Nivkh maxt to Sakhalin Ainu mahru 'towline spreader' and Nivkh mut to Sakhalin Ainu muhru 'pillow'.","ja":"ニヴフ語の[t]と樺太アイヌ語の[r]の対応は、ニヴフ語maxtと樺太アイヌ語mahru（手綱よけ）、あるいはニヴフ語mutと樺太アイヌ語muhru（枕）に見られるように、両言語間の借用語における一般的な対応である。"},"type":"alternation","scope":{"doculects":["doculect:sakhalin"],"quantifier":"generic","modality":"actual","conditions":["in loanwords between Nivkh and Sakhalin Ainu"]},"forms":["mahru","mohrasi","muhru"],"statements":[{"id":"stmt:shiraishitangiku2022@handbook-epub/l0046-05","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-26T07-52-28-143Z","status":"grouped"}
{"id":"claim:contact/northern-contact-nivkh-tungusic-manchu--ainu-san-shelf-for-offerings-is-hypothesized-to","revision":1,"topic":"topic:contact/northern-contact-nivkh-tungusic-manchu","topics":["topic:contact/northern-contact-nivkh-tungusic-manchu","topic:contact/northern-contact-nivkh-tungusic-manchu--ainu-nivkh-lexical"],"statement":{"en":"Ainu san 'shelf for offerings' is hypothesized to share an origin with Nivkh cʰaŋ and Uilta saan 'shelf, stand'.","ja":"アイヌ語のsan（神への捧げ物を置く棚）は、ニヴフ語cʰaŋおよびウイルタ語saan（棚、台）と同一起源であると仮定される。"},"type":"diachrony","scope":{"doculects":["doculect:sakhalin","doculect:hokkaido"],"quantifier":"all","modality":"possible","conditions":[]},"forms":["san"],"statements":[{"id":"stmt:shiraishitangiku2022@handbook-epub/l0046-10","stance":"reports"}],"relations":[],"grouped_by":"act:group/2026-09-26T07-52-28-143Z","status":"grouped"}
{"id":"claim:contact/northern-contact-nivkh-tungusic-manchu--sakhalin-ainu-juuru-bow-used-in-trap-is","revision":1,"topic":"topic:contact/northern-contact-nivkh-tungusic-manchu","topics":["topic:contact/northern-contact-nivkh-tungusic-manchu","topic:contact/northern-contact-nivkh-tungusic-manchu--ainu-nivkh-lexical"],"statement":{"en":"Sakhalin Ainu juuru 'bow used in trap' is shared with Nivkh jur and is absent from Hokkaido Ainu.","ja":"樺太アイヌ語のjuuru（仕掛け弓の弓部）はニヴフ語jurと共通しており、北海道アイヌ語には見られない。"},"type":"distribution","scope":{"doculects":["doculect:sakhalin"],"quantifier":"all","modality":"actual","conditions":[]},"forms":["juuru"],"statements":[{"id":"stmt:shiraishitangiku2022@handbook-epub/l0046-12","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-26T07-52-28-143Z","status":"grouped"}
{"id":"claim:contact/northern-contact-nivkh-tungusic-manchu--sakhalin-ainu-tuna-san-nis-harpoon-entire-is","revision":1,"topic":"topic:contact/northern-contact-nivkh-tungusic-manchu","topics":["topic:contact/northern-contact-nivkh-tungusic-manchu","topic:contact/northern-contact-nivkh-tungusic-manchu--ainu-nivkh-lexical"],"statement":{"en":"Sakhalin Ainu tuna(-san-nis) 'harpoon (entire)' is considered a loan from Nivkh tʰla or kʰla, exhibiting the sound correspondence [tʰl] > [tu].","ja":"樺太アイヌ語のtuna(-san-nis)（銛一式）はニヴフ語のtʰla、kʰlaからの借用と考えられ、[tʰl] > [tu]という音変化を示している。"},"type":"diachrony","scope":{"doculects":["doculect:sakhalin"],"quantifier":"all","modality":"possible","conditions":[]},"forms":["tuna"],"statements":[{"id":"stmt:shiraishitangiku2022@handbook-epub/l0046-13","stance":"proposes"}],"relations":[],"grouped_by":"act:group/2026-09-26T07-52-28-143Z","status":"grouped"}
{"id":"claim:contact/northern-contact-nivkh-tungusic-manchu--sakhalin-ainu-hankata-birch-bark-plate-was-borrowed","revision":1,"topic":"topic:contact/northern-contact-nivkh-tungusic-manchu","topics":["topic:contact/northern-contact-nivkh-tungusic-manchu","topic:contact/northern-contact-nivkh-tungusic-manchu--ainu-nivkh-lexical"],"statement":{"en":"Sakhalin Ainu hankata 'birch bark plate' was borrowed from Nivkh haŋr̥.","ja":"樺太アイヌ語のhankata（白樺樹皮皿）はニヴフ語haŋr̥からの借用である。"},"type":"diachrony","scope":{"doculects":["doculect:sakhalin"],"quantifier":"all","modality":"possible","conditions":[]},"forms":["hankata"],"statements":[{"id":"stmt:shiraishitangiku2022@handbook-epub/l0046-14","stance":"proposes"}],"relations":[],"grouped_by":"act:group/2026-09-26T07-52-28-143Z","status":"grouped"}
{"id":"claim:contact/northern-contact-nivkh-tungusic-manchu--nivkh-ar-ladder-was-possibly-borrowed-from-sakhalin","revision":1,"topic":"topic:contact/northern-contact-nivkh-tungusic-manchu","topics":["topic:contact/northern-contact-nivkh-tungusic-manchu","topic:contact/northern-contact-nivkh-tungusic-manchu--ainu-nivkh-lexical"],"statement":{"en":"Nivkh ɲŋar̥ 'ladder' was possibly borrowed from Sakhalin Ainu nikar, where the loss of the unaccented first syllable reflects the second-syllable accent of nikar.","ja":"ニヴフ語ɲŋar̥（梯子）は樺太アイヌ語nikarからの借用の可能性があり、nikarが第2音節にアクセントをもつため無アクセントの語頭母音が脱落したと考えられる。"},"type":"diachrony","scope":{"doculects":["doculect:sakhalin"],"quantifier":"all","modality":"possible","conditions":[]},"forms":["nikar"],"statements":[{"id":"stmt:shiraishitangiku2022@handbook-epub/l0046-15","stance":"proposes"}],"relations":[],"grouped_by":"act:group/2026-09-26T07-52-28-143Z","status":"grouped"}
{"id":"claim:contact/northern-contact-nivkh-tungusic-manchu--in-nivkh-lexical-borrowings-in-common-with-ainu","revision":1,"topic":"topic:contact/northern-contact-nivkh-tungusic-manchu","topics":["topic:contact/northern-contact-nivkh-tungusic-manchu","topic:contact/northern-contact-nivkh-tungusic-manchu--ainu-nivkh-lexical"],"statement":{"en":"In Nivkh, lexical borrowings in common with Ainu are comparatively few, suggesting that language contact along the north-south axis of Sakhalin was local and limited.","ja":"ニヴフ語においてアイヌ語と共通する借用語は比較的少なく、樺太の南北軸に沿った言語接触が局所的かつ限定的であったことを示唆している。"},"type":"frequency","scope":{"doculects":["doculect:sakhalin"],"quantifier":"unstated","modality":"actual","conditions":[]},"forms":[],"statements":[{"id":"stmt:shiraishitangiku2022@handbook-epub/l0047-01","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-26T07-52-28-143Z","status":"grouped"}
{"id":"claim:contact/northern-contact-nivkh-tungusic-manchu--the-poronaisk-dialect-of-nivkh-exceptionally-has-a","revision":1,"topic":"topic:contact/northern-contact-nivkh-tungusic-manchu","topics":["topic:contact/northern-contact-nivkh-tungusic-manchu","topic:contact/northern-contact-nivkh-tungusic-manchu--ainu-nivkh-lexical"],"statement":{"en":"The Poronaisk dialect of Nivkh exceptionally has a large number of loanwords in common with Ainu compared to other Nivkh dialects, supporting the localized nature of contact between the two languages.","ja":"ニヴフ語の方言の中でポロナイスク方言は例外的にアイヌ語と共通の借用語を多く有しており、両言語間の接触の局所性を裏付けている。"},"type":"variation","scope":{"doculects":["doculect:sakhalin"],"quantifier":"unstated","modality":"actual","conditions":[]},"forms":[],"statements":[{"id":"stmt:shiraishitangiku2022@handbook-epub/l0047-02","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-26T07-52-28-143Z","status":"grouped"}
{"id":"claim:contact/northern-contact-nivkh-tungusic-manchu--thirty-one-loanwords-are-identified-as-common-across","revision":1,"topic":"topic:contact/northern-contact-nivkh-tungusic-manchu","topics":["topic:contact/northern-contact-nivkh-tungusic-manchu","topic:contact/northern-contact-nivkh-tungusic-manchu--ainu-nivkh-lexical"],"statement":{"en":"Thirty-one loanwords are identified as common across Ainu, Nivkh, and Uilta on Sakhalin.","ja":"樺太においてアイヌ語、ニヴフ語、ウイルタ語に共通する借用語として31語が同定される。"},"type":"frequency","scope":{"doculects":["doculect:sakhalin"],"quantifier":"measured","modality":"actual","conditions":[]},"forms":[],"statements":[{"id":"stmt:shiraishitangiku2022@handbook-epub/l0047-04","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-26T07-52-28-143Z","status":"grouped"}
{"id":"claim:contact/northern-contact-nivkh-tungusic-manchu--twenty-nine-loanwords-are-identified-as-shared-exclusively","revision":1,"topic":"topic:contact/northern-contact-nivkh-tungusic-manchu","topics":["topic:contact/northern-contact-nivkh-tungusic-manchu","topic:contact/northern-contact-nivkh-tungusic-manchu--ainu-nivkh-lexical"],"statement":{"en":"Twenty-nine loanwords are identified as shared exclusively between Nivkh and Ainu on Sakhalin.","ja":"樺太においてニヴフ語とアイヌ語の間で共通する借用語として29語が同定される。"},"type":"frequency","scope":{"doculects":["doculect:sakhalin"],"quantifier":"measured","modality":"actual","conditions":[]},"forms":[],"statements":[{"id":"stmt:shiraishitangiku2022@handbook-epub/l0047-05","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-26T07-52-28-143Z","status":"grouped"}
{"id":"claim:contact/northern-contact-nivkh-tungusic-manchu--ainu-loanwords-borrowed-into-other-languages-of-sakhalin","revision":1,"topic":"topic:contact/northern-contact-nivkh-tungusic-manchu","topics":["topic:contact/northern-contact-nivkh-tungusic-manchu","topic:contact/northern-contact-nivkh-tungusic-manchu--evidence-limits"],"statement":{"en":"Ainu loanwords borrowed into other languages of Sakhalin were very rarely transmitted to the Asian continent.","ja":"サハリンの他の言語に借用されたアイヌ語の単語のうち、大陸に伝わったものはきわめて少ない。"},"type":"distribution","scope":{"doculects":["doculect:sakhalin"],"quantifier":"usually","modality":"actual","conditions":[]},"forms":[],"statements":[{"id":"stmt:shiraishitangiku2022@handbook-epub/l0045-03","stance":"reports"}],"relations":[],"grouped_by":"act:group/2026-09-26T07-52-28-143Z","status":"grouped"}
{"id":"claim:contact/northern-contact-nivkh-tungusic-manchu--ainu-kaya-refers-to-both-fish-skin-clothing","revision":1,"topic":"topic:contact/northern-contact-nivkh-tungusic-manchu","topics":["topic:contact/northern-contact-nivkh-tungusic-manchu","topic:contact/northern-contact-nivkh-tungusic-manchu--hokkaido-residue"],"statement":{"en":"Ainu kaya refers to both fish-skin clothing and sails in Sakhalin and Hokkaido, though in Hokkaido dialects the 'fish-skin' sense has bleached and it refers simply to sails.","ja":"アイヌ語のkayaは樺太および北海道において魚皮衣と帆の双方を指すが、北海道方言では「魚皮」の意味が脱落して単に「帆」を指す単語になっている。"},"type":"form-function","scope":{"doculects":["doculect:sakhalin","doculect:hokkaido"],"quantifier":"all","modality":"actual","conditions":[]},"forms":["kaya"],"statements":[{"id":"stmt:shiraishitangiku2022@handbook-epub/l0046-07","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-26T07-52-28-143Z","status":"grouped"}
{"id":"claim:contact/northern-contact-nivkh-tungusic-manchu--on-the-island-of-sakhalin-three-genealogically-distinct","revision":1,"topic":"topic:contact/northern-contact-nivkh-tungusic-manchu","topics":["topic:contact/northern-contact-nivkh-tungusic-manchu","topic:contact/northern-contact-nivkh-tungusic-manchu--overview"],"statement":{"en":"On the island of Sakhalin, three genealogically distinct languages—Ainu, Nivkh, and Uilta—came into contact through social and economic activities.","ja":"サハリン島において、系統を異にする3言語であるアイヌ語、ニヴフ語、ウィルタ語が社会・経済活動を通じて接触した。"},"type":"existence","scope":{"doculects":["doculect:sakhalin"],"quantifier":"unstated","modality":"actual","conditions":[]},"forms":[],"statements":[{"id":"stmt:shiraishitangiku2022@handbook-epub/l0044-01","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-26T07-52-28-143Z","status":"grouped"}
{"id":"claim:contact/northern-contact-nivkh-tungusic-manchu--among-the-dialects-of-ainu-it-is-the","revision":1,"topic":"topic:contact/northern-contact-nivkh-tungusic-manchu","topics":["topic:contact/northern-contact-nivkh-tungusic-manchu","topic:contact/northern-contact-nivkh-tungusic-manchu--overview"],"statement":{"en":"Among the dialects of Ainu, it is the Sakhalin dialect that exhibits the most characteristics in common with Nivkh and Uilta.","ja":"アイヌ語の諸方言のなかで、ニヴフ語やウィルタ語と共通する特徴を最も多く示すのは樺太方言である。"},"type":"variation","scope":{"doculects":["doculect:sakhalin"],"quantifier":"unstated","modality":"actual","conditions":[]},"forms":[],"statements":[{"id":"stmt:shiraishitangiku2022@handbook-epub/l0045-02","stance":"reports"}],"relations":[],"grouped_by":"act:group/2026-09-26T07-52-28-143Z","status":"grouped"}
{"id":"claim:contact/northern-contact-nivkh-tungusic-manchu--the-central-region-of-sakhalin-where-the-ainu","revision":1,"topic":"topic:contact/northern-contact-nivkh-tungusic-manchu","topics":["topic:contact/northern-contact-nivkh-tungusic-manchu","topic:contact/northern-contact-nivkh-tungusic-manchu--overview"],"statement":{"en":"The central region of Sakhalin, where the Ainu contacted the Nivkh and Uilta, may have developed a unique language use situation distinct from other regions of the island.","ja":"アイヌがニヴフやウイルタと接触した樺太中央部は、他の地域とは異なる独特の言語使用状況を発達させた可能性がある。"},"type":"other","scope":{"doculects":["doculect:sakhalin"],"quantifier":"unstated","modality":"possible","conditions":[]},"forms":[],"statements":[{"id":"stmt:shiraishitangiku2022@handbook-epub/l0047-03","stance":"proposes"}],"relations":[],"grouped_by":"act:group/2026-09-26T07-52-28-143Z","status":"grouped"}
{"id":"claim:contact/northern-contact-nivkh-tungusic-manchu--the-innovative-v-poss-form-in-sakhalin-ainu","revision":1,"topic":"topic:contact/northern-contact-nivkh-tungusic-manchu","topics":["topic:contact/northern-contact-nivkh-tungusic-manchu","topic:contact/northern-contact-nivkh-tungusic-manchu--sprachbund"],"statement":{"en":"The innovative V-poss form in Sakhalin Ainu may have developed under the influence of Tungusic languages spoken in Sakhalin (especially Uilta).","ja":"樺太アイヌ語の革新的なV-poss形式は、樺太で話されていたツングース系言語（特にウィルタ語）の影響下で発達した可能性がある。"},"type":"diachrony","scope":{"doculects":["doculect:sakhalin"],"quantifier":"generic","modality":"possible","conditions":[]},"forms":["v-poss"],"statements":[{"id":"stmt:bugaeva2016@pdftotext-pieces/l0015-01","stance":"proposes"}],"relations":[],"grouped_by":"act:group/2026-09-26T07-52-28-143Z","status":"grouped"}
{"id":"claim:contact/northern-contact-nivkh-tungusic-manchu--ainu-nivkh-and-uilta-share-a-number-of","revision":1,"topic":"topic:contact/northern-contact-nivkh-tungusic-manchu","topics":["topic:contact/northern-contact-nivkh-tungusic-manchu","topic:contact/northern-contact-nivkh-tungusic-manchu--sprachbund"],"statement":{"en":"Ainu, Nivkh, and Uilta share a number of linguistic characteristics that are not found in the dialects of other regions or in their respective sister languages.","ja":"アイヌ語、ニヴフ語、ウィルタ語の間には、他地域の諸方言や同系統の言語には見られない共通の言語的特徴が複数存在する。"},"type":"existence","scope":{"doculects":["doculect:sakhalin"],"quantifier":"unstated","modality":"actual","conditions":[]},"forms":[],"statements":[{"id":"stmt:shiraishitangiku2022@handbook-epub/l0044-02","stance":"reports"}],"relations":[],"grouped_by":"act:group/2026-09-26T07-52-28-143Z","status":"grouped"}
{"id":"claim:contact/northern-contact-nivkh-tungusic-manchu--the-form-orakata-is-an-exonym-used-by","revision":1,"topic":"topic:contact/northern-contact-nivkh-tungusic-manchu","topics":["topic:contact/northern-contact-nivkh-tungusic-manchu","topic:contact/northern-contact-nivkh-tungusic-manchu--tungusic-manchu-santan"],"statement":{"en":"The form Orakata is an exonym used by the Ainu for the Amur Tungus.","ja":"語形 Orakata は、アイヌがアムール・ツングースを指すのに用いる他称詞である。"},"type":"form-function","scope":{"doculects":["doculect:ainu"],"quantifier":"generic","modality":"actual","conditions":[]},"forms":["Orakata"],"statements":[{"id":"stmt:janhunen2022@handbook-epub/l0010-11","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-26T07-52-28-143Z","status":"grouped"}
{"id":"claim:contact/northern-contact-nivkh-tungusic-manchu--the-ainu-noun-in-w-ritual-shavings-is","revision":1,"topic":"topic:contact/northern-contact-nivkh-tungusic-manchu","topics":["topic:contact/northern-contact-nivkh-tungusic-manchu","topic:contact/northern-contact-nivkh-tungusic-manchu--tungusic-manchu-santan"],"statement":{"en":"The Ainu noun 'ináw 'ritual shavings' is shared with neighbouring languages of Sakhalin and the Amur basin and is of Tungusic origin.","ja":"アイヌ語の名詞 'ináw「削り掛け」は樺太およびアムール川流域の近隣言語と共有されており、ツングース諸語起源である。"},"type":"diachrony","scope":{"doculects":["doculect:ainu"],"quantifier":"unstated","modality":"actual","conditions":[]},"forms":["'ináw"],"statements":[{"id":"stmt:janhunen2022@handbook-epub/l0011-08","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-26T07-52-28-143Z","status":"grouped"}
{"id":"claim:contact/northern-contact-nivkh-tungusic-manchu--sakhalin-ainu-tonkori-stringed-musical-instrument-is-thought","revision":1,"topic":"topic:contact/northern-contact-nivkh-tungusic-manchu","topics":["topic:contact/northern-contact-nivkh-tungusic-manchu","topic:contact/northern-contact-nivkh-tungusic-manchu--tungusic-manchu-santan"],"statement":{"en":"Sakhalin Ainu tonkori 'stringed musical instrument' is thought to be a loan from Manchu.","ja":"樺太アイヌ語のtonkori（弦楽器）は満洲語からの借用語であると考えられている。"},"type":"diachrony","scope":{"doculects":["doculect:sakhalin"],"quantifier":"all","modality":"possible","conditions":[]},"forms":["tonkori"],"statements":[{"id":"stmt:shiraishitangiku2022@handbook-epub/l0046-16","stance":"reports"}],"relations":[],"grouped_by":"act:group/2026-09-26T07-52-28-143Z","status":"grouped"}
{"id":"claim:contact/northern-contact-nivkh-tungusic-manchu--on-the-west-coast-of-sakhalin-ainu-uses","revision":1,"topic":"topic:contact/northern-contact-nivkh-tungusic-manchu","topics":["topic:contact/northern-contact-nivkh-tungusic-manchu","topic:contact/northern-contact-nivkh-tungusic-manchu--tungusic-manchu-santan"],"statement":{"en":"On the west coast of Sakhalin, Ainu uses the Uilta loanword wampakka for 'mittens', whereas on the east coast the word matumere is used.","ja":"樺太西海岸のアイヌ語では「ミトン」にウイルタ語からの借用語wampakkaが用いられるのに対し、東海岸ではmatumereという語が用いられる。"},"type":"variation","scope":{"doculects":["doculect:sakhalin"],"quantifier":"all","modality":"actual","conditions":[]},"forms":["wampakka","matumere"],"statements":[{"id":"stmt:shiraishitangiku2022@handbook-epub/l0046-17","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-26T07-52-28-143Z","status":"grouped"}

{"id":"claim:nominal/nominal-subclasses-and-bound-nouns--quantity-nouns-can-all-appear-in-apposition-to","revision":1,"topic":"topic:nominal/nominal-subclasses-and-bound-nouns","topics":["topic:nominal/nominal-subclasses-and-bound-nouns","topic:nominal/nominal-subclasses-and-bound-nouns--common-nouns"],"statement":{"en":"Quantity nouns can all appear in apposition to the noun they modify or function as pure nouns.","ja":"数量名詞はすべて、修飾する名詞と同格になることも、純粋な名詞として機能することもできる。"},"type":"distribution","scope":{"doculects":["doculect:hokkaido/southwest/shizunai"],"quantifier":"all","modality":"possible","conditions":[]},"forms":["poronno","ponno","opitta","inne"],"statements":[{"id":"stmt:refsing1986@gemini-3-flash-preview/l0113-05","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-13-12-354Z","status":"grouped"}

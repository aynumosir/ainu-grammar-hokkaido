{"id":"claim:valency/adverbial-incorporation--no-omission-in-adverb-incorporation","revision":1,"topic":"topic:valency/adverbial-incorporation","topics":["topic:valency/adverbial-incorporation","topic:valency/adverbial-incorporation--overview"],"statement":{"en":"Adverbs derived with the suffix -no omit that suffix and incorporate into the verb stem as bare roots.","ja":"接尾辞 -no によって派生した副詞が動詞に抱合される際、接尾辞 -no は脱落して語根のみが抱合される。"},"type":"alternation","scope":{"doculects":["doculect:ainu"],"quantifier":"all","modality":"asserted","conditions":["when incorporated into a verb"]},"forms":["-no"],"statements":[{"id":"stmt:kindaichi1936@gemini-3-flash-preview/l0213-04","stance":"asserts"},{"id":"stmt:shibatani1990@gemini-3-flash-preview/l0044-06","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-26T07-52-28-143Z","status":"grouped"}
{"id":"claim:valency/adverbial-incorporation--manner-verb-incorporates-bare","revision":1,"topic":"topic:valency/adverbial-incorporation","topics":["topic:valency/adverbial-incorporation","topic:valency/adverbial-incorporation--overview"],"statement":{"en":"When a verb adverbialized by -no is incorporated with adverbial meaning, the suffix -no is removed and the verb incorporates in its bare verb form.","ja":"接尾辞 -no によって副詞化された動詞が副詞的意味で取り込まれる際、-no は取り除かれ、動詞の形のままで抱合される。"},"type":"form-function","scope":{"doculects":["doculect:ainu"],"quantifier":"all","modality":"asserted","conditions":["adverbial incorporation of verb adverbialized by -no"]},"forms":["-no","pirka-no","pirka","a=pirka-ipere"],"statements":[{"id":"stmt:nakagawa2024@gemini-3-flash-preview/l0480-03","stance":"asserts"}],"relations":[{"kind":"contrasts","claim":"claim:valency/adverbial-incorporation--no-omission-in-adverb-incorporation","differs_in":"framework","note":"Nakagawa analyzes the incorporated element as a bare verb rather than an adverb that has dropped -no."}],"grouped_by":"act:group/2026-09-26T07-52-28-143Z","status":"grouped"}
{"id":"claim:valency/adverbial-incorporation--adverbs-incorporate-freely","revision":1,"topic":"topic:valency/adverbial-incorporation","topics":["topic:valency/adverbial-incorporation","topic:valency/adverbial-incorporation--overview"],"statement":{"en":"Adverbs incorporate rather freely into verbs.","ja":"副詞は動詞にごく自由に抱合される。"},"type":"distribution","scope":{"doculects":["doculect:ainu"],"quantifier":"all","modality":"asserted","conditions":[]},"forms":[],"statements":[{"id":"stmt:shibatani1990@gemini-3-flash-preview/l0044-03","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-26T07-52-28-143Z","status":"grouped"}
{"id":"claim:valency/adverbial-incorporation--no-productive-adverb-incorporation","revision":1,"topic":"topic:valency/adverbial-incorporation","topics":["topic:valency/adverbial-incorporation","topic:valency/adverbial-incorporation--typology"],"statement":{"en":"Ainu lacks productive adverbial incorporation, and verbal adverbial prefixes are virtually limited to ar- 'completely'.","ja":"アイヌ語には生産的な副詞抱合は見られず、動詞の副詞的接頭辞も ar-「全く」程度に限られる。"},"type":"distribution","scope":{"doculects":["doculect:ainu"],"quantifier":"all","modality":"asserted","conditions":[]},"forms":["ar-"],"statements":[{"id":"stmt:sato2023b@pdftotext-pieces/l0008-01","stance":"asserts"}],"relations":[{"kind":"contradicts","claim":"claim:valency/adverbial-incorporation--adverbs-incorporate-freely","differs_in":"framework","note":"Satō rejects productive adverbial incorporation in Ainu, whereas Shibatani asserts that adverbs incorporate rather freely."},{"kind":"contrasts","claim":"claim:valency/adverbial-incorporation--adverbial-prefix-inventory","differs_in":"scope","note":"Satō views verbal adverbial prefixes as virtually limited to ar-, whereas Nakagawa lists a broader inventory of six prefixes."}],"grouped_by":"act:group/2026-09-26T07-52-28-143Z","status":"grouped"}
{"id":"claim:valency/adverbial-incorporation--adverbial-prefix-inventory","revision":1,"topic":"topic:valency/adverbial-incorporation","topics":["topic:valency/adverbial-incorporation"],"statement":{"en":"Verbal adverbial prefixes modifying verbs include ar-, oar-, ray-, ru-, sirko-, and toyko-, and have an arity of 0.","ja":"動詞を副詞的に修飾する接頭辞には ar-、oar-、ray-、ru-、sirko-、toyko- などがあり、アリティは 0 である。"},"type":"membership","scope":{"doculects":["doculect:hokkaido"],"quantifier":"all","modality":"asserted","conditions":[]},"forms":["ar-","oar-","ray-","ru-","sirko-","toyko-"],"statements":[{"id":"stmt:nakagawa2024@gemini-3-flash-preview/l0195-02","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-26T07-52-28-143Z","status":"grouped"}
{"id":"claim:valency/adverbial-incorporation--adverbial-noun-incorporation-uncommon","revision":1,"topic":"topic:valency/adverbial-incorporation","topics":["topic:valency/adverbial-incorporation"],"statement":{"en":"Noun incorporation in which a noun adverbially modifies a verb is not very common in Ainu.","ja":"名詞が副詞的に動詞を修飾するタイプの名詞抱合は、アイヌ語ではそれほど一般的ではない。"},"type":"frequency","scope":{"doculects":["doculect:hokkaido"],"quantifier":"all","modality":"asserted","conditions":[]},"forms":["tókap-mokor"],"statements":[{"id":"stmt:sato2008@gemini-3-flash-preview/l0238-02","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-26T07-52-28-143Z","status":"grouped"}
{"id":"claim:valency/adverbial-incorporation--adverbial-noun-incorporation-disallowed","revision":1,"topic":"topic:valency/adverbial-incorporation","topics":["topic:valency/adverbial-incorporation","topic:valency/adverbial-incorporation--overview"],"statement":{"en":"Ainu generally does not allow adverbial noun incorporation.","ja":"アイヌ語は一般に副詞的名詞抱合を許容しない。"},"type":"absence","scope":{"doculects":["doculect:ainu"],"quantifier":"all","modality":"asserted","conditions":[]},"forms":[],"statements":[{"id":"stmt:sato2016@pdftotext-pieces/l0007-01","stance":"asserts"}],"relations":[{"kind":"refines","claim":"claim:valency/adverbial-incorporation--adverbial-noun-incorporation-uncommon","differs_in":"level-of-analysis","note":"Satō 2016 categorically disallows adverbial noun incorporation, refining the earlier characterization that it is merely uncommon."}],"grouped_by":"act:group/2026-09-26T07-52-28-143Z","status":"grouped"}
{"id":"claim:valency/adverbial-incorporation--the-prefix-shir-can-refer-to-weather-and","revision":1,"topic":"topic:valency/adverbial-incorporation","topics":["topic:valency/adverbial-incorporation"],"statement":{"en":"The prefix shir- can refer to weather and climate, as in shir-pirka 'the weather is good' and shir-wen 'the weather is bad'.","ja":"接頭辞 shir- は「天候」「気候」を表し、shir-pirka「天気がよい」、shir-wen「天気が悪い」などの語を形成する。"},"type":"form-function","scope":{"doculects":["doculect:ainu"],"quantifier":"generic","modality":"actual","conditions":[]},"forms":["shir-","shir-pirka","shir-wen"],"statements":[{"id":"stmt:kindaichi1936@gemini-3-flash-preview/l0176-04","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-26T07-52-28-143Z","status":"grouped"}
{"id":"claim:valency/adverbial-incorporation--the-prefix-shir-can-refer-to-the-immediate","revision":1,"topic":"topic:valency/adverbial-incorporation","topics":["topic:valency/adverbial-incorporation"],"statement":{"en":"The prefix shir- can refer to the immediate space in front of one, as in shir-hutne 'the space is narrow'.","ja":"接頭辞 shir- は「目前の空間」を表し、shir-hutne「場所が狭い」などの語を形成する。"},"type":"form-function","scope":{"doculects":["doculect:ainu"],"quantifier":"generic","modality":"actual","conditions":[]},"forms":["shir-","shir-hutne"],"statements":[{"id":"stmt:kindaichi1936@gemini-3-flash-preview/l0176-06","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-26T07-52-28-143Z","status":"grouped"}
{"id":"claim:valency/adverbial-incorporation--the-prefix-shir-can-function-as-an-intensive","revision":1,"topic":"topic:valency/adverbial-incorporation","topics":["topic:valency/adverbial-incorporation"],"statement":{"en":"The prefix shir- can function as an intensive prefix with verbs, as in shir-kupa 'bite down hard' and shir-kuta 'dump out completely'.","ja":"接頭辞 shir- は動詞に付いて強意（intensive）を表し、shir-kupa「がぶりと噛みつく」や shir-kuta「ぶちまける」などを形成する。"},"type":"form-function","scope":{"doculects":["doculect:ainu"],"quantifier":"generic","modality":"actual","conditions":[]},"forms":["shir-","shir-kupa","shir-kuta","shir-oterke","shir-otke"],"statements":[{"id":"stmt:kindaichi1936@gemini-3-flash-preview/l0177-01","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-26T07-52-28-143Z","status":"grouped"}
{"id":"claim:valency/adverbial-incorporation--an-attributive-verb-may-cut-into-the-sequence","revision":1,"topic":"topic:valency/adverbial-incorporation","topics":["topic:valency/adverbial-incorporation"],"statement":{"en":"An attributive verb may cut into the sequence of a personal affix and the verb kor 'have' that indicates the possessive relationship with the head noun.","ja":"連体修飾動詞は、主要部名詞との所有関係を示す人称接辞と動詞 kor（所有する）の連続の間に割り込むことがある。"},"type":"ordering","scope":{"doculects":["doculect:ainu"],"quantifier":"generic","modality":"possible","conditions":[]},"forms":["kor"],"statements":[{"id":"stmt:shibatani1990@gemini-3-flash-preview/l0030-07","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-26T07-52-28-143Z","status":"grouped"}
{"id":"claim:valency/adverbial-incorporation--most-adverbs-can-be-incorporated-directly-into-the","revision":1,"topic":"topic:valency/adverbial-incorporation","topics":["topic:valency/adverbial-incorporation","topic:valency/adverbial-incorporation--overview"],"statement":{"en":"Most adverbs can be incorporated directly into the verb stem in their unchanged form.","ja":"大抵の副詞はそのまゝの形で動詞の語体に嵌入する。"},"type":"distribution","scope":{"doculects":["doculect:ainu"],"quantifier":"usually","modality":"actual","conditions":[]},"forms":[],"statements":[{"id":"stmt:kindaichi1936@gemini-3-flash-preview/l0213-03","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-26T07-52-28-143Z","status":"grouped"}
{"id":"claim:valency/adverbial-incorporation--the-suffix-kur-frequently-attaches-to-incorporated-adverbs","revision":1,"topic":"topic:valency/adverbial-incorporation","topics":["topic:valency/adverbial-incorporation","topic:valency/adverbial-incorporation--overview"],"statement":{"en":"The suffix -kur frequently attaches to incorporated adverbs as a meaningless expletive morpheme.","ja":"輯合した副詞にはよく -kur が付くが、この -kur は意味の無い虚辞である。"},"type":"form-function","scope":{"doculects":["doculect:ainu"],"quantifier":"usually","modality":"actual","conditions":["attached to incorporated adverbs"]},"forms":["-kur"],"statements":[{"id":"stmt:kindaichi1936@gemini-3-flash-preview/l0213-05","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-26T07-52-28-143Z","status":"grouped"}
{"id":"claim:valency/adverbial-incorporation--ainu-incorporates-adverbs-as-well-as-noun-modifying","revision":1,"topic":"topic:valency/adverbial-incorporation","topics":["topic:valency/adverbial-incorporation","topic:valency/adverbial-incorporation--overview"],"statement":{"en":"Ainu incorporates adverbs as well as noun-modifying verbs into the verb.","ja":"アイヌ語は名詞修飾動詞だけでなく副詞も動詞に抱合する。"},"type":"existence","scope":{"doculects":["doculect:ainu"],"quantifier":"generic","modality":"actual","conditions":[]},"forms":[],"statements":[{"id":"stmt:shibatani1990@gemini-3-flash-preview/l0040-03","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-26T07-52-28-143Z","status":"grouped"}
{"id":"claim:valency/adverbial-incorporation--the-1-place-verb-tunas-fast-early-can","revision":1,"topic":"topic:valency/adverbial-incorporation","topics":["topic:valency/adverbial-incorporation","topic:valency/adverbial-incorporation--property-verb"],"statement":{"en":"The 1-place verb tunas 'fast, early' can be used directly as an adverb without any suffix (e.g. tunas a=e 'I eat quickly').","ja":"1項動詞 tunas「早い」は、tunas a=e「さっさと私は食べる」のように、接辞をつけずそのままで副詞として用いられる。"},"type":"distribution","scope":{"doculects":["doculect:ainu"],"quantifier":"unstated","modality":"actual","conditions":[]},"forms":["tunas"],"statements":[{"id":"stmt:nakagawa2024@gemini-3-flash-preview/l0488-02","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-26T07-52-28-143Z","status":"grouped"}

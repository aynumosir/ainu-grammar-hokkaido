{"id":"claim:sources/aims-scope-design-philosophy--nakagawa-grammar-saru-chitose-focus","revision":1,"topic":"topic:sources/aims-scope-design-philosophy","topics":["topic:sources/aims-scope-design-philosophy","topic:sources/aims-scope-design-philosophy--hokkaido-focus"],"statement":{"en":"Nakagawa's grammar is primarily based on the Saru dialect and frequently cites examples from the closely related Chitose dialect.","ja":"中川の文法書は沙流方言を基盤とし、近縁の千歳方言の用例も頻繁に引用している。"},"type":"other","scope":{"doculects":["doculect:hokkaido/southwest/saru","doculect:hokkaido/chitose"],"quantifier":"all","modality":"actual","conditions":[]},"forms":[],"statements":[{"id":"stmt:nakagawa2024@gemini-3-flash-preview/l0015-01","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-06-38-590Z","status":"grouped"}
{"id":"claim:sources/aims-scope-design-philosophy--nakagawa-grammar-dialect-coverage","revision":1,"topic":"topic:sources/aims-scope-design-philosophy","topics":["topic:sources/aims-scope-design-philosophy","topic:sources/aims-scope-design-philosophy--hokkaido-focus"],"statement":{"en":"In addition to the Saru and Chitose dialects, Nakagawa's grammar primarily covers the Horobetsu, Shizunai, Ishikari (Asahikawa), Tokachi, and Shiranuka dialects.","ja":"沙流・千歳方言に加えて、中川の文法書は幌別・静内・石狩（旭川）・十勝・白糠の各方言をおもにとり上げている。"},"type":"other","scope":{"doculects":["doculect:hokkaido/southwest/saru","doculect:hokkaido/chitose","doculect:hokkaido/southwest/horobetsu","doculect:hokkaido/southwest/shizunai","doculect:hokkaido/central/ishikari","doculect:hokkaido/central/asahikawa","doculect:hokkaido/central/tokachi","doculect:hokkaido/northeast/kushiro"],"quantifier":"all","modality":"actual","conditions":[]},"forms":[],"statements":[{"id":"stmt:nakagawa2024@gemini-3-flash-preview/l0015-02","stance":"asserts"}],"relations":[{"kind":"refines","claim":"claim:sources/aims-scope-design-philosophy--nakagawa-grammar-saru-chitose-focus","differs_in":null,"note":"Broadens the dialect coverage of Nakagawa (2024) beyond its primary Saru and Chitose focus."}],"grouped_by":"act:group/2026-09-10T15-06-38-590Z","status":"grouped"}
{"id":"claim:sources/aims-scope-design-philosophy--ainu-dialect-variation-generalizability","revision":1,"topic":"topic:sources/aims-scope-design-philosophy","topics":["topic:sources/aims-scope-design-philosophy","topic:sources/aims-scope-design-philosophy--hokkaido-focus"],"statement":{"en":"Ainu exhibits dialect differences such that what is described for one dialect does not necessarily apply to all dialects.","ja":"アイヌ語には方言差が存在し、ある方言についての記述が必ずしもすべての方言に当てはまるわけではない。"},"type":"variation","scope":{"doculects":["doculect:ainu"],"quantifier":"exists","modality":"actual","conditions":[]},"forms":[],"statements":[{"id":"stmt:sato2008@gemini-3-flash-preview/l0002-01","stance":"asserts"}],"relations":[{"kind":"contrasts","claim":"claim:sources/aims-scope-design-philosophy--ainu-basic-grammar-dialect-uniformity","differs_in":"level-of-analysis","note":"Satō notes that specific descriptions cannot be generalized indiscriminately across dialects, while observing that basic grammatical structures remain largely consistent."}],"grouped_by":"act:group/2026-09-10T15-06-38-590Z","status":"grouped"}
{"id":"claim:sources/aims-scope-design-philosophy--sato-grammar-chitose-scope-convention","revision":1,"topic":"topic:sources/aims-scope-design-philosophy","topics":["topic:sources/aims-scope-design-philosophy","topic:sources/aims-scope-design-philosophy--hokkaido-focus"],"statement":{"en":"Unless specifically noted otherwise, references to 'Ainu' in Satō (2008) are restricted to the Chitose dialect.","ja":"佐藤（2008）において「アイヌ語」と述べる場合、特段の断りがない限り千歳方言に限定されている。"},"type":"terminology","scope":{"doculects":["doculect:hokkaido/chitose"],"quantifier":"all","modality":"actual","conditions":[]},"forms":[],"statements":[{"id":"stmt:sato2008@gemini-3-flash-preview/l0002-02","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-06-38-590Z","status":"grouped"}
{"id":"claim:sources/aims-scope-design-philosophy--ainu-basic-grammar-dialect-uniformity","revision":1,"topic":"topic:sources/aims-scope-design-philosophy","topics":["topic:sources/aims-scope-design-philosophy","topic:sources/aims-scope-design-philosophy--hokkaido-focus"],"statement":{"en":"The basic grammatical points of Ainu do not differ substantially across dialects.","ja":"アイヌ語の文法における基本的な点は方言によってそれほど大きく異ならない。"},"type":"variation","scope":{"doculects":["doculect:ainu"],"quantifier":"most","modality":"actual","conditions":[]},"forms":[],"statements":[{"id":"stmt:sato2008@gemini-3-flash-preview/l0002-03","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-06-38-590Z","status":"grouped"}

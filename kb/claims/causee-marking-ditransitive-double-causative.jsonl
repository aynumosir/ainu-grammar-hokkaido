{"id":"claim:valency/causee-marking-ditransitive-double-causative--s-to-o-promotion-intransitive-causative","revision":1,"topic":"topic:valency/causee-marking-ditransitive-double-causative","topics":["topic:valency/causee-marking-ditransitive-double-causative","topic:valency/causee-marking-ditransitive-double-causative--causee-as-object"],"statement":{"en":"Causative verbs derived from intransitives with -V, -ka, or -ke promote the original S argument to O while introducing a new subject argument A.","ja":"-V、-ka、-ke により自動詞から派生した使役動詞は、元の S 項を O に昇格させ、同時に新しい主語項 A を導入する。"},"type":"form-function","scope":{"doculects":["doculect:hokkaido/southwest/saru"],"quantifier":"all","modality":"assertive","conditions":["intransitive verb base with -V, -ka, or -ke"]},"forms":["-V","-ka","-ke"],"statements":[{"id":"stmt:bugaeva2014@pdftotext-pieces/l0003-03","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-26T07-52-28-143Z","status":"grouped"}
{"id":"claim:valency/causee-marking-ditransitive-double-causative--direct-vs-indirect-causee-incorporation","revision":1,"topic":"topic:valency/causee-marking-ditransitive-double-causative","topics":["topic:valency/causee-marking-ditransitive-double-causative","topic:valency/causee-marking-ditransitive-double-causative--combinatorial-limits"],"statement":{"en":"Direct causee objects can undergo noun incorporation and antipassivization, whereas indirect causee objects cannot.","ja":"直接使役の被使役者目的語は名詞抱合や逆受動態化を受けることができるが、間接使役の被使役者目的語は受けることができない。"},"type":"distribution","scope":{"doculects":["doculect:ainu"],"quantifier":"all","modality":"assertive","conditions":[]},"forms":["i-"],"statements":[{"id":"stmt:bugaevakobayashi2022@handbook-epub/l0100-11","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-26T07-52-28-143Z","status":"grouped"}
{"id":"claim:valency/causee-marking-ditransitive-double-causative--transitive-causative-two-unmarked-objects","revision":1,"topic":"topic:valency/causee-marking-ditransitive-double-causative","topics":["topic:valency/causee-marking-ditransitive-double-causative","topic:valency/causee-marking-ditransitive-double-causative--double-causative"],"statement":{"en":"Double causatives and causatives formed from bivalent transitives take two unmarked objects that share similar encoding and behavioral properties.","ja":"二重使役および2価他動詞から形成された使役形は、符号化や統語的振る舞いにおいてほぼ同様の2つの無標識目的語をとる。"},"type":"distribution","scope":{"doculects":["doculect:hokkaido/southwest"],"quantifier":"all","modality":"assertive","conditions":["derived from bivalent transitive or double causative"]},"forms":[],"statements":[{"id":"stmt:bugaeva2012@gemini-3-flash-preview/l0015-01","stance":"asserts"}],"relations":[{"kind":"supports","claim":"claim:valency/causee-marking-ditransitive-double-causative--transitive-causative-double-object-construction","differs_in":null,"note":"Affirms that causativized transitives take two unmarked objects like trivalent applicatives."}],"grouped_by":"act:group/2026-09-26T07-52-28-143Z","status":"grouped"}
{"id":"claim:valency/causee-marking-ditransitive-double-causative--secondary-causative-suffixation","revision":1,"topic":"topic:valency/causee-marking-ditransitive-double-causative","topics":["topic:valency/causee-marking-ditransitive-double-causative","topic:valency/causee-marking-ditransitive-double-causative--double-causative"],"statement":{"en":"The suffix -re/-e/-te can attach to all direct causative verbs to function as a secondary indirect causative marker.","ja":"接尾辞 -re/-e/-te は、直接使役を表すすべての動詞に付加して二次的（間接）使役標識として機能することができる。"},"type":"distribution","scope":{"doculects":["doculect:ainu"],"quantifier":"all","modality":"assertive","conditions":["direct causative verb base"]},"forms":["-re","-e","-te"],"statements":[{"id":"stmt:bugaeva2014@pdftotext-pieces/l0005-08","stance":"asserts"}],"relations":[{"kind":"refines","claim":"claim:valency/causee-marking-ditransitive-double-causative--double-causatives-exist","differs_in":"scope","note":"Specifies the morphology (-re/-e/-te) and role of the secondary causative marker that derives double causatives."}],"grouped_by":"act:group/2026-09-26T07-52-28-143Z","status":"grouped"}
{"id":"claim:valency/causee-marking-ditransitive-double-causative--double-causative-object-omission","revision":1,"topic":"topic:valency/causee-marking-ditransitive-double-causative","topics":["topic:valency/causee-marking-ditransitive-double-causative","topic:valency/causee-marking-ditransitive-double-causative--double-causative"],"statement":{"en":"In double causatives, two overt objects never appear simultaneously in actual clauses due to the omission of topical noun phrases and avoidance of co-occurring pronouns.","ja":"二重使役構文において、話題の名詞句の省略や代名詞の共起回避により、実際の節中で2つの目的語が同時に現れることはない。"},"type":"distribution","scope":{"doculects":["doculect:ainu"],"quantifier":"all","modality":"assertive","conditions":["in actual clauses"]},"forms":[],"statements":[{"id":"stmt:bugaeva2014@pdftotext-pieces/l0010-02","stance":"asserts"}],"relations":[{"kind":"refines","claim":"claim:valency/causee-marking-ditransitive-double-causative--transitive-causative-object-cooccurrence-avoidance","differs_in":"scope","note":"Refines the general avoidance of overt co-occurring objects to double causatives specifically."}],"grouped_by":"act:group/2026-09-26T07-52-28-143Z","status":"grouped"}
{"id":"claim:valency/causee-marking-ditransitive-double-causative--double-causatives-exist","revision":1,"topic":"topic:valency/causee-marking-ditransitive-double-causative","topics":["topic:valency/causee-marking-ditransitive-double-causative","topic:valency/causee-marking-ditransitive-double-causative--double-causative"],"statement":{"en":"Ainu permits double causatives, formed by adding a causative suffix to an already causativized transitive verb stem.","ja":"アイヌ語には、既使役化された他動詞語幹に更なる使役接尾辞を付加する二重使役が存在する。"},"type":"existence","scope":{"doculects":["doculect:ainu"],"quantifier":"exists","modality":"assertive","conditions":[]},"forms":["-re"],"statements":[{"id":"stmt:bugaevakobayashi2022@handbook-epub/l0100-10","stance":"asserts"},{"id":"stmt:bugaevakobayashi2022@handbook-epub/l0102-06","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-26T07-52-28-143Z","status":"grouped"}
{"id":"claim:valency/causee-marking-ditransitive-double-causative--iyomare-an-form-function","revision":1,"topic":"topic:valency/causee-marking-ditransitive-double-causative","topics":["topic:valency/causee-marking-ditransitive-double-causative","topic:valency/causee-marking-ditransitive-double-causative--double-causative"],"statement":{"en":"The form iyomare-an expresses the meaning 'we pour liquor for someone'.","ja":"iyomare-an という形式は「私たちが誰かのために酒を注ぐ」という意味を表す。"},"type":"form-function","scope":{"doculects":["doculect:ainu"],"quantifier":"all","modality":"assertive","conditions":[]},"forms":["iyomare-an"],"statements":[{"id":"stmt:sato2023b@pdftotext-pieces/l0019-04","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-26T07-52-28-143Z","status":"grouped"}
{"id":"claim:valency/causee-marking-ditransitive-double-causative--giving-receiving-portmanteau-affixes","revision":1,"topic":"topic:valency/causee-marking-ditransitive-double-causative","topics":["topic:valency/causee-marking-ditransitive-double-causative","topic:valency/causee-marking-ditransitive-double-causative--person-indexing"],"statement":{"en":"Verbs of giving and receiving express their arguments by combining portmanteau personal affixes with three-argument verb stems such as konte 'give' or koore 'hand over'.","ja":"授受動詞は konte「与える」や koore「手渡す」のような3項動詞語幹に抱合人称接辞を接続して項を表現する。"},"type":"form-function","scope":{"doculects":["doculect:sakhalin"],"quantifier":"all","modality":"assertive","conditions":[]},"forms":["konte","koore"],"statements":[{"id":"stmt:murasaki2025@gemini-3-flash-preview/l0036-01","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-26T07-52-28-143Z","status":"grouped"}
{"id":"claim:valency/causee-marking-ditransitive-double-causative--chitose-kore-theme-pragmatic-implicature","revision":1,"topic":"topic:valency/causee-marking-ditransitive-double-causative","topics":["topic:valency/causee-marking-ditransitive-double-causative","topic:valency/causee-marking-ditransitive-double-causative--person-indexing"],"statement":{"en":"When kore 'give' occurs without a person affix for the theme argument, the theme interpretation is recovered pragmatically via the verb's trivalent frame.","ja":"動詞 kore「与える」が主題に相当する人称接辞を取らない場合でも、動詞が3個の項スロットを持つことにより語用論的含意によって主題が解釈される。"},"type":"analysis","scope":{"doculects":["doculect:hokkaido/chitose"],"quantifier":"all","modality":"assertive","conditions":[]},"forms":["kore","topenpe"],"statements":[{"id":"stmt:sato2023b@pdftotext-pieces/l0006-01","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-26T07-52-28-143Z","status":"grouped"}
{"id":"claim:valency/causee-marking-ditransitive-double-causative--kore-recipient-indexing-priority","revision":1,"topic":"topic:valency/causee-marking-ditransitive-double-causative","topics":["topic:valency/causee-marking-ditransitive-double-causative","topic:valency/causee-marking-ditransitive-double-causative--person-indexing"],"statement":{"en":"On the three-argument verb kore 'give', only the recipient is indexed by object personal affixes, and the theme normally cannot be indexed.","ja":"3項動詞 kore「与える」において、目的語として表示される人称は受領者のみであり、通常は主題の人称を表示できない。"},"type":"distribution","scope":{"doculects":["doculect:ainu"],"quantifier":"all","modality":"assertive","conditions":[]},"forms":["kore"],"statements":[{"id":"stmt:sato2023b@pdftotext-pieces/l0008-02","stance":"asserts"}],"relations":[{"kind":"contrasts","claim":"claim:valency/causee-marking-ditransitive-double-causative--omare-theme-indexing","differs_in":null,"note":"Contrasts which semantic role is privileged for person indexing among three-argument verbs (recipient with kore vs theme with omare)."}],"grouped_by":"act:group/2026-09-26T07-52-28-143Z","status":"grouped"}
{"id":"claim:valency/causee-marking-ditransitive-double-causative--omare-theme-indexing","revision":1,"topic":"topic:valency/causee-marking-ditransitive-double-causative","topics":["topic:valency/causee-marking-ditransitive-double-causative","topic:valency/causee-marking-ditransitive-double-causative--person-indexing"],"statement":{"en":"On the three-argument verb omare 'put into', only the moved theme is indexed by object personal affixes, and the locative goal cannot be indexed.","ja":"3項動詞 omare「入れる」において、動詞に表示される目的語の人称は移動する主題であり、移動先の場所を人称表示することはできない。"},"type":"distribution","scope":{"doculects":["doculect:ainu"],"quantifier":"all","modality":"assertive","conditions":[]},"forms":["omare"],"statements":[{"id":"stmt:sato2023b@pdftotext-pieces/l0008-03","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-26T07-52-28-143Z","status":"grouped"}
{"id":"claim:valency/causee-marking-ditransitive-double-causative--v-ka-transitive-double-object","revision":1,"topic":"topic:valency/causee-marking-ditransitive-double-causative","topics":["topic:valency/causee-marking-ditransitive-double-causative","topic:valency/causee-marking-ditransitive-double-causative--three-place-frame"],"statement":{"en":"In causativization of transitive verbs with -V or -ka, the original object is retained and the original subject becomes a causee object, forming a double-object construction.","ja":"-V および -ka による他動詞の使役化では、元の目的語が保持されたまま元の主語が被使役者目的語となり、二重目的語構造を形成する。"},"type":"form-function","scope":{"doculects":["doculect:ainu"],"quantifier":"all","modality":"assertive","conditions":["transitive verb base with -V or -ka"]},"forms":["-V","-ka"],"statements":[{"id":"stmt:bugaeva2014@pdftotext-pieces/l0005-02","stance":"asserts"}],"relations":[{"kind":"refines","claim":"claim:valency/causee-marking-ditransitive-double-causative--transitive-causative-double-object-construction","differs_in":"scope","note":"Specifies the morphological markers (-V, -ka) and precise syntactic argument mapping for transitives forming double-object constructions."}],"grouped_by":"act:group/2026-09-26T07-52-28-143Z","status":"grouped"}
{"id":"claim:valency/causee-marking-ditransitive-double-causative--transitive-causative-object-cooccurrence-avoidance","revision":1,"topic":"topic:valency/causee-marking-ditransitive-double-causative","topics":["topic:valency/causee-marking-ditransitive-double-causative","topic:valency/causee-marking-ditransitive-double-causative--three-place-frame"],"statement":{"en":"Although causativization of transitive verbs creates double-object constructions, overt expression of both objects simultaneously is avoided, with one typically omitted coreferentially.","ja":"他動詞の使役化は二重目的語構文を作り出すが、両方の目的語を明示的に言い表すことは避けられ、通常いずれか一方が同一指示的に省略される。"},"type":"distribution","scope":{"doculects":["doculect:hokkaido/southwest"],"quantifier":"all","modality":"assertive","conditions":[]},"forms":[],"statements":[{"id":"stmt:bugaeva2014@pdftotext-pieces/l0011-03","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-26T07-52-28-143Z","status":"grouped"}
{"id":"claim:valency/causee-marking-ditransitive-double-causative--transitive-causative-double-object-construction","revision":1,"topic":"topic:valency/causee-marking-ditransitive-double-causative","topics":["topic:valency/causee-marking-ditransitive-double-causative","topic:valency/causee-marking-ditransitive-double-causative--three-place-frame"],"statement":{"en":"Causativization of transitive (two-argument) verbs yields a double-object construction in Ainu.","ja":"アイヌ語において、他動詞（2項動詞）の使役化は二重目的語構文を形成する。"},"type":"form-function","scope":{"doculects":["doculect:ainu"],"quantifier":"all","modality":"assertive","conditions":["transitive base verb"]},"forms":["-re","-e","-te"],"statements":[{"id":"stmt:bugaevakobayashi2022@handbook-epub/l0100-09","stance":"asserts"},{"id":"stmt:bugaevakobayashi2022@handbook-epub/l0102-05","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-26T07-52-28-143Z","status":"grouped"}

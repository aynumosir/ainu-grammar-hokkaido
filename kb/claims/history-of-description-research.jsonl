{"id":"claim:sources/history-of-description-research--murasaki-1967-classifies-ainu-verbs-into-intransitive-v0","revision":1,"topic":"topic:sources/history-of-description-research","topics":["topic:sources/history-of-description-research","topic:sources/history-of-description-research--modern-era"],"statement":{"en":"Murasaki (1967) classifies Ainu verbs into intransitive (V0), transitive (V1), and ditransitive (V2).","ja":"村崎（1967）はアイヌ語の動詞を自動詞（V0）、他動詞（V1）、および複他動詞（V2）に分類している。"},"type":"analysis","scope":{"doculects":["doculect:ainu"],"quantifier":"all","modality":"actual","conditions":[]},"forms":[],"statements":[{"id":"stmt:sato2025a@pdftotext-pieces/l0004-01","stance":"reports"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-06-38-590Z","status":"grouped"}
{"id":"claim:sources/history-of-description-research--murasaki-1967-accounts-for-the-inflection-of-ainu","revision":1,"topic":"topic:sources/history-of-description-research","topics":["topic:sources/history-of-description-research","topic:sources/history-of-description-research--modern-era"],"statement":{"en":"Murasaki (1967) accounts for the inflection of Ainu verbs and nouns by transformational rules of deletion, replacement, and movement.","ja":"村崎（1967）は要素の削除・置換・移動に基づく変形規則によって動詞と名詞の語形変化を処理している。"},"type":"analysis","scope":{"doculects":["doculect:ainu"],"quantifier":"all","modality":"actual","conditions":[]},"forms":[],"statements":[{"id":"stmt:sato2025a@pdftotext-pieces/l0004-02","stance":"reports"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-06-38-590Z","status":"grouped"}

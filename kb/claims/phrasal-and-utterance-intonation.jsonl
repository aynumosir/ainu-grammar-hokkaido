{"id":"claim:prosody/phrasal-and-utterance-intonation--sato-imperative-lengthened-emphasis","revision":1,"topic":"topic:prosody/phrasal-and-utterance-intonation","topics":["topic:prosody/phrasal-and-utterance-intonation"],"statement":{"en":"In imperative sentences, the sentence-final portion tends to be pronounced longer and more emphatically than in declarative sentences.","ja":"命令文では平叙文よりも文末がやや長く強めに発音される傾向がある。"},"type":"form-function","scope":{"doculects":["doculect:ainu"],"quantifier":"tends","modality":"neutral","conditions":[]},"forms":[],"statements":[{"id":"stmt:sato2008@gemini-3-flash-preview/l0040-05","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-06-38-590Z","status":"grouped"}
{"id":"claim:prosody/phrasal-and-utterance-intonation--sakhalin-declarative-rising-interrogative-falling","revision":1,"topic":"topic:prosody/phrasal-and-utterance-intonation","topics":["topic:prosody/phrasal-and-utterance-intonation","topic:prosody/phrasal-and-utterance-intonation--declarative"],"statement":{"en":"In Sakhalin Ainu, declarative sentences are generally pronounced with rising intonation, whereas interrogative sentences are pronounced with falling intonation.","ja":"樺太アイヌ語の一般的な発話では叙述文が上がり音調で、疑問文が下がり音調で発話される。"},"type":"form-function","scope":{"doculects":["doculect:sakhalin"],"quantifier":"generally","modality":"neutral","conditions":[]},"forms":[],"statements":[{"id":"stmt:murasaki2025@gemini-3-flash-preview/l0091-06","stance":"asserts"}],"relations":[{"kind":"contrasts","claim":"claim:prosody/phrasal-and-utterance-intonation--shizunai-interrogative-rising-intonation","differs_in":"dialect","note":"Questions have falling intonation in Sakhalin Ainu but rising intonation in Shizunai."},{"kind":"contrasts","claim":"claim:prosody/phrasal-and-utterance-intonation--shizunai-declarative-falling-intonation","differs_in":"dialect","note":"Declaratives have rising intonation in Sakhalin Ainu but falling intonation in Shizunai."}],"grouped_by":"act:group/2026-09-10T15-06-38-590Z","status":"grouped"}
{"id":"claim:prosody/phrasal-and-utterance-intonation--ainu-affirmative-slight-final-rise","revision":1,"topic":"topic:prosody/phrasal-and-utterance-intonation","topics":["topic:prosody/phrasal-and-utterance-intonation","topic:prosody/phrasal-and-utterance-intonation--declarative"],"statement":{"en":"In affirmative sentences, sentence-final intonation tends to rise slightly, though not as high as in interrogative sentences.","ja":"肯定文では文末のイントネーションがやや上がり気味になる傾向があるが、疑問文ほどは上昇しない。"},"type":"other","scope":{"doculects":["doculect:ainu"],"quantifier":"tends","modality":"neutral","conditions":[]},"forms":[],"statements":[{"id":"stmt:nakagawa2024@gemini-3-flash-preview/l0403-01","stance":"asserts"}],"relations":[{"kind":"contrasts","claim":"claim:prosody/phrasal-and-utterance-intonation--shizunai-declarative-falling-intonation","differs_in":"dialect","note":"Nakagawa reports slight terminal rising in affirmative sentences across Ainu, whereas Refsing reports slightly falling declarative intonation in Shizunai."}],"grouped_by":"act:group/2026-09-10T15-06-38-590Z","status":"grouped"}
{"id":"claim:prosody/phrasal-and-utterance-intonation--shizunai-declarative-falling-intonation","revision":1,"topic":"topic:prosody/phrasal-and-utterance-intonation","topics":["topic:prosody/phrasal-and-utterance-intonation","topic:prosody/phrasal-and-utterance-intonation--declarative"],"statement":{"en":"In the Shizunai dialect, sentence intonation is slightly falling in declarative sentences.","ja":"静内方言において、平叙文の文イントネーションはわずかに下降する。"},"type":"form-function","scope":{"doculects":["doculect:hokkaido/southwest/shizunai"],"quantifier":"always","modality":"neutral","conditions":[]},"forms":[],"statements":[{"id":"stmt:refsing1986@gemini-3-flash-preview/l0068-02","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-06-38-590Z","status":"grouped"}
{"id":"claim:prosody/phrasal-and-utterance-intonation--saru-declarative-natural-pitch-decline","revision":1,"topic":"topic:prosody/phrasal-and-utterance-intonation","topics":["topic:prosody/phrasal-and-utterance-intonation","topic:prosody/phrasal-and-utterance-intonation--declarative"],"statement":{"en":"In ordinary declarative speech in the Saru dialect, pitch exhibits a natural decline without a final rise or fall at the end of the sentence.","ja":"沙流方言の通常の平叙発話では、文末の上昇や下降を伴わず自然にピッチが下降する。"},"type":"distribution","scope":{"doculects":["doculect:hokkaido/southwest/saru"],"quantifier":"always","modality":"neutral","conditions":["ordinary declarative speech"]},"forms":[],"statements":[{"id":"stmt:shiraishi2022@handbook-epub/l0088-01","stance":"reports"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-06-38-590Z","status":"grouped"}
{"id":"claim:prosody/phrasal-and-utterance-intonation--saru-rising-contour-reaction-expectation","revision":1,"topic":"topic:prosody/phrasal-and-utterance-intonation","topics":["topic:prosody/phrasal-and-utterance-intonation","topic:prosody/phrasal-and-utterance-intonation--declarative"],"statement":{"en":"In the Saru dialect, a rising intonation contour appears when the speaker expects a reaction from the interlocutor.","ja":"沙流方言では、聞き手からの反応を期待する場合に上昇イントネーションが現れる。"},"type":"form-function","scope":{"doculects":["doculect:hokkaido/southwest/saru"],"quantifier":"always","modality":"neutral","conditions":["speaker expects interlocutor reaction"]},"forms":[],"statements":[{"id":"stmt:shiraishi2022@handbook-epub/l0088-02","stance":"reports"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-06-38-590Z","status":"grouped"}
{"id":"claim:prosody/phrasal-and-utterance-intonation--tokachi-interrogative-non-rising-conditions","revision":1,"topic":"topic:prosody/phrasal-and-utterance-intonation","topics":["topic:prosody/phrasal-and-utterance-intonation","topic:prosody/phrasal-and-utterance-intonation--dialect-split"],"statement":{"en":"In the Tokachi dialect, a non-rising intonation contour occurs in interrogatives lacking a final predicate verb when ending in a noun, nominalizer, or conjunctive particle followed by an interrogative particle.","ja":"十勝方言では、文末述語動詞を欠き名詞・形式名詞または接続小詞＋疑問小詞で終わる疑問文において非上昇イントネーションが生じる。"},"type":"distribution","scope":{"doculects":["doculect:hokkaido/central/tokachi"],"quantifier":"always","modality":"neutral","conditions":["sentence lacks final predicate verb and ends in noun, nominalizer, or conjunctive plus interrogative particle"]},"forms":[],"statements":[{"id":"stmt:shiraishi2022@handbook-epub/l0088-08","stance":"reports"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-06-38-590Z","status":"grouped"}
{"id":"claim:prosody/phrasal-and-utterance-intonation--sakhalin-surprise-falling-intonation","revision":1,"topic":"topic:prosody/phrasal-and-utterance-intonation","topics":["topic:prosody/phrasal-and-utterance-intonation","topic:prosody/phrasal-and-utterance-intonation--exclamatory"],"statement":{"en":"In Sakhalin Ainu, utterances expressing surprise are typically spoken with falling intonation.","ja":"樺太アイヌ語において驚きを表現する発話では下がり音調が典型的である。"},"type":"form-function","scope":{"doculects":["doculect:sakhalin"],"quantifier":"typically","modality":"neutral","conditions":["expressing surprise"]},"forms":[],"statements":[{"id":"stmt:murasaki2025@gemini-3-flash-preview/l0091-07","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-06-38-590Z","status":"grouped"}
{"id":"claim:prosody/phrasal-and-utterance-intonation--saru-exclamation-wish-rising-falling-contour","revision":1,"topic":"topic:prosody/phrasal-and-utterance-intonation","topics":["topic:prosody/phrasal-and-utterance-intonation","topic:prosody/phrasal-and-utterance-intonation--exclamatory"],"statement":{"en":"In the Saru dialect, expressing exclamation or wish raises the pitch of the whole utterance and produces a lengthened rising-falling contour at the end of the sentence.","ja":"沙流方言では感嘆や願望を表す際に発話全体のピッチが高くなり、文末に長引く上昇下降の音調が現れる。"},"type":"form-function","scope":{"doculects":["doculect:hokkaido/southwest/saru"],"quantifier":"always","modality":"neutral","conditions":["expressing exclamation or wish"]},"forms":[],"statements":[{"id":"stmt:shiraishi2022@handbook-epub/l0088-03","stance":"reports"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-06-38-590Z","status":"grouped"}
{"id":"claim:prosody/phrasal-and-utterance-intonation--sakhalin-hvv-falling-question-rising-non-question","revision":1,"topic":"topic:prosody/phrasal-and-utterance-intonation","topics":["topic:prosody/phrasal-and-utterance-intonation","topic:prosody/phrasal-and-utterance-intonation--interrogative"],"statement":{"en":"In Sakhalin Ainu, sentences ending in the final particle hVV take falling intonation in questions and rising intonation in non-questions.","ja":"樺太アイヌ語において終助詞 hVV を伴う文は、疑問文で下がりイントネーション、非疑問文で上がりイントネーションをとる。"},"type":"form-function","scope":{"doculects":["doculect:sakhalin"],"quantifier":"always","modality":"neutral","conditions":["sentence ends in final particle hVV"]},"forms":["hVV"],"statements":[{"id":"stmt:murasaki2025@gemini-3-flash-preview/l0027-04","stance":"asserts"}],"relations":[{"kind":"refines","claim":"claim:prosody/phrasal-and-utterance-intonation--sakhalin-declarative-rising-interrogative-falling","differs_in":"scope","note":"Applies the Sakhalin pattern of rising non-questions and falling questions specifically to sentences with the final particle hVV."}],"grouped_by":"act:group/2026-09-10T15-06-38-590Z","status":"grouped"}
{"id":"claim:prosody/phrasal-and-utterance-intonation--shizunai-interrogative-rising-intonation","revision":1,"topic":"topic:prosody/phrasal-and-utterance-intonation","topics":["topic:prosody/phrasal-and-utterance-intonation","topic:prosody/phrasal-and-utterance-intonation--interrogative"],"statement":{"en":"In the Shizunai dialect, sentence intonation rises gradually in questions.","ja":"静内方言において、疑問文の文イントネーションは次第に上昇する。"},"type":"form-function","scope":{"doculects":["doculect:hokkaido/southwest/shizunai"],"quantifier":"always","modality":"neutral","conditions":[]},"forms":[],"statements":[{"id":"stmt:refsing1986@gemini-3-flash-preview/l0068-03","stance":"asserts"}],"relations":[{"kind":"contrasts","claim":"claim:prosody/phrasal-and-utterance-intonation--saru-interrogative-non-rising-contour-attested","differs_in":"dialect","note":"Shizunai questions exhibit rising intonation, while Saru attests interrogatives without final rise."}],"grouped_by":"act:group/2026-09-10T15-06-38-590Z","status":"grouped"}
{"id":"claim:prosody/phrasal-and-utterance-intonation--shizunai-particles-diminish-intonation-importance","revision":1,"topic":"topic:prosody/phrasal-and-utterance-intonation","topics":["topic:prosody/phrasal-and-utterance-intonation","topic:prosody/phrasal-and-utterance-intonation--interrogative"],"statement":{"en":"In the Shizunai dialect, the use of sentence-final particles and forms greatly diminishes the importance of intonation.","ja":"静内方言において、文末小詞や文末形式の使用によりイントネーションの重要性は大幅に減少している。"},"type":"distribution","scope":{"doculects":["doculect:hokkaido/southwest/shizunai"],"quantifier":"always","modality":"neutral","conditions":[]},"forms":[],"statements":[{"id":"stmt:refsing1986@gemini-3-flash-preview/l0068-04","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-06-38-590Z","status":"grouped"}
{"id":"claim:prosody/phrasal-and-utterance-intonation--saru-interrogative-pitch-peak-final-particle","revision":1,"topic":"topic:prosody/phrasal-and-utterance-intonation","topics":["topic:prosody/phrasal-and-utterance-intonation","topic:prosody/phrasal-and-utterance-intonation--interrogative"],"statement":{"en":"In the Saru dialect, interrogative pitch movement and intensity peaks occur primarily on sentence-final interrogative particles.","ja":"沙流方言の疑問文では、ピッチ変動と強度のピークが主に文末の疑問小詞に現れる。"},"type":"distribution","scope":{"doculects":["doculect:hokkaido/southwest/saru"],"quantifier":"mostly","modality":"neutral","conditions":[]},"forms":["hawe","ya","a","he"],"statements":[{"id":"stmt:shiraishi2022@handbook-epub/l0088-04","stance":"reports"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-06-38-590Z","status":"grouped"}
{"id":"claim:prosody/phrasal-and-utterance-intonation--saru-interrogative-non-rising-contour-attested","revision":1,"topic":"topic:prosody/phrasal-and-utterance-intonation","topics":["topic:prosody/phrasal-and-utterance-intonation","topic:prosody/phrasal-and-utterance-intonation--interrogative"],"statement":{"en":"In the Saru dialect, interrogative sentences without a final rising pitch contour are attested.","ja":"沙流方言において、文末上昇音調を伴わない疑問文の存在が確認されている。"},"type":"existence","scope":{"doculects":["doculect:hokkaido/southwest/saru"],"quantifier":"exists","modality":"neutral","conditions":[]},"forms":[],"statements":[{"id":"stmt:shiraishi2022@handbook-epub/l0088-05","stance":"reports"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-06-38-590Z","status":"grouped"}
{"id":"claim:prosody/phrasal-and-utterance-intonation--saru-nankora-falling-intonation","revision":1,"topic":"topic:prosody/phrasal-and-utterance-intonation","topics":["topic:prosody/phrasal-and-utterance-intonation","topic:prosody/phrasal-and-utterance-intonation--interrogative"],"statement":{"en":"In acoustic data of the Saru dialect, interrogative sentences ending in nankora are uttered with a falling intonation contour.","ja":"沙流方言の音声データにおいて、nankora で終わる文は下降イントネーションで発話される。"},"type":"distribution","scope":{"doculects":["doculect:hokkaido/southwest/saru"],"quantifier":"always","modality":"neutral","conditions":["sentence ends in nankora"]},"forms":["nankora"],"statements":[{"id":"stmt:shiraishi2022@handbook-epub/l0088-07","stance":"reports"}],"relations":[{"kind":"refines","claim":"claim:prosody/phrasal-and-utterance-intonation--saru-interrogative-non-rising-contour-attested","differs_in":"scope","note":"Documents a specific interrogative particle that yields a falling contour without sentence-final rise."}],"grouped_by":"act:group/2026-09-10T15-06-38-590Z","status":"grouped"}
{"id":"claim:prosody/phrasal-and-utterance-intonation--hokkaido-continuation-falling-final-rising","revision":1,"topic":"topic:prosody/phrasal-and-utterance-intonation","topics":["topic:prosody/phrasal-and-utterance-intonation","topic:prosody/phrasal-and-utterance-intonation--phrasal-domains"],"statement":{"en":"In Hokkaido Ainu, a level or falling intonation contour implies continuation, whereas a rising contour marks utterance finality.","ja":"北海道アイヌ語において、平坦または下降音調は後続発話の存在を暗示し、上昇音調は発話の明確な終末を標示する。"},"type":"form-function","scope":{"doculects":["doculect:hokkaido"],"quantifier":"always","modality":"neutral","conditions":[]},"forms":[],"statements":[{"id":"stmt:shiraishi2022@handbook-epub/l0088-09","stance":"reports"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-06-38-590Z","status":"grouped"}

{"id":"claim:diachrony/proto-ainu-segmental-reconstruction--proto-ainu-vowel-length-without-pitch","revision":1,"topic":"topic:diachrony/proto-ainu-segmental-reconstruction","topics":["topic:diachrony/proto-ainu-segmental-reconstruction","topic:diachrony/proto-ainu-segmental-reconstruction--suprasegmentals"],"statement":{"en":"Proto-Ainu possessed phonologically distinctive vowel length but lacked phonologically distinctive pitch accent.","ja":"祖アイヌ語には音韻上弁別的な母音の長短が存在したが、弁別的なピッチアクセントは存在しなかった。"},"type":"analysis","scope":{"doculects":["doculect:ainu"],"quantifier":"unstated","modality":"assertive","conditions":[]},"forms":[],"statements":[{"id":"stmt:bugaeva2022@handbook-epub/l0018-09","stance":"reports"},{"id":"stmt:itabashi2001@pdftotext-pieces/l0006-05","stance":"reports"},{"id":"stmt:itabashi2001@pdftotext-pieces/l0018-01","stance":"reports"}],"relations":[],"grouped_by":"act:group/2026-09-26T07-52-28-143Z","status":"grouped"}
{"id":"claim:diachrony/proto-ainu-segmental-reconstruction--proto-ainu-both-length-and-pitch","revision":1,"topic":"topic:diachrony/proto-ainu-segmental-reconstruction","topics":["topic:diachrony/proto-ainu-segmental-reconstruction","topic:diachrony/proto-ainu-segmental-reconstruction--suprasegmentals"],"statement":{"en":"Proto-Ainu possessed both phonologically distinctive vowel length and phonologically distinctive pitch accent.","ja":"祖アイヌ語には母音の長短とピッチアクセントの両方が独立して音韻上弁別的特徴として存在していた。"},"type":"analysis","scope":{"doculects":["doculect:ainu"],"quantifier":"unstated","modality":"assertive","conditions":[]},"forms":[],"statements":[{"id":"stmt:itabashi2001@pdftotext-pieces/l0006-09","stance":"reports"},{"id":"stmt:itabashi2001@pdftotext-pieces/l0015-02","stance":"proposes"},{"id":"stmt:itabashi2001@pdftotext-pieces/l0018-02","stance":"reports"},{"id":"stmt:itabashi2001@pdftotext-pieces/l0018-03","stance":"proposes"}],"relations":[{"kind":"contradicts","claim":"claim:diachrony/proto-ainu-segmental-reconstruction--proto-ainu-vowel-length-without-pitch","differs_in":"unresolved","note":"Dispute over whether Proto-Ainu possessed only distinctive vowel length or both vowel length and pitch accent."}],"grouped_by":"act:group/2026-09-26T07-52-28-143Z","status":"grouped"}
{"id":"claim:diachrony/proto-ainu-segmental-reconstruction--in-nairo-sakhalin-ainu-initial-t-reflects-proto","revision":1,"topic":"topic:diachrony/proto-ainu-segmental-reconstruction","topics":["topic:diachrony/proto-ainu-segmental-reconstruction","topic:diachrony/proto-ainu-segmental-reconstruction--correspondence-sets"],"statement":{"en":"In Nairo Sakhalin Ainu, initial t- reflects Proto-Ainu *l and *ʈ, whereas r- reflects *ɾ.","ja":"樺太アイヌ語内路方言において、語頭の t- は祖アイヌ語の *l および *ʈ を反映し、r- は *ɾ を反映する。"},"type":"diachrony","scope":{"doculects":["doculect:sakhalin"],"quantifier":"all","modality":"actual","conditions":[]},"forms":["t-","r-","*l","*ʈ","*ɾ"],"statements":[{"id":"stmt:alonso2022@handbook-epub/l0035-03","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-26T07-52-28-143Z","status":"grouped"}
{"id":"claim:diachrony/proto-ainu-segmental-reconstruction--the-forms-for-mouth-differ-across-dialects-as","revision":1,"topic":"topic:diachrony/proto-ainu-segmental-reconstruction","topics":["topic:diachrony/proto-ainu-segmental-reconstruction","topic:diachrony/proto-ainu-segmental-reconstruction--correspondence-sets"],"statement":{"en":"The forms for 'mouth' differ across dialects as par and car, but they are considered cognate words.","ja":"「口」を表す語形は方言によって par と car という異なった形になるが、同源の語と考えられる。"},"type":"alternation","scope":{"doculects":["doculect:ainu"],"quantifier":"generic","modality":"actual","conditions":[]},"forms":["par","car"],"statements":[{"id":"stmt:nakagawa2024@gemini-3-flash-preview/l0103-01","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-26T07-52-28-143Z","status":"grouped"}
{"id":"claim:diachrony/proto-ainu-segmental-reconstruction--the-oldest-reconstructed-ainu-form-for-father-is","revision":1,"topic":"topic:diachrony/proto-ainu-segmental-reconstruction","topics":["topic:diachrony/proto-ainu-segmental-reconstruction","topic:diachrony/proto-ainu-segmental-reconstruction--correspondence-sets"],"statement":{"en":"The oldest reconstructed Ainu form for 'father' is inferred by Nakagawa to be aca.","ja":"中川は「おとうさん」を表す最古形は aca であると推測している。"},"type":"diachrony","scope":{"doculects":["doculect:ainu"],"quantifier":"unstated","modality":"actual","conditions":[]},"forms":["aca"],"statements":[{"id":"stmt:nakagawa2024@gemini-3-flash-preview/l0220-01","stance":"proposes"}],"relations":[],"grouped_by":"act:group/2026-09-26T07-52-28-143Z","status":"grouped"}
{"id":"claim:diachrony/proto-ainu-segmental-reconstruction--the-ca-pa-correspondence-is-not-found-with","revision":1,"topic":"topic:diachrony/proto-ainu-segmental-reconstruction","topics":["topic:diachrony/proto-ainu-segmental-reconstruction","topic:diachrony/proto-ainu-segmental-reconstruction--correspondence-sets"],"statement":{"en":"The ca- : pa- correspondence is not found with the vowels e, i, o, or u, and thus cannot be considered a regular phonological correspondence.","ja":"ca- : pa-の対応は母音e、i、o、uの前には見られず、真の意味での音韻対応とは言えない。"},"type":"distribution","scope":{"doculects":["doculect:ainu"],"quantifier":"none","modality":"actual","conditions":["before vowels e, i, o, u"]},"forms":["ca-","pa-"],"statements":[{"id":"stmt:nakagawafukazawa2022@handbook-epub/l0052-04","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-26T07-52-28-143Z","status":"grouped"}
{"id":"claim:diachrony/proto-ainu-segmental-reconstruction--ainu-p-tpa-p-tca-bank-shore-is","revision":1,"topic":"topic:diachrony/proto-ainu-segmental-reconstruction","topics":["topic:diachrony/proto-ainu-segmental-reconstruction","topic:diachrony/proto-ainu-segmental-reconstruction--correspondence-sets"],"statement":{"en":"Ainu pétpa ~ pétca 'bank, shore' is reconstructed to Proto-Ainu *petpya, compounded from pét 'river' and pa 'bank, shore, edge'.","ja":"アイヌ語の pétpa 〜 pétca「岸」は、pét「川」と pa「岸、縁」の複合による祖語形 *petpya に再建される。"},"type":"diachrony","scope":{"doculects":["doculect:ainu"],"quantifier":"unstated","modality":"actual","conditions":[]},"forms":["pétpa","pétca","*petpya","pét","pa"],"statements":[{"id":"stmt:vovin2022@handbook-epub/l0038-01","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-26T07-52-28-143Z","status":"grouped"}
{"id":"claim:diachrony/proto-ainu-segmental-reconstruction--in-horobetsu-ainu-toci-ni-denotes-horse-chestnut","revision":1,"topic":"topic:diachrony/proto-ainu-segmental-reconstruction","topics":["topic:diachrony/proto-ainu-segmental-reconstruction","topic:diachrony/proto-ainu-segmental-reconstruction--correspondence-sets"],"statement":{"en":"In Horobetsu Ainu, toci-ni denotes 'horse-chestnut tree' and toci denotes 'fruit of a horse chestnut tree', reconstructible to Proto-Ainu *toti.","ja":"幌別アイヌ語において toci-ni は「トチノキ」、toci は「トチの実」を意味し、祖語形 *toti に遡る。"},"type":"form-function","scope":{"doculects":["doculect:hokkaido/southwest/horobetsu"],"quantifier":"all","modality":"actual","conditions":[]},"forms":["toci-ni","toci","✶toti"],"statements":[{"id":"stmt:vovin2022@handbook-epub/l0040-02","stance":"reports"}],"relations":[],"grouped_by":"act:group/2026-09-26T07-52-28-143Z","status":"grouped"}
{"id":"claim:diachrony/proto-ainu-segmental-reconstruction--ainu-pun-i-to-lift-to-raise-sg","revision":1,"topic":"topic:diachrony/proto-ainu-segmental-reconstruction","topics":["topic:diachrony/proto-ainu-segmental-reconstruction","topic:diachrony/proto-ainu-segmental-reconstruction--correspondence-sets"],"statement":{"en":"Ainu pun-i 'to lift, to raise (SG)' derives from Proto-Ainu *pum-i.","ja":"アイヌ語 pun-i「（単数を）持ち上げる」は祖語形 *pum-i に遡る。"},"type":"diachrony","scope":{"doculects":["doculect:ainu"],"quantifier":"all","modality":"actual","conditions":[]},"forms":["pun-i","✶pum-i"],"statements":[{"id":"stmt:vovin2022@handbook-epub/l0040-06","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-26T07-52-28-143Z","status":"grouped"}
{"id":"claim:diachrony/proto-ainu-segmental-reconstruction--to-explain-the-exceptional-first-syllable-accent-in","revision":1,"topic":"topic:diachrony/proto-ainu-segmental-reconstruction","topics":["topic:diachrony/proto-ainu-segmental-reconstruction","topic:diachrony/proto-ainu-segmental-reconstruction--gaps"],"statement":{"en":"To explain the exceptional first-syllable accent in CVCV stems such as réra 'wind', an unidentified consonant *H can be reconstructed in the proto-form, as in *reHra.","ja":"réra「風」のようなCVCV語幹における第1音節の例外的なアクセントを説明するために、祖形に *reHra のような未知の子音 *H を再構することができる。"},"type":"diachrony","scope":{"doculects":["doculect:ainu"],"quantifier":"example_only","modality":"possible","conditions":[]},"forms":["réra","*reHra"],"statements":[{"id":"stmt:bugaeva2022@handbook-epub/l0018-05","stance":"proposes"}],"relations":[],"grouped_by":"act:group/2026-09-26T07-52-28-143Z","status":"grouped"}
{"id":"claim:diachrony/proto-ainu-segmental-reconstruction--to-explain-the-kana-spelling-piruka-for-pirka","revision":1,"topic":"topic:diachrony/proto-ainu-segmental-reconstruction","topics":["topic:diachrony/proto-ainu-segmental-reconstruction","topic:diachrony/proto-ainu-segmental-reconstruction--gaps"],"statement":{"en":"To explain the kana spelling piruka for pirka 'good' as opposed to shiri- for sir, it is proposed that pirka historically contained an intervening consonant *H (*piHrka) that prevented the palatalization of /r/ by /i/.","ja":"sir に対する「志り」と pirka に対する「ぴるか」という仮名表記の違いを説明するために、pirka には歴史的に介在子音 *H（*piHrka）が存在し、それによって /i/ による /r/ の口蓋化が阻害されたという仮説が提案されている。"},"type":"diachrony","scope":{"doculects":["doculect:ainu"],"quantifier":"example_only","modality":"possible","conditions":[]},"forms":["pirka","*piHrka","sir"],"statements":[{"id":"stmt:bugaeva2022@handbook-epub/l0018-18","stance":"proposes"}],"relations":[],"grouped_by":"act:group/2026-09-26T07-52-28-143Z","status":"grouped"}
{"id":"claim:diachrony/proto-ainu-segmental-reconstruction--patrie-suggests-on-comparative-evidence-that-ar-may","revision":1,"topic":"topic:diachrony/proto-ainu-segmental-reconstruction","topics":["topic:diachrony/proto-ainu-segmental-reconstruction","topic:diachrony/proto-ainu-segmental-reconstruction--gaps"],"statement":{"en":"Patrie suggests on comparative evidence that ar may be an older morpheme meaning 'one'.","ja":"Patrie は比較言語学的証拠に基づき、ar が「1」を表すより古い形態素であった可能性を示唆している。"},"type":"diachrony","scope":{"doculects":["doculect:ainu"],"quantifier":"unstated","modality":"possible","conditions":[]},"forms":["ar"],"statements":[{"id":"stmt:refsing1986@gemini-3-flash-preview/l0108-02","stance":"reports"}],"relations":[],"grouped_by":"act:group/2026-09-26T07-52-28-143Z","status":"grouped"}
{"id":"claim:diachrony/proto-ainu-segmental-reconstruction--proto-ainu-is-reconstructed-as-having-diversified-into","revision":1,"topic":"topic:diachrony/proto-ainu-segmental-reconstruction","topics":["topic:diachrony/proto-ainu-segmental-reconstruction","topic:diachrony/proto-ainu-segmental-reconstruction--periodization"],"statement":{"en":"Proto-Ainu is reconstructed as having diversified into all documented lects over a time depth of approximately one thousand years.","ja":"祖アイヌ語は、記録されたすべての諸変種へと歴史的におよそ1000年の時間深度をかけて分化した母言語である。"},"type":"diachrony","scope":{"doculects":["doculect:ainu"],"quantifier":"all","modality":"actual","conditions":[]},"forms":[],"statements":[{"id":"stmt:alonso2022@handbook-epub/l0032-05","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-26T07-52-28-143Z","status":"grouped"}
{"id":"claim:diachrony/proto-ainu-segmental-reconstruction--the-modern-word-for-fish-saru-cep-horobetsu","revision":1,"topic":"topic:diachrony/proto-ainu-segmental-reconstruction","topics":["topic:diachrony/proto-ainu-segmental-reconstruction","topic:diachrony/proto-ainu-segmental-reconstruction--periodization"],"statement":{"en":"The modern word for 'fish' (Saru cep, Horobetsu ciʔep, Raiciska ceh) reconstructs to Pre-Proto-Ainu *ti=(ʔ)e pe, literally 'the thing eaten (by everyone)'.","ja":"「魚」を表す現代語形（沙流 cep、幌別 ciʔep、来知志 ceh）は、文字通りには「（皆によって）食べられるもの」を意味する前祖アイヌ語 *ti=(ʔ)e pe に再構される。"},"type":"diachrony","scope":{"doculects":["doculect:ainu"],"quantifier":"all","modality":"actual","conditions":[]},"forms":["*ti=(ʔ)e pe","*/ti-ʔe-p/","*/ciʔep/","cep","ciʔep","ceh"],"statements":[{"id":"stmt:alonso2022@handbook-epub/l0035-05","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-26T07-52-28-143Z","status":"grouped"}
{"id":"claim:diachrony/proto-ainu-segmental-reconstruction--proto-ainu-can-be-reconstructed-on-the-basis","revision":1,"topic":"topic:diachrony/proto-ainu-segmental-reconstruction","topics":["topic:diachrony/proto-ainu-segmental-reconstruction","topic:diachrony/proto-ainu-segmental-reconstruction--periodization"],"statement":{"en":"Proto-Ainu can be reconstructed on the basis of Hokkaido Ainu, Sakhalin Ainu, and Northern Kuril Ainu, and has a relatively shallow time depth corresponding to the northward expansion of the language.","ja":"祖アイヌ語は北海道アイヌ語・樺太アイヌ語・千島北部アイヌ語の3大方言に基づいて再構可能であり、その時間的深さは言語の北進拡大の歴史に対応して比較的浅い。"},"type":"diachrony","scope":{"doculects":["doculect:ainu"],"quantifier":"unstated","modality":"actual","conditions":[]},"forms":[],"statements":[{"id":"stmt:janhunen2022@handbook-epub/l0011-01","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-26T07-52-28-143Z","status":"grouped"}
{"id":"claim:diachrony/proto-ainu-segmental-reconstruction--the-term-s-sam-japanese-dates-back-to","revision":1,"topic":"topic:diachrony/proto-ainu-segmental-reconstruction","topics":["topic:diachrony/proto-ainu-segmental-reconstruction","topic:diachrony/proto-ainu-segmental-reconstruction--periodization"],"statement":{"en":"The term sísam 'Japanese' dates back to Pre-Proto-Ainu and was originally a compound *sii+sam/o, as evidenced by the Yakumo dialect variant samó.","ja":"「日本人」を意味する sísam はプレ祖アイヌ語に遡り、八雲方言の samó という異形からみて元来は *sii+sam/o という複合語であったと考えられる。"},"type":"diachrony","scope":{"doculects":["doculect:ainu","doculect:hokkaido/southwest/yakumo"],"quantifier":"unstated","modality":"actual","conditions":[]},"forms":["sísam","samó"],"statements":[{"id":"stmt:janhunen2022@handbook-epub/l0011-06","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-26T07-52-28-143Z","status":"grouped"}
{"id":"claim:diachrony/proto-ainu-segmental-reconstruction--in-common-ainu-the-hypothetical-lateral-l-merged","revision":1,"topic":"topic:diachrony/proto-ainu-segmental-reconstruction","topics":["topic:diachrony/proto-ainu-segmental-reconstruction","topic:diachrony/proto-ainu-segmental-reconstruction--revision-l"],"statement":{"en":"In Common Ainu, the hypothetical lateral *l merged with the flap *ɾ.","ja":"共通アイヌ語において、仮定された側音 *l は弾き音 *ɾ と合流した。"},"type":"diachrony","scope":{"doculects":["doculect:ainu"],"quantifier":"all","modality":"actual","conditions":[]},"forms":["*l","*ɾ"],"statements":[{"id":"stmt:alonso2022@handbook-epub/l0035-02","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-26T07-52-28-143Z","status":"grouped"}
{"id":"claim:diachrony/proto-ainu-segmental-reconstruction--in-common-ainu-the-palatalized-consonant-series-collapsed","revision":1,"topic":"topic:diachrony/proto-ainu-segmental-reconstruction","topics":["topic:diachrony/proto-ainu-segmental-reconstruction","topic:diachrony/proto-ainu-segmental-reconstruction--revision-palatalized"],"statement":{"en":"In Common Ainu, the palatalized consonant series collapsed, with *sʸ and *s merging after *i.","ja":"共通アイヌ語において口蓋化子音系列は崩壊し、*i の後で *sʸ と *s が合流した。"},"type":"diachrony","scope":{"doculects":["doculect:ainu"],"quantifier":"all","modality":"actual","conditions":[]},"forms":["*sʸ","*s"],"statements":[{"id":"stmt:alonso2022@handbook-epub/l0035-01","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-26T07-52-28-143Z","status":"grouped"}
{"id":"claim:diachrony/proto-ainu-segmental-reconstruction--long-vowels-in-hokkaido-ainu-were-never-an","revision":1,"topic":"topic:diachrony/proto-ainu-segmental-reconstruction","topics":["topic:diachrony/proto-ainu-segmental-reconstruction","topic:diachrony/proto-ainu-segmental-reconstruction--suprasegmentals"],"statement":{"en":"Long vowels in Hokkaido Ainu were never an archaic Proto-Ainu property, but rather a temporary, redundant secondary development that was subsequently lost without becoming phonemically distinctive.","ja":"北海道アイヌ語における長母音は祖アイヌ語の古い特徴ではなく、一時的な余剰的二次発達にすぎず、音韻的対立をなさずに最終的に消失した。"},"type":"diachrony","scope":{"doculects":["doculect:hokkaido"],"quantifier":"all","modality":"actual","conditions":[]},"forms":[],"statements":[{"id":"stmt:bugaeva2022@handbook-epub/l0018-04","stance":"proposes"}],"relations":[],"grouped_by":"act:group/2026-09-26T07-52-28-143Z","status":"grouped"}
{"id":"claim:diachrony/proto-ainu-segmental-reconstruction--sat-2016b-claims-that-the-phonological-vowel-length","revision":1,"topic":"topic:diachrony/proto-ainu-segmental-reconstruction","topics":["topic:diachrony/proto-ainu-segmental-reconstruction","topic:diachrony/proto-ainu-segmental-reconstruction--suprasegmentals"],"statement":{"en":"Satō (2016b) claims that the phonological vowel length opposition in Sakhalin Ainu is a secondary development rather than an archaic retention from Proto-Ainu.","ja":"佐藤（2016b）は服部（1967）とは対照的に、樺太方言における母音長短の対立は祖アイヌ語からの保持ではなく二次的発達であると主張している。"},"type":"diachrony","scope":{"doculects":["doculect:sakhalin"],"quantifier":"all","modality":"actual","conditions":[]},"forms":[],"statements":[{"id":"stmt:bugaeva2022@handbook-epub/l0018-10","stance":"reports"}],"relations":[],"grouped_by":"act:group/2026-09-26T07-52-28-143Z","status":"grouped"}
{"id":"claim:diachrony/proto-ainu-segmental-reconstruction--sakhalin-ainu-inherited-vowel-length-as-phonologically-distinctive","revision":1,"topic":"topic:diachrony/proto-ainu-segmental-reconstruction","topics":["topic:diachrony/proto-ainu-segmental-reconstruction","topic:diachrony/proto-ainu-segmental-reconstruction--suprasegmentals"],"statement":{"en":"Sakhalin Ainu inherited vowel length as phonologically distinctive and inherited pitch accent as a phonetic feature.","ja":"樺太アイヌ語では母音の長短を音韻上の弁別的特徴として継承し、ピッチアクセントは本来の音声上の弁別的特徴として継承したとされる。"},"type":"diachrony","scope":{"doculects":["doculect:sakhalin"],"quantifier":"generic","modality":"actual","conditions":[]},"forms":[],"statements":[{"id":"stmt:itabashi2001@pdftotext-pieces/l0006-07","stance":"reports"}],"relations":[],"grouped_by":"act:group/2026-09-26T07-52-28-143Z","status":"grouped"}
{"id":"claim:diachrony/proto-ainu-segmental-reconstruction--two-mora-words-with-long-vowels-in-sakhalin","revision":1,"topic":"topic:diachrony/proto-ainu-segmental-reconstruction","topics":["topic:diachrony/proto-ainu-segmental-reconstruction","topic:diachrony/proto-ainu-segmental-reconstruction--suprasegmentals"],"statement":{"en":"Two-mora words with long vowels in Sakhalin Ainu are considered to have possessed long vowels in Proto-Ainu as well.","ja":"樺太アイヌ語における長母音をもつ2モーラの語は、アイヌ祖語においても長母音であったと考えられる。"},"type":"diachrony","scope":{"doculects":["doculect:ainu","doculect:sakhalin"],"quantifier":"generic","modality":"actual","conditions":[]},"forms":[],"statements":[{"id":"stmt:itabashi2001@pdftotext-pieces/l0014-03","stance":"proposes"}],"relations":[],"grouped_by":"act:group/2026-09-26T07-52-28-143Z","status":"grouped"}
{"id":"claim:diachrony/proto-ainu-segmental-reconstruction--in-hokkaido-dialects-excluding-tasuke-yamamoto-s-dialect","revision":1,"topic":"topic:diachrony/proto-ainu-segmental-reconstruction","topics":["topic:diachrony/proto-ainu-segmental-reconstruction","topic:diachrony/proto-ainu-segmental-reconstruction--suprasegmentals"],"statement":{"en":"In Hokkaido dialects (excluding Tasuke Yamamoto's dialect), the distinction between long and short vowels in Proto-Ainu monosyllabic open words was lost and pitch accent foregrounded instead, with all vowels in monosyllabic words becoming short.","ja":"北海道方言（山本多助氏の方言を除く）では、アイヌ祖語の開音節単音節語の長母音と短母音の区別が消失してピッチアクセントが弁別として前景化したが、単音節語の母音はすべて短くなったと考えられる。"},"type":"diachrony","scope":{"doculects":["doculect:hokkaido"],"quantifier":"generic","modality":"actual","conditions":["excluding Tasuke Yamamoto's dialect"]},"forms":[],"statements":[{"id":"stmt:itabashi2001@pdftotext-pieces/l0016-03","stance":"proposes"}],"relations":[],"grouped_by":"act:group/2026-09-26T07-52-28-143Z","status":"grouped"}
{"id":"claim:diachrony/proto-ainu-segmental-reconstruction--in-sakhalin-ainu-the-proto-ainu-vowel-length","revision":1,"topic":"topic:diachrony/proto-ainu-segmental-reconstruction","topics":["topic:diachrony/proto-ainu-segmental-reconstruction","topic:diachrony/proto-ainu-segmental-reconstruction--suprasegmentals"],"statement":{"en":"In Sakhalin Ainu, the Proto-Ainu vowel length distinction in open monosyllabic words largely disappeared and mostly shifted to long vowels.","ja":"樺太方言においては、アイヌ祖語の開音節単音節中の母音の長短の弁別がほとんど消失し、ほとんど長母音に移行したと考えられる。"},"type":"diachrony","scope":{"doculects":["doculect:sakhalin"],"quantifier":"generic","modality":"possible","conditions":[]},"forms":[],"statements":[{"id":"stmt:itabashi2001@pdftotext-pieces/l0016-04","stance":"proposes"}],"relations":[],"grouped_by":"act:group/2026-09-26T07-52-28-143Z","status":"grouped"}
{"id":"claim:diachrony/proto-ainu-segmental-reconstruction--the-vowel-length-distinction-found-in-sakhalin-ainu","revision":1,"topic":"topic:diachrony/proto-ainu-segmental-reconstruction","topics":["topic:diachrony/proto-ainu-segmental-reconstruction","topic:diachrony/proto-ainu-segmental-reconstruction--suprasegmentals"],"statement":{"en":"The vowel-length distinction found in Sakhalin Ainu is considered to be older than the accentual distinction in Hokkaido Ainu.","ja":"長短母音の対立のほうが、アクセントの対立より古い形式であると考えられている。"},"type":"diachrony","scope":{"doculects":["doculect:ainu"],"quantifier":"all","modality":"actual","conditions":[]},"forms":[],"statements":[{"id":"stmt:nakagawa2024@gemini-3-flash-preview/l0025-01","stance":"reports"}],"relations":[],"grouped_by":"act:group/2026-09-26T07-52-28-143Z","status":"grouped"}
{"id":"claim:diachrony/proto-ainu-segmental-reconstruction--there-is-a-regular-phonological-correspondence-between-pitch","revision":1,"topic":"topic:diachrony/proto-ainu-segmental-reconstruction","topics":["topic:diachrony/proto-ainu-segmental-reconstruction","topic:diachrony/proto-ainu-segmental-reconstruction--suprasegmentals"],"statement":{"en":"There is a regular phonological correspondence between pitch accent in Hokkaido Ainu and vowel length in Sakhalin Ainu, which is reconstructible to Proto-Ainu.","ja":"北海道方言のアクセントと樺太方言の長短母音の間には音韻対応関係があり、アイヌ祖語にまでたどれるものと想定されている。"},"type":"alternation","scope":{"doculects":["doculect:hokkaido","doculect:sakhalin"],"quantifier":"unstated","modality":"actual","conditions":[]},"forms":[],"statements":[{"id":"stmt:nakagawa2024@gemini-3-flash-preview/l0074-01","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-26T07-52-28-143Z","status":"grouped"}

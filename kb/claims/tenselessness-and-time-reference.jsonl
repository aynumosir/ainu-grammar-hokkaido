{"id":"claim:tam/tenselessness-and-time-reference--absence-of-tense-category","revision":1,"topic":"topic:tam/tenselessness-and-time-reference","topics":["topic:tam/tenselessness-and-time-reference","topic:tam/tenselessness-and-time-reference--tense-absence"],"statement":{"en":"Ainu lacks the grammatical category of tense.","ja":"アイヌ語には時制という文法範疇が存在しない。"},"type":"absence","scope":{"doculects":["doculect:ainu"],"quantifier":"all","modality":"asserted","conditions":[]},"forms":[],"statements":[{"id":"stmt:refsing1986@gemini-3-flash-preview/l0040-04","stance":"asserts"},{"id":"stmt:sato2008@gemini-3-flash-preview/l0382-01","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-13-12-354Z","status":"grouped"}
{"id":"claim:tam/tenselessness-and-time-reference--no-morphological-tense-marking-on-verbs","revision":1,"topic":"topic:tam/tenselessness-and-time-reference","topics":["topic:tam/tenselessness-and-time-reference","topic:tam/tenselessness-and-time-reference--tense-absence"],"statement":{"en":"Past, present, and future tenses are not morphologically marked on the verb in Ainu.","ja":"アイヌ語の動詞には過去・現在・未来の時制が形態的に表示されない。"},"type":"absence","scope":{"doculects":["doculect:ainu"],"quantifier":"all","modality":"asserted","conditions":[]},"forms":[],"statements":[{"id":"stmt:nakagawa2024@gemini-3-flash-preview/l0121-01","stance":"asserts"},{"id":"stmt:refsing1986@gemini-3-flash-preview/l0185-04","stance":"asserts"},{"id":"stmt:sato2008@gemini-3-flash-preview/l0026-02","stance":"asserts"}],"relations":[{"kind":"supports","claim":"claim:tam/tenselessness-and-time-reference--absence-of-tense-category","differs_in":null,"note":"Absence of morphological tense marking on the verb supports the absence of a grammatical tense category."}],"grouped_by":"act:group/2026-09-10T15-13-12-354Z","status":"grouped"}
{"id":"claim:tam/tenselessness-and-time-reference--verbs-lack-pure-tense-markers","revision":1,"topic":"topic:tam/tenselessness-and-time-reference","topics":["topic:tam/tenselessness-and-time-reference","topic:tam/tenselessness-and-time-reference--tense-absence"],"statement":{"en":"Ainu verbs have no pure tense markers.","ja":"アイヌ語の動詞には純粋な時制標識が存在しない。"},"type":"absence","scope":{"doculects":["doculect:hokkaido/southwest"],"quantifier":"all","modality":"asserted","conditions":[]},"forms":[],"statements":[{"id":"stmt:bugaeva2012@gemini-3-flash-preview/l0018-05","stance":"asserts"},{"id":"stmt:bugaeva2014@pdftotext-pieces/l0002-09","stance":"asserts"}],"relations":[{"kind":"refines","claim":"claim:tam/tenselessness-and-time-reference--no-morphological-tense-marking-on-verbs","differs_in":"scope","note":"Restricts the absence of pure tense markers specifically to verbs in Southwest Hokkaido."}],"grouped_by":"act:group/2026-09-10T15-13-12-354Z","status":"grouped"}
{"id":"claim:tam/tenselessness-and-time-reference--an-event-that-has-already-occurred-before-a","revision":1,"topic":"topic:tam/tenselessness-and-time-reference","topics":["topic:tam/tenselessness-and-time-reference","topic:tam/tenselessness-and-time-reference--aspect-temporal"],"statement":{"en":"An event that has already occurred before a certain reference point can be expressed using auxiliaries such as a and nisa, or auxiliary verb constructions such as wa isam and wa okere.","ja":"ある時点以前にすでに起こってしまったことを表すには、a、nisa などの助動詞や、wa isam、wa okere などの補助動詞形式を使うやり方がある。"},"type":"form-function","scope":{"doculects":["doculect:ainu"],"quantifier":"generic","modality":"actual","conditions":[]},"forms":["a","nisa","wa isam","wa okere"],"statements":[{"id":"stmt:nakagawa2024@gemini-3-flash-preview/l0432-01","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-13-12-354Z","status":"grouped"}
{"id":"claim:tam/tenselessness-and-time-reference--the-auxiliary-nisa-indicates-that-an-event-has","revision":1,"topic":"topic:tam/tenselessness-and-time-reference","topics":["topic:tam/tenselessness-and-time-reference","topic:tam/tenselessness-and-time-reference--aspect-temporal"],"statement":{"en":"The auxiliary nisa indicates that an event has already been realized, thereby indicating relative past when anchored to the speech time.","ja":"nisa はそれがすでに実現してしまったことであることを表わす助動詞であり、発話時点より前に起こったことであることが示される。"},"type":"form-function","scope":{"doculects":["doculect:ainu"],"quantifier":"all","modality":"actual","conditions":[]},"forms":["nisa"],"statements":[{"id":"stmt:nakagawa2024@gemini-3-flash-preview/l0432-02","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-13-12-354Z","status":"grouped"}
{"id":"claim:tam/tenselessness-and-time-reference--forms-like-a-nisa-and-wa-okere-are","revision":1,"topic":"topic:tam/tenselessness-and-time-reference","topics":["topic:tam/tenselessness-and-time-reference","topic:tam/tenselessness-and-time-reference--aspect-temporal"],"statement":{"en":"Forms like a, nisa, and wa okere are fundamentally aspectual rather than temporal; they express past time only when used in clauses oriented to the present speech time, and in other contexts they do not necessarily refer to past events.","ja":"a、nisa、wa okere などの形式は本来的にアスペクトに関わるもので時制を表す形式ではないため、現在の発話時点を基準にした文の中で使われれば過去を表すが、文脈次第では過去のことを指しているわけではない。"},"type":"analysis","scope":{"doculects":["doculect:ainu"],"quantifier":"all","modality":"actual","conditions":[]},"forms":["a","nisa","wa okere"],"statements":[{"id":"stmt:nakagawa2024@gemini-3-flash-preview/l0432-03","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-13-12-354Z","status":"grouped"}
{"id":"claim:tam/tenselessness-and-time-reference--the-ainu-verb-lexicon-has-no-morphological-distinction","revision":1,"topic":"topic:tam/tenselessness-and-time-reference","topics":["topic:tam/tenselessness-and-time-reference","topic:tam/tenselessness-and-time-reference--aspect-temporal"],"statement":{"en":"The Ainu verb lexicon has no morphological distinction between perfective and imperfective aspects.","ja":"アイヌ語の語彙そのものには完了相と未完了相の形態的な区別が存在しない。"},"type":"absence","scope":{"doculects":["doculect:ainu"],"quantifier":"all","modality":"actual","conditions":[]},"forms":[],"statements":[{"id":"stmt:yoshikawa2022@handbook-epub/l0125-02","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-13-12-354Z","status":"grouped"}
{"id":"claim:tam/tenselessness-and-time-reference--future-events-that-have-not-yet-occurred-can","revision":1,"topic":"topic:tam/tenselessness-and-time-reference","topics":["topic:tam/tenselessness-and-time-reference","topic:tam/tenselessness-and-time-reference--prospective"],"statement":{"en":"Future events that have not yet occurred can be expressed by auxiliary-like forms expressing volition or necessity, such as kus(u) ne 'intend to', oasi 'will surely', etokus 'intend to / seem about to', and etokoyki 'be preparing to'.","ja":"kus(u) ne「〜するつもりだ」、oasi「きっと〜する」、etokus「〜するつもりだ、〜しそうだ」、etokoyki「〜する用意をしている」などの助動詞的な形式によって、まだ事態が成立していない未来に起こることを表すことができる。"},"type":"form-function","scope":{"doculects":["doculect:ainu"],"quantifier":"generic","modality":"actual","conditions":[]},"forms":["kusu ne","kus ne","oasi","etokus","etokoyki"],"statements":[{"id":"stmt:nakagawa2024@gemini-3-flash-preview/l0431-02","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-13-12-354Z","status":"grouped"}
{"id":"claim:tam/tenselessness-and-time-reference--in-semi-direct-reported-discourse-lexical-expressions-of","revision":1,"topic":"topic:tam/tenselessness-and-time-reference","topics":["topic:tam/tenselessness-and-time-reference","topic:tam/tenselessness-and-time-reference--temporal-adverbs"],"statement":{"en":"In semi-direct reported discourse, lexical expressions of temporal deixis do not undergo a deictic shift.","ja":"半直接話法において、時間直示を表す語彙表現は直示シフトを起こさない。"},"type":"distribution","scope":{"doculects":["doculect:hokkaido/southwest"],"quantifier":"none","modality":"actual","conditions":["in semi-direct reported discourse"]},"forms":["tane","tan-ukuran"],"statements":[{"id":"stmt:bugaeva2008@pdftotext-pieces/l0022-02","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-13-12-354Z","status":"grouped"}
{"id":"claim:tam/tenselessness-and-time-reference--to-state-a-fact-that-occurred-in-the","revision":1,"topic":"topic:tam/tenselessness-and-time-reference","topics":["topic:tam/tenselessness-and-time-reference","topic:tam/tenselessness-and-time-reference--temporal-adverbs"],"statement":{"en":"To state a fact that occurred in the past, one can use the bare verb together with a time adverb indicating past time, and the bare verb can also be used for habitual actions.","ja":"過去に起こった事実を述べる時は過去を表す時の副詞などを添えて動詞をそのまま使えばよく、また習慣的な行為にも動詞をそのまま使える。"},"type":"distribution","scope":{"doculects":["doculect:sakhalin"],"quantifier":"generic","modality":"possible","conditions":[]},"forms":[],"statements":[{"id":"stmt:murasaki2025@gemini-3-flash-preview/l0031-07","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-13-12-354Z","status":"grouped"}
{"id":"claim:tam/tenselessness-and-time-reference--in-ainu-temporal-relations-relative-to-the-speech","revision":1,"topic":"topic:tam/tenselessness-and-time-reference","topics":["topic:tam/tenselessness-and-time-reference","topic:tam/tenselessness-and-time-reference--temporal-adverbs"],"statement":{"en":"In Ainu, temporal relations relative to the speech time can be indicated using time adverbs, expressions of volition or necessity for the future, sentence-final phrases for the present, and forms expressing completion for the past.","ja":"アイヌ語では発話時点との時間関係を示す手段として、時間副詞を使うこと、未来を表すのに意志や必然性を表す形式を使うこと、現在を表すのに文末句を使うこと、過去を表すのに完了を表す形式を使うことがある。"},"type":"form-function","scope":{"doculects":["doculect:ainu"],"quantifier":"all","modality":"actual","conditions":[]},"forms":[],"statements":[{"id":"stmt:nakagawa2024@gemini-3-flash-preview/l0430-02","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-13-12-354Z","status":"grouped"}
{"id":"claim:tam/tenselessness-and-time-reference--points-in-time-can-be-directly-expressed-using","revision":1,"topic":"topic:tam/tenselessness-and-time-reference","topics":["topic:tam/tenselessness-and-time-reference","topic:tam/tenselessness-and-time-reference--temporal-adverbs"],"statement":{"en":"Points in time can be directly expressed using adverbs that express temporal relations, such as numan 'yesterday' or nisatta 'tomorrow'.","ja":"numan「昨日」や nisatta「明日」といった時間関係を表す副詞を使って、時点を直接表すことができる。"},"type":"form-function","scope":{"doculects":["doculect:ainu"],"quantifier":"generic","modality":"actual","conditions":[]},"forms":["numan","nisatta"],"statements":[{"id":"stmt:nakagawa2024@gemini-3-flash-preview/l0430-03","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-13-12-354Z","status":"grouped"}
{"id":"claim:tam/tenselessness-and-time-reference--without-a-time-adverb-like-numan-yesterday-or","revision":1,"topic":"topic:tam/tenselessness-and-time-reference","topics":["topic:tam/tenselessness-and-time-reference","topic:tam/tenselessness-and-time-reference--temporal-adverbs"],"statement":{"en":"Without a time adverb like numan 'yesterday' or nisatta 'tomorrow', the same clause can be understood as either future or past depending on context.","ja":"numan「昨日」や nisatta「明日」といった副詞を入れない場合、文脈次第でこれから行う（未来）可能性や、すでに済ませてしまった（過去）話になりえる。"},"type":"distribution","scope":{"doculects":["doculect:ainu"],"quantifier":"generic","modality":"possible","conditions":["when time adverbs are omitted"]},"forms":["numan","nisatta"],"statements":[{"id":"stmt:nakagawa2024@gemini-3-flash-preview/l0431-01","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-13-12-354Z","status":"grouped"}
{"id":"claim:tam/tenselessness-and-time-reference--the-morpheme-nisa-is-not-found-in-the","revision":1,"topic":"topic:tam/tenselessness-and-time-reference","topics":["topic:tam/tenselessness-and-time-reference","topic:tam/tenselessness-and-time-reference--temporal-adverbs"],"statement":{"en":"The morpheme nisa is not found in the Shizunai dialect.","ja":"形態素nisaは静内方言には見られない。"},"type":"absence","scope":{"doculects":["doculect:hokkaido/southwest/shizunai"],"quantifier":"none","modality":"actual","conditions":[]},"forms":["nisa"],"statements":[{"id":"stmt:refsing1986@gemini-3-flash-preview/l0040-03","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-13-12-354Z","status":"grouped"}
{"id":"claim:tam/tenselessness-and-time-reference--the-adverb-tane-centers-on-right-now-but","revision":1,"topic":"topic:tam/tenselessness-and-time-reference","topics":["topic:tam/tenselessness-and-time-reference","topic:tam/tenselessness-and-time-reference--temporal-adverbs"],"statement":{"en":"The adverb tane centers on 'right now' but encompasses a relatively wide span of 'now', including a little before and a little after the present.","ja":"副詞 tane は「今現在」を軸としつつも，「今より少し前」や「今より少し後」を含めた，比較的幅広い「今」を意味する。"},"type":"form-function","scope":{"doculects":["doculect:hokkaido"],"quantifier":"generic","modality":"actual","conditions":[]},"forms":["tane"],"statements":[{"id":"stmt:sato2008@gemini-3-flash-preview/l0203-01","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-13-12-354Z","status":"grouped"}
{"id":"claim:tam/tenselessness-and-time-reference--the-adverb-tap-appears-to-be-used-only","revision":1,"topic":"topic:tam/tenselessness-and-time-reference","topics":["topic:tam/tenselessness-and-time-reference","topic:tam/tenselessness-and-time-reference--temporal-adverbs"],"statement":{"en":"The adverb tap appears to be used only for immediate past events occurring a little before the present.","ja":"副詞 tap は，「今より少し前」の直近の過去の出来事に限って用いられるようである。"},"type":"distribution","scope":{"doculects":["doculect:hokkaido"],"quantifier":"generic","modality":"possible","conditions":[]},"forms":["tap"],"statements":[{"id":"stmt:sato2008@gemini-3-flash-preview/l0203-02","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-13-12-354Z","status":"grouped"}
{"id":"claim:tam/tenselessness-and-time-reference--the-form-tap-is-used-in-the-fixed","revision":1,"topic":"topic:tam/tenselessness-and-time-reference","topics":["topic:tam/tenselessness-and-time-reference","topic:tam/tenselessness-and-time-reference--temporal-adverbs"],"statement":{"en":"The form tap is used in the fixed expressions tap oro wano and tap oro wa un with the meaning 'after that' (after a reference point in the past).","ja":"tap は tap oro wano や tap oro wa un という決まった表現で用いられて，「それから」（過去の基準点以後）という意味を表すことがある。"},"type":"form-function","scope":{"doculects":["doculect:hokkaido"],"quantifier":"exists","modality":"actual","conditions":[]},"forms":["tap oro wano","tap oro wa un"],"statements":[{"id":"stmt:sato2008@gemini-3-flash-preview/l0203-03","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-13-12-354Z","status":"grouped"}
{"id":"claim:tam/tenselessness-and-time-reference--the-form-tap-can-combine-with-other-adverbs","revision":1,"topic":"topic:tam/tenselessness-and-time-reference","topics":["topic:tam/tenselessness-and-time-reference","topic:tam/tenselessness-and-time-reference--temporal-adverbs"],"statement":{"en":"The form tap can combine with other adverbs such as tane, tanto, and núman to express meanings like 'just now', 'having just ... today', or 'just yesterday'.","ja":"tap は tap tane, tap tanto, tap núman のように他の副詞と組み合わされて「つい今しがた」，「今日〜したばかり」，「つい昨日」のような意味を表すことがある。"},"type":"form-function","scope":{"doculects":["doculect:hokkaido"],"quantifier":"exists","modality":"actual","conditions":[]},"forms":["tap tane","tap tanto","tap núman"],"statements":[{"id":"stmt:sato2008@gemini-3-flash-preview/l0203-04","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-13-12-354Z","status":"grouped"}
{"id":"claim:tam/tenselessness-and-time-reference--the-adverb-sir-means-a-little-while-ago","revision":1,"topic":"topic:tam/tenselessness-and-time-reference","topics":["topic:tam/tenselessness-and-time-reference","topic:tam/tenselessness-and-time-reference--temporal-adverbs"],"statement":{"en":"The adverb ésir means 'a little while ago' or 'just before'.","ja":"副詞 ésir は「さっき」を意味する。"},"type":"form-function","scope":{"doculects":["doculect:hokkaido"],"quantifier":"generic","modality":"actual","conditions":[]},"forms":["ésir"],"statements":[{"id":"stmt:sato2008@gemini-3-flash-preview/l0203-05","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-13-12-354Z","status":"grouped"}
{"id":"claim:tam/tenselessness-and-time-reference--the-adverb-teta-means-the-other-day","revision":1,"topic":"topic:tam/tenselessness-and-time-reference","topics":["topic:tam/tenselessness-and-time-reference","topic:tam/tenselessness-and-time-reference--temporal-adverbs"],"statement":{"en":"The adverb teta means 'the other day'.","ja":"副詞 teta は「この間」を意味する。"},"type":"form-function","scope":{"doculects":["doculect:hokkaido"],"quantifier":"generic","modality":"actual","conditions":[]},"forms":["teta"],"statements":[{"id":"stmt:sato2008@gemini-3-flash-preview/l0203-06","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-13-12-354Z","status":"grouped"}
{"id":"claim:tam/tenselessness-and-time-reference--the-temporal-noun-adverb-teeta-means-long-ago","revision":1,"topic":"topic:tam/tenselessness-and-time-reference","topics":["topic:tam/tenselessness-and-time-reference","topic:tam/tenselessness-and-time-reference--temporal-adverbs"],"statement":{"en":"The temporal noun/adverb teeta means 'long ago' or 'in the past'.","ja":"時間名詞／副詞 teeta は「昔」を意味する。"},"type":"form-function","scope":{"doculects":["doculect:hokkaido"],"quantifier":"generic","modality":"actual","conditions":[]},"forms":["teeta"],"statements":[{"id":"stmt:sato2008@gemini-3-flash-preview/l0203-08","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-13-12-354Z","status":"grouped"}
{"id":"claim:tam/tenselessness-and-time-reference--the-temporal-adverb-tanto-means-today","revision":1,"topic":"topic:tam/tenselessness-and-time-reference","topics":["topic:tam/tenselessness-and-time-reference","topic:tam/tenselessness-and-time-reference--temporal-adverbs"],"statement":{"en":"The temporal adverb tanto means 'today'.","ja":"時間副詞 tanto は「今日」を意味する。"},"type":"form-function","scope":{"doculects":["doculect:hokkaido"],"quantifier":"generic","modality":"actual","conditions":[]},"forms":["tanto"],"statements":[{"id":"stmt:sato2008@gemini-3-flash-preview/l0204-01","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-13-12-354Z","status":"grouped"}
{"id":"claim:tam/tenselessness-and-time-reference--the-temporal-adverb-n-man-means-yesterday","revision":1,"topic":"topic:tam/tenselessness-and-time-reference","topics":["topic:tam/tenselessness-and-time-reference","topic:tam/tenselessness-and-time-reference--temporal-adverbs"],"statement":{"en":"The temporal adverb núman means 'yesterday'.","ja":"時間副詞 núman は「昨日」を意味する。"},"type":"form-function","scope":{"doculects":["doculect:hokkaido"],"quantifier":"generic","modality":"actual","conditions":[]},"forms":["núman"],"statements":[{"id":"stmt:sato2008@gemini-3-flash-preview/l0204-02","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-13-12-354Z","status":"grouped"}
{"id":"claim:tam/tenselessness-and-time-reference--the-temporal-adverb-nisatta-means-tomorrow","revision":1,"topic":"topic:tam/tenselessness-and-time-reference","topics":["topic:tam/tenselessness-and-time-reference","topic:tam/tenselessness-and-time-reference--temporal-adverbs"],"statement":{"en":"The temporal adverb nisatta means 'tomorrow'.","ja":"時間副詞 nisatta は「明日」を意味する。"},"type":"form-function","scope":{"doculects":["doculect:hokkaido"],"quantifier":"generic","modality":"actual","conditions":[]},"forms":["nisatta"],"statements":[{"id":"stmt:sato2008@gemini-3-flash-preview/l0204-03","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-13-12-354Z","status":"grouped"}
{"id":"claim:tam/tenselessness-and-time-reference--in-ainu-there-is-no-form-that-actively","revision":1,"topic":"topic:tam/tenselessness-and-time-reference","topics":["topic:tam/tenselessness-and-time-reference","topic:tam/tenselessness-and-time-reference--tense-absence"],"statement":{"en":"In Ainu, there is no form that actively indicates tense, and the bare verb form can express that the action is certain, whether in the present or in the past.","ja":"アイヌ語には積極的に時制を表示する形式はなく、動詞の裸の形は表される行為が確定的なことを現在でも過去でも表すことができる。"},"type":"absence","scope":{"doculects":["doculect:sakhalin"],"quantifier":"all","modality":"actual","conditions":[]},"forms":[],"statements":[{"id":"stmt:murasaki2025@gemini-3-flash-preview/l0031-05","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-13-12-354Z","status":"grouped"}
{"id":"claim:tam/tenselessness-and-time-reference--the-zero-auxiliary-verb-expresses-past-tense-or","revision":1,"topic":"topic:tam/tenselessness-and-time-reference","topics":["topic:tam/tenselessness-and-time-reference","topic:tam/tenselessness-and-time-reference--tense-absence"],"statement":{"en":"The zero auxiliary verb φ expresses past tense or habitual action ('did, always does').","ja":"ゼロ助動詞 φ は《～た、いつも～する》を表す。"},"type":"form-function","scope":{"doculects":["doculect:sakhalin"],"quantifier":"generic","modality":"actual","conditions":[]},"forms":["φ"],"statements":[{"id":"stmt:murasaki2025@gemini-3-flash-preview/l0100-06","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-13-12-354Z","status":"grouped"}
{"id":"claim:tam/tenselessness-and-time-reference--ainu-lacks-the-grammatical-category-of-tense-and","revision":1,"topic":"topic:tam/tenselessness-and-time-reference","topics":["topic:tam/tenselessness-and-time-reference","topic:tam/tenselessness-and-time-reference--tense-absence"],"statement":{"en":"Ainu lacks the grammatical category of tense and does not locate utterances on a linear time concept, meaning forms like oman signify only the verbal concept in connection with person without inherently expressing past or present tense.","ja":"アイヌ語には時制の文法範疇が存在せず、線形的な時間概念に関与しないため、omanのような形は過去時制でも現在時制でもなく、単に三人称に関連した「行く」という概念を表しているにすぎない。"},"type":"analysis","scope":{"doculects":["doculect:ainu"],"quantifier":"all","modality":"actual","conditions":[]},"forms":["oman"],"statements":[{"id":"stmt:refsing1986@gemini-3-flash-preview/l0032-07","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-13-12-354Z","status":"grouped"}
{"id":"claim:tam/tenselessness-and-time-reference--ainu-verbs-such-as-apkas-can-be-translated","revision":1,"topic":"topic:tam/tenselessness-and-time-reference","topics":["topic:tam/tenselessness-and-time-reference","topic:tam/tenselessness-and-time-reference--tense-absence"],"statement":{"en":"Ainu verbs such as 'apkas' can be translated with either present or past tense meaning depending on context, as tense is determined by the situation and context.","ja":"apkas のような動詞は現在の意味にも過去の意味にも訳すことができ，どちらが適切かは実際の状況や前後の文脈によって決まる。"},"type":"form-function","scope":{"doculects":["doculect:ainu"],"quantifier":"generic","modality":"actual","conditions":[]},"forms":["apkas"],"statements":[{"id":"stmt:sato2008@gemini-3-flash-preview/l0035-04","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-13-12-354Z","status":"grouped"}
{"id":"claim:tam/tenselessness-and-time-reference--ainu-verbs-do-not-inflect-for-tense-so","revision":1,"topic":"topic:tam/tenselessness-and-time-reference","topics":["topic:tam/tenselessness-and-time-reference","topic:tam/tenselessness-and-time-reference--tense-absence"],"statement":{"en":"Ainu verbs do not inflect for tense, so whether a relative clause refers to present/future or past action is determined by context.","ja":"アイヌ語の動詞は時制による変化を行わないので、連体修飾節が現在・未来か過去かは文脈によって判断する。"},"type":"form-function","scope":{"doculects":["doculect:ainu"],"quantifier":"all","modality":"actual","conditions":[]},"forms":[],"statements":[{"id":"stmt:sato2008@gemini-3-flash-preview/l0186-02","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-13-12-354Z","status":"grouped"}
{"id":"claim:tam/tenselessness-and-time-reference--the-marking-of-past-present-and-future-is","revision":1,"topic":"topic:tam/tenselessness-and-time-reference","topics":["topic:tam/tenselessness-and-time-reference","topic:tam/tenselessness-and-time-reference--tense-absence"],"statement":{"en":"The marking of past, present, and future is not obligatory in Ainu, so tense often cannot be determined from the verb form alone.","ja":"アイヌ語では過去，現在，未来の表示は義務的ではなく，動詞の形を見ただけでは時間的判断がつかない場合が少なくない。"},"type":"absence","scope":{"doculects":["doculect:hokkaido"],"quantifier":"generic","modality":"actual","conditions":[]},"forms":[],"statements":[{"id":"stmt:sato2008@gemini-3-flash-preview/l0201-03","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-13-12-354Z","status":"grouped"}
{"id":"claim:tam/tenselessness-and-time-reference--the-ainu-verbal-system-does-not-possess-any","revision":1,"topic":"topic:tam/tenselessness-and-time-reference","topics":["topic:tam/tenselessness-and-time-reference","topic:tam/tenselessness-and-time-reference--tense-absence"],"statement":{"en":"The Ainu verbal system does not possess any affix marking tense, and makes no distinction comparable to present versus past in English.","ja":"アイヌ語の動詞体系には時制を表示する接辞は一切存在せず、英語のような現在と過去の区別も持たない。"},"type":"absence","scope":{"doculects":["doculect:ainu"],"quantifier":"none","modality":"actual","conditions":[]},"forms":[],"statements":[{"id":"stmt:shibatani1990@gemini-3-flash-preview/l0048-05","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-13-12-354Z","status":"grouped"}
{"id":"claim:tam/tenselessness-and-time-reference--the-simple-verb-form-in-ainu-refers-to","revision":1,"topic":"topic:tam/tenselessness-and-time-reference","topics":["topic:tam/tenselessness-and-time-reference","topic:tam/tenselessness-and-time-reference--tense-absence"],"statement":{"en":"The simple verb form in Ainu refers to events irrespective of their time in relation to the time of utterance.","ja":"アイヌ語の単純動詞形は、発話時との時間的関係に関わりなく事象を指示する。"},"type":"form-function","scope":{"doculects":["doculect:ainu"],"quantifier":"all","modality":"actual","conditions":[]},"forms":[],"statements":[{"id":"stmt:shibatani1990@gemini-3-flash-preview/l0048-06","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-13-12-354Z","status":"grouped"}
{"id":"claim:tam/tenselessness-and-time-reference--kindaichi-asserts-that-the-ainu-language-makes-no","revision":1,"topic":"topic:tam/tenselessness-and-time-reference","topics":["topic:tam/tenselessness-and-time-reference","topic:tam/tenselessness-and-time-reference--tenselessness-debate"],"statement":{"en":"Kindaichi asserts that the Ainu language makes no temporal distinctions, expressing everything in the past tense.","ja":"金田一は、アイヌ語は時間的区別を行わず、すべてを過去形で表現すると述べている。"},"type":"analysis","scope":{"doculects":["doculect:ainu"],"quantifier":"all","modality":"actual","conditions":[]},"forms":[],"statements":[{"id":"stmt:refsing1986@gemini-3-flash-preview/l0032-05","stance":"reports"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-13-12-354Z","status":"grouped"}
{"id":"claim:tam/tenselessness-and-time-reference--chiri-argues-for-sakhalin-ainu-that-only-non","revision":1,"topic":"topic:tam/tenselessness-and-time-reference","topics":["topic:tam/tenselessness-and-time-reference","topic:tam/tenselessness-and-time-reference--tenselessness-debate"],"statement":{"en":"Chiri argues for Sakhalin Ainu that only non-stative verbs require translation as past tense when isolated in direct mood, while stative verbs should be translated as present progressive.","ja":"知里は樺太方言において、直接法で単独で述語となる場合、非持続態動詞のみが過去形と訳されるべきであり、持続態の動詞は現在進行形（〜ている）と訳されるべきであると指摘している。"},"type":"analysis","scope":{"doculects":["doculect:sakhalin"],"quantifier":"all","modality":"actual","conditions":["isolated predicate in direct mood"]},"forms":[],"statements":[{"id":"stmt:refsing1986@gemini-3-flash-preview/l0032-06","stance":"reports"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-13-12-354Z","status":"grouped"}
{"id":"claim:tam/tenselessness-and-time-reference--in-terms-of-tense-the-auxiliary-verbs-a","revision":1,"topic":"topic:tam/tenselessness-and-time-reference","topics":["topic:tam/tenselessness-and-time-reference","topic:tam/tenselessness-and-time-reference--tenselessness-debate"],"statement":{"en":"In terms of tense, the auxiliary verbs a and aan basically express past tense.","ja":"テンスの観点において、助動詞aおよびaanは基本的に過去を表す。"},"type":"form-function","scope":{"doculects":["doculect:hokkaido/southwest/saru","doculect:hokkaido/chitose"],"quantifier":"generic","modality":"actual","conditions":[]},"forms":["a","aan"],"statements":[{"id":"stmt:yoshikawa2022@handbook-epub/l0128-06","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-13-12-354Z","status":"grouped"}

{"id":"claim:prosody/lexical-contrastive-accent-minimal-pairs--pitch-accent-minimal-pairs-exist-ainu","revision":1,"topic":"topic:prosody/lexical-contrastive-accent-minimal-pairs","topics":["topic:prosody/lexical-contrastive-accent-minimal-pairs","topic:prosody/lexical-contrastive-accent-minimal-pairs--minimal-pairs"],"statement":{"en":"Across Ainu dialects with pitch accent, a small number of minimal pairs contrast solely in the position of pitch accent.","ja":"アイヌ語において、ピッチアクセントの位置のみで対立するごく少数の最小対が存在する。"},"type":"existence","scope":{"doculects":["doculect:ainu"],"quantifier":"few","modality":"factual","conditions":[]},"forms":["nisap","utur"],"statements":[{"id":"stmt:shiraishi2022@handbook-epub/l0086-07","stance":"reports"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-06-38-590Z","status":"grouped"}
{"id":"claim:prosody/lexical-contrastive-accent-minimal-pairs--few-minimal-pairs-accent-shizunai","revision":1,"topic":"topic:prosody/lexical-contrastive-accent-minimal-pairs","topics":["topic:prosody/lexical-contrastive-accent-minimal-pairs","topic:prosody/lexical-contrastive-accent-minimal-pairs--functional-load"],"statement":{"en":"In Shizunai Ainu, only a small number of minimal pairs are distinguished solely by accent.","ja":"静内アイヌ語において、アクセントのみによって意味が弁別される最小対はごくわずかしか存在しない。"},"type":"frequency","scope":{"doculects":["doculect:hokkaido/southwest/shizunai"],"quantifier":"few","modality":"factual","conditions":[]},"forms":[],"statements":[{"id":"stmt:refsing1986@gemini-3-flash-preview/l0068-01","stance":"asserts"}],"relations":[{"kind":"refines","claim":"claim:prosody/lexical-contrastive-accent-minimal-pairs--pitch-accent-minimal-pairs-exist-ainu","differs_in":"dialect","note":"Applies the general claim about minimal pairs specifically to Shizunai Ainu functional load"}],"grouped_by":"act:group/2026-09-10T15-06-38-590Z","status":"grouped"}
{"id":"claim:prosody/lexical-contrastive-accent-minimal-pairs--irregular-initial-accent-creates-minimal-pairs-saru","revision":1,"topic":"topic:prosody/lexical-contrastive-accent-minimal-pairs","topics":["topic:prosody/lexical-contrastive-accent-minimal-pairs","topic:prosody/lexical-contrastive-accent-minimal-pairs--minimal-pairs"],"statement":{"en":"In Saru Ainu, a fixed set of words have irregular accent on an open initial syllable, creating minimal pairs distinguished solely by accent position.","ja":"沙流アイヌ語では、第1音節が開音節であるにもかかわらず高音となる不規則な語が一定数存在し、アクセント位置のみで区別される最小対を形成する。"},"type":"existence","scope":{"doculects":["doculect:hokkaido/southwest/saru"],"quantifier":"some","modality":"factual","conditions":[]},"forms":["cápe","húci","húra","húre","káni","kéra","kúsuwep","míci","mína","nína","niná","nísap"],"statements":[{"id":"stmt:nakagawa2024@gemini-3-flash-preview/l0049-02","stance":"asserts"}],"relations":[{"kind":"supports","claim":"claim:prosody/lexical-contrastive-accent-minimal-pairs--pitch-accent-minimal-pairs-exist-ainu","differs_in":null,"note":"Identifies the lexical source of pitch-accent minimal pairs in Saru"}],"grouped_by":"act:group/2026-09-10T15-06-38-590Z","status":"grouped"}
{"id":"claim:prosody/lexical-contrastive-accent-minimal-pairs--accent-contrast-teta-hokkaido","revision":1,"topic":"topic:prosody/lexical-contrastive-accent-minimal-pairs","topics":["topic:prosody/lexical-contrastive-accent-minimal-pairs","topic:prosody/lexical-contrastive-accent-minimal-pairs--minimal-pairs"],"statement":{"en":"In Hokkaido Ainu, the adverb tetá 'the other day' contrasts in accent with téta 'here'.","ja":"北海道アイヌ語において、「この間」を意味する副詞 tetá は「ここに」を意味する téta とアクセントで対立する。"},"type":"existence","scope":{"doculects":["doculect:hokkaido"],"quantifier":"exists","modality":"factual","conditions":[]},"forms":["tetá","téta"],"statements":[{"id":"stmt:sato2008@gemini-3-flash-preview/l0203-07","stance":"asserts"}],"relations":[{"kind":"supports","claim":"claim:prosody/lexical-contrastive-accent-minimal-pairs--pitch-accent-minimal-pairs-exist-ainu","differs_in":null,"note":"Provides an attested minimal pair contrasting téta and tetá"}],"grouped_by":"act:group/2026-09-10T15-06-38-590Z","status":"grouped"}

{"id":"claim:sources/typological-profile--head-marking-typology","revision":1,"topic":"topic:sources/typological-profile","topics":["topic:sources/typological-profile","topic:sources/typological-profile--head-marking"],"statement":{"en":"Ainu belongs typologically to the predominantly head-marking language type.","ja":"アイヌ語は類型論的に主として主要部標示型の言語に分類される。"},"type":"analysis","scope":{"doculects":["doculect:ainu"],"quantifier":"all","modality":"asserted","conditions":[]},"forms":[],"statements":[{"id":"stmt:bugaeva2016@pdftotext-pieces/l0002-09","stance":"asserts"},{"id":"stmt:sato2025a@pdftotext-pieces/l0007-02","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-06-38-590Z","status":"grouped"}
{"id":"claim:sources/typological-profile--classical-ainu-polysynthetic-prominence","revision":1,"topic":"topic:sources/typological-profile","topics":["topic:sources/typological-profile","topic:sources/typological-profile--polysynthesis"],"statement":{"en":"Polysynthetic characteristics are more prominent in Classical Ainu than in the colloquial dialects.","ja":"複統合的な性質は口語方言よりも古典アイヌ語においてより顕著に見られる。"},"type":"variation","scope":{"doculects":["doculect:ainu"],"quantifier":"all","modality":"asserted","conditions":[]},"forms":[],"statements":[{"id":"stmt:majewicz2022@handbook-epub/l0025-05","stance":"reports"},{"id":"stmt:shibatani1990@gemini-3-flash-preview/l0011-10","stance":"asserts"},{"id":"stmt:shibatani1990@gemini-3-flash-preview/l0017-10","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-06-38-590Z","status":"grouped"}
{"id":"claim:sources/typological-profile--the-self-designation-ainu-means-person","revision":1,"topic":"topic:sources/typological-profile","topics":["topic:sources/typological-profile"],"statement":{"en":"The self-designation ainu means 'person'.","ja":"自称 ainu は「人」を意味する。"},"type":"form-function","scope":{"doculects":["doculect:ainu"],"quantifier":"unstated","modality":"actual","conditions":[]},"forms":["ainu"],"statements":[{"id":"stmt:bugaeva2012@gemini-3-flash-preview/l0002-01","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-06-38-590Z","status":"grouped"}
{"id":"claim:sources/typological-profile--the-three-primary-dialect-divisions-of-ainu-are","revision":1,"topic":"topic:sources/typological-profile","topics":["topic:sources/typological-profile"],"statement":{"en":"The three primary dialect divisions of Ainu are Hokkaido, Sakhalin, and the Kurile Islands.","ja":"アイヌ語の三つの大区分は地理的なものであり、北海道、樺太、千島の方言に分かれる。"},"type":"variation","scope":{"doculects":["doculect:ainu","doculect:hokkaido","doculect:sakhalin","doculect:kuril"],"quantifier":"all","modality":"actual","conditions":[]},"forms":[],"statements":[{"id":"stmt:bugaeva2012@gemini-3-flash-preview/l0002-05","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-06-38-590Z","status":"grouped"}
{"id":"claim:sources/typological-profile--in-complex-sentences-ainu-exhibits-predominantly-dependent-marking","revision":1,"topic":"topic:sources/typological-profile","topics":["topic:sources/typological-profile"],"statement":{"en":"In complex sentences, Ainu exhibits predominantly dependent-marking patterns, as in relative clauses and most subordinate clauses.","ja":"複文においてアイヌ語は、関係節や大部分の従属節に見られるように、主に主従構造における従属部標示のパターンを示す。"},"type":"analysis","scope":{"doculects":["doculect:ainu"],"quantifier":"usually","modality":"actual","conditions":[]},"forms":[],"statements":[{"id":"stmt:bugaeva2022@handbook-epub/l0007-01","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-06-38-590Z","status":"grouped"}
{"id":"claim:sources/typological-profile--ainu-has-a-relatively-small-phonemic-inventory-compared","revision":1,"topic":"topic:sources/typological-profile","topics":["topic:sources/typological-profile"],"statement":{"en":"Ainu has a relatively small phonemic inventory compared to the world's languages, and its syllable structure is not complex.","ja":"アイヌ語は世界の言語の中でも比較的音素の数が少なく、音節構造も複雑ではない。"},"type":"other","scope":{"doculects":["doculect:ainu"],"quantifier":"all","modality":"actual","conditions":[]},"forms":[],"statements":[{"id":"stmt:nakagawa2024@gemini-3-flash-preview/l0023-01","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-06-38-590Z","status":"grouped"}
{"id":"claim:sources/typological-profile--the-syntactic-process-of-head-movement-is-not","revision":1,"topic":"topic:sources/typological-profile","topics":["topic:sources/typological-profile"],"statement":{"en":"The syntactic process of head movement is not essential in describing the grammatical structure of Ainu.","ja":"アイヌ語の文法構造を記述するにあたって、主要部移動のプロセスは本質的ではない。"},"type":"analysis","scope":{"doculects":["doculect:ainu"],"quantifier":"generic","modality":"actual","conditions":[]},"forms":[],"statements":[{"id":"stmt:sato2025a@pdftotext-pieces/l0007-03","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-06-38-590Z","status":"grouped"}
{"id":"claim:sources/typological-profile--ainu-displays-a-mixed-but-basically-tripartite-alignment","revision":1,"topic":"topic:sources/typological-profile","topics":["topic:sources/typological-profile","topic:sources/typological-profile--alignment"],"statement":{"en":"Ainu displays a mixed, but basically tripartite, alignment system.","ja":"アイヌ語は混合的であるが基本的には三分子配列のアライメントをもつ。"},"type":"analysis","scope":{"doculects":["doculect:ainu"],"quantifier":"unstated","modality":"actual","conditions":[]},"forms":[],"statements":[{"id":"stmt:bugaeva2012@gemini-3-flash-preview/l0002-03","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-06-38-590Z","status":"grouped"}
{"id":"claim:sources/typological-profile--ainu-is-polysynthetic-agglutinating-and-predominantly-head-marking","revision":1,"topic":"topic:sources/typological-profile","topics":["topic:sources/typological-profile","topic:sources/typological-profile--head-marking"],"statement":{"en":"Ainu is polysynthetic, agglutinating, and predominantly head-marking, with nouns and personal pronouns lacking case inflection.","ja":"アイヌ語は抱合的・膠着語的であり、主に主要部標示言語であって、名詞や人称代名詞は格変化しない。"},"type":"other","scope":{"doculects":["doculect:ainu"],"quantifier":"all","modality":"actual","conditions":[]},"forms":[],"statements":[{"id":"stmt:bugaeva2008@pdftotext-pieces/l0003-02","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-06-38-590Z","status":"grouped"}
{"id":"claim:sources/typological-profile--ainu-is-predominantly-head-marking-and-prefixing","revision":1,"topic":"topic:sources/typological-profile","topics":["topic:sources/typological-profile","topic:sources/typological-profile--head-marking"],"statement":{"en":"Ainu is predominantly head-marking and prefixing.","ja":"アイヌ語は主に主要部標示であり、接頭辞を用いる。"},"type":"analysis","scope":{"doculects":["doculect:ainu"],"quantifier":"unstated","modality":"actual","conditions":[]},"forms":[],"statements":[{"id":"stmt:bugaeva2012@gemini-3-flash-preview/l0002-04","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-06-38-590Z","status":"grouped"}
{"id":"claim:sources/typological-profile--ainu-is-head-marking-both-at-the-clause","revision":1,"topic":"topic:sources/typological-profile","topics":["topic:sources/typological-profile","topic:sources/typological-profile--head-marking"],"statement":{"en":"Ainu is head-marking both at the clause level and at the phrase level.","ja":"アイヌ語は節レベルと句レベルの双方において主要部標示言語である。"},"type":"analysis","scope":{"doculects":["doculect:ainu"],"quantifier":"unstated","modality":"actual","conditions":[]},"forms":[],"statements":[{"id":"stmt:bugaeva2022@handbook-epub/l0002-13","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-06-38-590Z","status":"grouped"}
{"id":"claim:sources/typological-profile--most-key-grammatical-features-in-ainu-are-either","revision":1,"topic":"topic:sources/typological-profile","topics":["topic:sources/typological-profile","topic:sources/typological-profile--head-marking"],"statement":{"en":"Most key grammatical features in Ainu are either directly or indirectly related to head-marking.","ja":"アイヌ語における主要な特徴の多くは、直接的または間接的に主要部標示と関連している。"},"type":"analysis","scope":{"doculects":["doculect:ainu"],"quantifier":"unstated","modality":"actual","conditions":[]},"forms":[],"statements":[{"id":"stmt:bugaeva2022@handbook-epub/l0002-14","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-06-38-590Z","status":"grouped"}
{"id":"claim:sources/typological-profile--some-adverbial-clauses-are-head-marked-in-that","revision":1,"topic":"topic:sources/typological-profile","topics":["topic:sources/typological-profile","topic:sources/typological-profile--head-marking"],"statement":{"en":"Some adverbial clauses are head-marked, in that a conjunctive element can follow sentence-final intonation and be uttered with the following sentence or verb phrase.","ja":"一部の副詞節は主要部標示であり、接続要素が文末イントネーションの後に現れて後続の文または動詞句とともに発話されることがある。"},"type":"distribution","scope":{"doculects":["doculect:ainu"],"quantifier":"exists","modality":"possible","conditions":[]},"forms":[],"statements":[{"id":"stmt:bugaeva2022@handbook-epub/l0007-02","stance":"reports"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-06-38-590Z","status":"grouped"}
{"id":"claim:sources/typological-profile--in-evidential-noun-complement-clauses-the-complementizer-markers","revision":1,"topic":"topic:sources/typological-profile","topics":["topic:sources/typological-profile","topic:sources/typological-profile--head-marking"],"statement":{"en":"In evidential noun complement clauses, the complementizer markers belong to the main clause while leaving the subordinate clause intact, exhibiting a head-marking pattern.","ja":"証拠性の名詞補文節において、補文標識は主節に属し、従属節は無傷のまま残されており、これは主要部標示型言語の特徴を示している。"},"type":"analysis","scope":{"doculects":["doculect:ainu"],"quantifier":"all","modality":"actual","conditions":[]},"forms":[],"statements":[{"id":"stmt:bugaeva2022@handbook-epub/l0007-07","stance":"proposes"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-06-38-590Z","status":"grouped"}
{"id":"claim:sources/typological-profile--ainu-is-predominantly-head-marking-at-the-clause","revision":1,"topic":"topic:sources/typological-profile","topics":["topic:sources/typological-profile","topic:sources/typological-profile--head-marking"],"statement":{"en":"Ainu is predominantly head-marking at the clause and noun phrase levels and partially at the sentence level, distinguishing it from predominantly dependent-marking languages of Northeast Asia.","ja":"アイヌ語は節レベルおよび名詞句レベルで主に主要部標示であり、文レベルでも部分的に主要部標示であって、主に従属部標示である北東アジアの諸言語とは異なっている。"},"type":"analysis","scope":{"doculects":["doculect:ainu"],"quantifier":"generic","modality":"actual","conditions":[]},"forms":[],"statements":[{"id":"stmt:bugaeva2022@handbook-epub/l0008-01","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-06-38-590Z","status":"grouped"}
{"id":"claim:sources/typological-profile--in-ainu-the-possible-arguments-subject-and-object","revision":1,"topic":"topic:sources/typological-profile","topics":["topic:sources/typological-profile","topic:sources/typological-profile--head-marking"],"statement":{"en":"In Ainu, the possible arguments (subject and object) of a verb are marked with personal affixes on the verb, which obligatorily marks arguments on the predicate as the clausal head.","ja":"アイヌ語では動詞の可能な項（主語と目的語）が動詞の人称接辞によって標示され、節の主要部である述語上に義務的に項が標示される。"},"type":"analysis","scope":{"doculects":["doculect:ainu"],"quantifier":"generic","modality":"actual","conditions":[]},"forms":[],"statements":[{"id":"stmt:sato2025a@pdftotext-pieces/l0007-01","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-06-38-590Z","status":"grouped"}
{"id":"claim:sources/typological-profile--ainu-has-no-verbal-inflections","revision":1,"topic":"topic:sources/typological-profile","topics":["topic:sources/typological-profile","topic:sources/typological-profile--head-marking"],"statement":{"en":"Ainu has no verbal inflections.","ja":"アイヌ語には動詞の屈折が存在しない。"},"type":"absence","scope":{"doculects":["doculect:ainu"],"quantifier":"all","modality":"actual","conditions":[]},"forms":[],"statements":[{"id":"stmt:shibatani1990@gemini-3-flash-preview/l0012-01","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-06-38-590Z","status":"grouped"}
{"id":"claim:sources/typological-profile--ainu-is-an-agglutinating-polysynthetic-and-incorporating-language","revision":1,"topic":"topic:sources/typological-profile","topics":["topic:sources/typological-profile","topic:sources/typological-profile--polysynthesis"],"statement":{"en":"Ainu is an agglutinating, polysynthetic, and incorporating language.","ja":"アイヌ語は膠着型、複総合的、かつ抱合型の言語である。"},"type":"other","scope":{"doculects":["doculect:ainu"],"quantifier":"generic","modality":"actual","conditions":[]},"forms":[],"statements":[{"id":"stmt:bugaeva2016@pdftotext-pieces/l0002-07","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-06-38-590Z","status":"grouped"}
{"id":"claim:sources/typological-profile--ainu-is-a-polysynthetic-and-incorporating-language","revision":1,"topic":"topic:sources/typological-profile","topics":["topic:sources/typological-profile","topic:sources/typological-profile--polysynthesis"],"statement":{"en":"Ainu is a polysynthetic and incorporating language.","ja":"アイヌ語は多総合的（ポリシンセティック）かつ抱合的な言語である。"},"type":"analysis","scope":{"doculects":["doculect:ainu"],"quantifier":"unstated","modality":"actual","conditions":[]},"forms":[],"statements":[{"id":"stmt:bugaeva2022@handbook-epub/l0002-12","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-06-38-590Z","status":"grouped"}
{"id":"claim:sources/typological-profile--ainu-exhibits-polysynthesis-wherein-directional-applicative-reciprocal-and","revision":1,"topic":"topic:sources/typological-profile","topics":["topic:sources/typological-profile","topic:sources/typological-profile--polysynthesis"],"statement":{"en":"Ainu exhibits polysynthesis, wherein directional/applicative, reciprocal, and reflexive voice markers, as well as adverbs and nouns when semantically required, attach to the verb stem.","ja":"アイヌ語には、人稱接辭のほか指相・互相・再歸相、時としては副詞・名詞の類までも、意義上必要のあるときは動詞の語體に結び附いて来る所謂輯合性（poly-synthesis）が存在する。"},"type":"existence","scope":{"doculects":["doculect:ainu"],"quantifier":"generic","modality":"actual","conditions":[]},"forms":[],"statements":[{"id":"stmt:kindaichi1936@gemini-3-flash-preview/l0212-01","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-06-38-590Z","status":"grouped"}
{"id":"claim:sources/typological-profile--because-ainu-is-polysynthetic-many-ainu-loanwords-in","revision":1,"topic":"topic:sources/typological-profile","topics":["topic:sources/typological-profile","topic:sources/typological-profile--polysynthesis"],"statement":{"en":"Because Ainu is polysynthetic, many Ainu loanwords in Eastern Old Japanese are compounds or complex morphological derivations.","ja":"アイヌ語は複総合的言語であるため、東国上代日本語における多くのアイヌ語借用語は、アイヌ語内部での複合語や複雑な形態論的派生語である。"},"type":"analysis","scope":{"doculects":["doculect:ainu"],"quantifier":"generic","modality":"actual","conditions":[]},"forms":[],"statements":[{"id":"stmt:vovin2022@handbook-epub/l0037-01","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-06-38-590Z","status":"grouped"}
{"id":"claim:sources/typological-profile--ainu-exhibits-a-prevalent-occurrence-of-prefixes-which","revision":1,"topic":"topic:sources/typological-profile","topics":["topic:sources/typological-profile","topic:sources/typological-profile--sov"],"statement":{"en":"Ainu exhibits a prevalent occurrence of prefixes, which is an exceptional characteristic for an otherwise head-final SOV language.","ja":"アイヌ語には接頭辞の頻繁な生起が見られ、これは典型的なSOV言語としては異例の特徴である。"},"type":"distribution","scope":{"doculects":["doculect:ainu"],"quantifier":"generic","modality":"actual","conditions":[]},"forms":[],"statements":[{"id":"stmt:shibatani1990@gemini-3-flash-preview/l0017-04","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-06-38-590Z","status":"grouped"}
{"id":"claim:sources/typological-profile--ainu-is-an-sov-language","revision":1,"topic":"topic:sources/typological-profile","topics":["topic:sources/typological-profile","topic:sources/typological-profile--sov"],"statement":{"en":"Ainu is an SOV language.","ja":"アイヌ語はSOV型の言語である。"},"type":"analysis","scope":{"doculects":["doculect:ainu"],"quantifier":"all","modality":"actual","conditions":[]},"forms":[],"statements":[{"id":"stmt:shibatani1990@gemini-3-flash-preview/l0020-07","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-06-38-590Z","status":"grouped"}
{"id":"claim:sources/typological-profile--ainu-is-a-polysynthetic-agglutinating-predominantly-head-marking","revision":1,"topic":"topic:sources/typological-profile","topics":["topic:sources/typological-profile","topic:sources/typological-profile--typological-place"],"statement":{"en":"Ainu is a polysynthetic, agglutinating, predominantly head-marking language with only limited dependent-marking features.","ja":"アイヌ語は複統合的、膠着型で、従属部標示の要素をごくわずかしか持たない主部標示優勢の言語である。"},"type":"analysis","scope":{"doculects":["doculect:ainu"],"quantifier":"all","modality":"actual","conditions":[]},"forms":[],"statements":[{"id":"stmt:bugaeva2006@gemini-3-flash-preview/l0001-03","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-06-38-590Z","status":"grouped"}
{"id":"claim:sources/typological-profile--ainu-is-an-agglutinating-polysynthetic-and-incorporating-language-2","revision":1,"topic":"topic:sources/typological-profile","topics":["topic:sources/typological-profile","topic:sources/typological-profile--typological-place"],"statement":{"en":"Ainu is an agglutinating, polysynthetic, and incorporating language with SOV constituent order.","ja":"アイヌ語は膠着語的・複総合的・抱合的であり、SOVの語順をもつ。"},"type":"analysis","scope":{"doculects":["doculect:ainu"],"quantifier":"unstated","modality":"actual","conditions":[]},"forms":[],"statements":[{"id":"stmt:bugaeva2012@gemini-3-flash-preview/l0002-02","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-06-38-590Z","status":"grouped"}
{"id":"claim:sources/typological-profile--ainu-exhibits-sv-aov-constituent-order-and-is","revision":1,"topic":"topic:sources/typological-profile","topics":["topic:sources/typological-profile","topic:sources/typological-profile--typological-place"],"statement":{"en":"Ainu exhibits SV/AOV constituent order, and is agglutinative, head-marking, and polysynthetic.","ja":"アイヌ語は膠着的、主要部標示型、複統合的な、SV/AOV語順の言語である。"},"type":"analysis","scope":{"doculects":["doculect:hokkaido/southwest"],"quantifier":"unstated","modality":"actual","conditions":[]},"forms":[],"statements":[{"id":"stmt:bugaeva2014@pdftotext-pieces/l0002-01","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-06-38-590Z","status":"grouped"}
{"id":"claim:sources/typological-profile--unlike-the-tungusic-languages-of-sakhalin-hokkaido-ainu","revision":1,"topic":"topic:sources/typological-profile","topics":["topic:sources/typological-profile","topic:sources/typological-profile--typological-place"],"statement":{"en":"Unlike the Tungusic languages of Sakhalin, Hokkaido Ainu lacks subordinating non-finite verbal forms.","ja":"樺太のツングース系諸言語とは異なり、北海道アイヌ語には従属的な非定形動詞形式が存在しない。"},"type":"absence","scope":{"doculects":["doculect:hokkaido"],"quantifier":"all","modality":"actual","conditions":[]},"forms":[],"statements":[{"id":"stmt:bugaeva2016@pdftotext-pieces/l0015-02","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-06-38-590Z","status":"grouped"}
{"id":"claim:sources/typological-profile--the-ainu-language-differs-strikingly-from-the-languages","revision":1,"topic":"topic:sources/typological-profile","topics":["topic:sources/typological-profile","topic:sources/typological-profile--typological-place"],"statement":{"en":"The Ainu language differs strikingly from the languages of Northeast Asia, including the Altaic languages, Korean, Japanese, Nivkh, Yukaghir, and Chukchi-Kamchatkan.","ja":"アイヌ語は、いわゆるアルタイ諸語、朝鮮語、日本語、ニヴフ語、ユカギール語、チュクチ・カムチャツカ諸語を含む北東アジアの諸言語と著しく異なっている。"},"type":"analysis","scope":{"doculects":["doculect:ainu"],"quantifier":"unstated","modality":"actual","conditions":[]},"forms":[],"statements":[{"id":"stmt:bugaeva2022@handbook-epub/l0002-02","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-06-38-590Z","status":"grouped"}
{"id":"claim:sources/typological-profile--ainu-is-an-agglutinating-language","revision":1,"topic":"topic:sources/typological-profile","topics":["topic:sources/typological-profile","topic:sources/typological-profile--typological-place"],"statement":{"en":"Ainu is an agglutinating language.","ja":"アイヌ語は膠着語である。"},"type":"analysis","scope":{"doculects":["doculect:ainu"],"quantifier":"unstated","modality":"actual","conditions":[]},"forms":[],"statements":[{"id":"stmt:bugaeva2022@handbook-epub/l0002-11","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-06-38-590Z","status":"grouped"}
{"id":"claim:sources/typological-profile--grammatically-ainu-can-be-described-as-entirely-dissimilar","revision":1,"topic":"topic:sources/typological-profile","topics":["topic:sources/typological-profile","topic:sources/typological-profile--typological-place"],"statement":{"en":"Grammatically, Ainu can be described as entirely dissimilar to Japanese, in contrast to many neighboring languages in Northeast Asia that share grammatical similarities with Japanese.","ja":"周辺の諸言語が日本語と類似した文法構造を持つ中において、アイヌ語は文法的には日本語とまったく似ていない言語といえる。"},"type":"analysis","scope":{"doculects":["doculect:ainu"],"quantifier":"unstated","modality":"actual","conditions":[]},"forms":[],"statements":[{"id":"stmt:nakagawa2024@gemini-3-flash-preview/l0014-01","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-06-38-590Z","status":"grouped"}
{"id":"claim:sources/typological-profile--ainu-is-characterized-by-sov-basic-word-order","revision":1,"topic":"topic:sources/typological-profile","topics":["topic:sources/typological-profile","topic:sources/typological-profile--typological-place"],"statement":{"en":"Ainu is characterized by SOV basic word order, predominance of postpositions, person marking on verbs and nouns, a rich valency-changing system, and polysynthesis manifested by productive noun incorporation.","ja":"アイヌ語は、SOV基本語順、後置詞優勢、動詞および名詞における人称標示、豊かな結合価変化体系、そして生産的な抱合に示される複統合性を特徴とする。"},"type":"analysis","scope":{"doculects":["doculect:ainu"],"quantifier":"generic","modality":"actual","conditions":[]},"forms":[],"statements":[{"id":"stmt:nam2021@pdftotext-pieces/l0001-01","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-06-38-590Z","status":"grouped"}
{"id":"claim:sources/typological-profile--ainu-extensively-uses-prefixation-a-typological-feature-uncommon","revision":1,"topic":"topic:sources/typological-profile","topics":["topic:sources/typological-profile","topic:sources/typological-profile--unusual-features"],"statement":{"en":"Ainu extensively uses prefixation, a typological feature uncommon in the languages of the North Pacific Rim.","ja":"アイヌ語は接頭辞を広汎に用いるが、これは北太平洋沿岸地域の言語では極めて珍しい類型論的特徴である。"},"type":"distribution","scope":{"doculects":["doculect:ainu"],"quantifier":"unstated","modality":"actual","conditions":[]},"forms":[],"statements":[{"id":"stmt:bugaeva2012@gemini-3-flash-preview/l0003-01","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-06-38-590Z","status":"grouped"}
{"id":"claim:sources/typological-profile--ainu-employs-more-prefixation-than-suffixation","revision":1,"topic":"topic:sources/typological-profile","topics":["topic:sources/typological-profile","topic:sources/typological-profile--unusual-features"],"statement":{"en":"Ainu employs more prefixation than suffixation.","ja":"アイヌ語は接尾辞化よりも接頭辞化を多く用いる。"},"type":"other","scope":{"doculects":["doculect:ainu"],"quantifier":"generic","modality":"actual","conditions":[]},"forms":[],"statements":[{"id":"stmt:bugaeva2016@pdftotext-pieces/l0002-08","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-06-38-590Z","status":"grouped"}

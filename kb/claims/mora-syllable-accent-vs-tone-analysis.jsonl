{"id":"claim:prosody/mora-syllable-accent-vs-tone-analysis--rachishka-pitch-accent-not-distinctive","revision":1,"topic":"topic:prosody/mora-syllable-accent-vs-tone-analysis","topics":["topic:prosody/mora-syllable-accent-vs-tone-analysis","topic:prosody/mora-syllable-accent-vs-tone-analysis--dialect-split"],"statement":{"en":"In the Rachishka dialect of Sakhalin Ainu, pitch accent is perceptible but non-distinctive.","ja":"樺太アイヌ語ラチシカ方言において、ピッチアクセントは識別可能であるが弁別的ではない。"},"type":"other","scope":{"doculects":["doculect:sakhalin_rachishka"],"quantifier":"unstated","modality":"asserting","conditions":[]},"forms":[],"statements":[{"id":"stmt:bugaeva2012@gemini-3-flash-preview/l0022-01","stance":"reports"}],"relations":[{"kind":"contrasts","claim":"claim:prosody/mora-syllable-accent-vs-tone-analysis--ainu-accent-is-pitch-accent","differs_in":"dialect","note":"Pitch accent is phonologically distinctive in Hokkaido varieties, but non-distinctive in Sakhalin Rachishka."}],"grouped_by":"act:group/2026-09-10T15-06-38-590Z","status":"grouped"}
{"id":"claim:prosody/mora-syllable-accent-vs-tone-analysis--sakhalin-ainu-mora-inventory","revision":1,"topic":"topic:prosody/mora-syllable-accent-vs-tone-analysis","topics":["topic:prosody/mora-syllable-accent-vs-tone-analysis","topic:prosody/mora-syllable-accent-vs-tone-analysis--mora-syllable"],"statement":{"en":"Sakhalin Ainu is a mora-timed language with three single-mora types: CV, V, and coda consonant (C*).","ja":"樺太アイヌ語は日本語に類似したモーラ型言語であり、単一モーラにはCV、V、C*の3種が存在する。"},"type":"analysis","scope":{"doculects":["doculect:sakhalin"],"quantifier":"all","modality":"asserting","conditions":[]},"forms":[],"statements":[{"id":"stmt:itabashi2001@pdftotext-pieces/l0004-04","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-06-38-590Z","status":"grouped"}
{"id":"claim:prosody/mora-syllable-accent-vs-tone-analysis--sakhalin-accentable-minimal-size","revision":1,"topic":"topic:prosody/mora-syllable-accent-vs-tone-analysis","topics":["topic:prosody/mora-syllable-accent-vs-tone-analysis","topic:prosody/mora-syllable-accent-vs-tone-analysis--placement"],"statement":{"en":"In Sakhalin Ainu, the minimal independent form that carries accent consists of at least two morae.","ja":"樺太アイヌ語においてアクセントを担う最小の自立形式は2モーラ以上である。"},"type":"distribution","scope":{"doculects":["doculect:sakhalin"],"quantifier":"all","modality":"asserting","conditions":[]},"forms":[],"statements":[{"id":"stmt:itabashi2001@pdftotext-pieces/l0004-05","stance":"reports"}],"relations":[{"kind":"supports","claim":"claim:prosody/mora-syllable-accent-vs-tone-analysis--sakhalin-ainu-mora-inventory","differs_in":null,"note":"Minimal accent-bearing form of two morae supports the moraic analysis of Sakhalin Ainu phonology."}],"grouped_by":"act:group/2026-09-10T15-06-38-590Z","status":"grouped"}
{"id":"claim:prosody/mora-syllable-accent-vs-tone-analysis--iambic-foot-accent-placement","revision":1,"topic":"topic:prosody/mora-syllable-accent-vs-tone-analysis","topics":["topic:prosody/mora-syllable-accent-vs-tone-analysis","topic:prosody/mora-syllable-accent-vs-tone-analysis--placement"],"statement":{"en":"Feet in Ainu are iambic, causing an initial light syllable (C)V to form a foot with the following syllable and place accent on the second syllable.","ja":"アイヌ語の音脚はジャンブ（iambic）であり、語頭の軽音節(C)Vは後続音節と音脚を形成して第2音節にアクセントが置かれる。"},"type":"analysis","scope":{"doculects":["doculect:ainu"],"quantifier":"all","modality":"asserting","conditions":[]},"forms":[],"statements":[{"id":"stmt:satoni2022@handbook-epub/l0104-12","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-06-38-590Z","status":"grouped"}
{"id":"claim:prosody/mora-syllable-accent-vs-tone-analysis--kuril-pitch-accent-vowel-length","revision":1,"topic":"topic:prosody/mora-syllable-accent-vs-tone-analysis","topics":["topic:prosody/mora-syllable-accent-vs-tone-analysis","topic:prosody/mora-syllable-accent-vs-tone-analysis--typology"],"statement":{"en":"Kuril Ainu had a pitch accent system and possibly distinctive vowel length.","ja":"千島アイヌ語のアクセントはピッチアクセントであり、母音の長短も弁別的であった可能性がある。"},"type":"analysis","scope":{"doculects":["doculect:kuril"],"quantifier":"unstated","modality":"hypothetical","conditions":[]},"forms":[],"statements":[{"id":"stmt:itabashi2001@pdftotext-pieces/l0006-03","stance":"proposes"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-06-38-590Z","status":"grouped"}
{"id":"claim:prosody/mora-syllable-accent-vs-tone-analysis--ainu-accent-is-pitch-accent","revision":1,"topic":"topic:prosody/mora-syllable-accent-vs-tone-analysis","topics":["topic:prosody/mora-syllable-accent-vs-tone-analysis","topic:prosody/mora-syllable-accent-vs-tone-analysis--typology"],"statement":{"en":"Ainu accent is a pitch accent rather than a stress accent, with accented syllables realized with high pitch.","ja":"アイヌ語のアクセントは強さアクセントではなく高さ（ピッチ）アクセントであり、アクセント音節は高く発音される。"},"type":"other","scope":{"doculects":["doculect:ainu"],"quantifier":"all","modality":"asserting","conditions":[]},"forms":[],"statements":[{"id":"stmt:sato2008@gemini-3-flash-preview/l0031-07","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-06-38-590Z","status":"grouped"}

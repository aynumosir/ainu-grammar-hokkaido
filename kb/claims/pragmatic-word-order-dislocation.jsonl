{"id":"claim:discourse/pragmatic-word-order-dislocation--ainu-word-order-free-pragmatic","revision":1,"topic":"topic:discourse/pragmatic-word-order-dislocation","topics":["topic:discourse/pragmatic-word-order-dislocation","topic:discourse/pragmatic-word-order-dislocation--overview"],"statement":{"en":"Word order in Ainu is generally free and pragmatically motivated.","ja":"アイヌ語の語順は一般に自由であり、語用論的に動機づけられている。"},"type":"distribution","scope":{"doculects":["doculect:ainu"],"quantifier":"generally","modality":"descriptive","conditions":[]},"forms":[],"statements":[{"id":"stmt:bugaeva2015@gemini-3-flash-preview/l0016-02","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-26T08-31-28-856Z","status":"grouped"}
{"id":"claim:discourse/pragmatic-word-order-dislocation--right-dislocation-ki-light-verb","revision":1,"topic":"topic:discourse/pragmatic-word-order-dislocation","topics":["topic:discourse/pragmatic-word-order-dislocation","topic:discourse/pragmatic-word-order-dislocation--right-dislocation"],"statement":{"en":"Ainu has a right-dislocation construction in which a nounless verb phrase is produced first and its subject or object is subsequently disambiguated by placing it as an argument of the transitive light verb ki 'do'.","ja":"アイヌ語では名詞句を伴わない動詞句を先に発話し、その主語または目的語を後から他動詞的軽動詞ki「する」の項として後置する右方転位構文が存在する。"},"type":"distribution","scope":{"doculects":["doculect:ainu"],"quantifier":"existential","modality":"descriptive","conditions":[]},"forms":["ki"],"statements":[{"id":"stmt:bugaeva2022@handbook-epub/l0005-11","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-26T08-31-28-856Z","status":"grouped"}
{"id":"claim:discourse/pragmatic-word-order-dislocation--osv-inversion-classical-colloquial","revision":1,"topic":"topic:discourse/pragmatic-word-order-dislocation","topics":["topic:discourse/pragmatic-word-order-dislocation","topic:discourse/pragmatic-word-order-dislocation--topicalization"],"statement":{"en":"When context or semantics prevents misinterpretation, inversion of basic SOV order to OSV occurs in both Classical and colloquial Ainu.","ja":"文脈や意味論が誤解を防ぐ場合、基本語順SOVからOSVへの倒置が古典アイヌ語でも口語アイヌ語でも生じる。"},"type":"distribution","scope":{"doculects":["doculect:ainu"],"quantifier":"universal","modality":"descriptive","conditions":["context or semantics prevents misinterpretation"]},"forms":[],"statements":[{"id":"stmt:shibatani1990@gemini-3-flash-preview/l0020-09","stance":"asserts"}],"relations":[{"kind":"supports","claim":"claim:discourse/pragmatic-word-order-dislocation--ainu-word-order-free-pragmatic","differs_in":null,"note":"OSV inversion under pragmatic/semantic conditions is a specific instance of the general claim that Ainu word order is free and pragmatically motivated."}],"grouped_by":"act:group/2026-09-26T08-31-28-856Z","status":"grouped"}

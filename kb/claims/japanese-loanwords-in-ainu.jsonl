{"id":"claim:contact/japanese-loanwords-in-ainu--japanese-contact-has-exerted-linguistic-influence-on-ainu","revision":1,"topic":"topic:contact/japanese-loanwords-in-ainu","topics":["topic:contact/japanese-loanwords-in-ainu","topic:contact/japanese-loanwords-in-ainu--overview"],"statement":{"en":"Japanese contact has exerted linguistic influence on Ainu not only in loanwords, but also in phonology, and to some extent in grammar and syntax.","ja":"日本語との接触は借用語の領域のみならず、音韻論やある程度は文法・統語論においてもアイヌ語に言語的影響を与えている。"},"type":"other","scope":{"doculects":["doculect:ainu"],"quantifier":"generic","modality":"actual","conditions":[]},"forms":[],"statements":[{"id":"stmt:refsing1986@gemini-3-flash-preview/l0050-05","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-13-12-354Z","status":"grouped"}

{"id":"claim:contact/japanese-loanwords-in-ainu--nasal-insertion-voiced-consonants","revision":1,"topic":"topic:contact/japanese-loanwords-in-ainu","topics":["topic:contact/japanese-loanwords-in-ainu","topic:contact/japanese-loanwords-in-ainu--phonological-adaptation"],"statement":{"en":"Japanese words with voiced consonants are typically borrowed into Ainu with an inserted nasal preceding the consonant.","ja":"アイヌ語が日本語の濁音を含む語を借用する際、通常その子音の前に鼻音 n が挿入される。"},"type":"alternation","scope":{"doculects":["doculect:ainu"],"quantifier":"most","modality":"asserted","conditions":[]},"forms":["konkane","sirokane"],"statements":[{"id":"stmt:sato2008@gemini-3-flash-preview/l0313-04","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-13-12-354Z","status":"grouped"}
{"id":"claim:contact/japanese-loanwords-in-ainu--konkane-nasal-from-voiced-stop","revision":1,"topic":"topic:contact/japanese-loanwords-in-ainu","topics":["topic:contact/japanese-loanwords-in-ainu","topic:contact/japanese-loanwords-in-ainu--phonological-adaptation"],"statement":{"en":"The Ainu word konkane 'gold' is a Japanese loanword whose nasal n reflects an older Japanese voiced stop /g/.","ja":"アイヌ語 konkane「金」は日本語からの借用語であり、鼻音 n は日本語の古い有声破裂音 /g/ を反映している。"},"type":"diachrony","scope":{"doculects":["doculect:ainu"],"quantifier":"specific","modality":"proposed","conditions":[]},"forms":["konkane"],"statements":[{"id":"stmt:sato2008@gemini-3-flash-preview/l0318-02","stance":"proposes"}],"relations":[{"kind":"refines","claim":"claim:contact/japanese-loanwords-in-ainu--nasal-insertion-voiced-consonants","differs_in":"scope","note":"Applies the general principle of nasal insertion before Japanese voiced consonants specifically to the borrowing of konkane."}],"grouped_by":"act:group/2026-09-10T15-13-12-354Z","status":"grouped"}
{"id":"claim:contact/japanese-loanwords-in-ainu--tohoku-prenasalization-retention","revision":1,"topic":"topic:contact/japanese-loanwords-in-ainu","topics":["topic:contact/japanese-loanwords-in-ainu","topic:contact/japanese-loanwords-in-ainu--phonological-adaptation"],"statement":{"en":"Loanwords from Tōhoku Japanese into Saru Ainu preserve prenasalized voiced consonants as nasal-stop clusters.","ja":"東北日本語から沙流アイヌ語への借用語は、前鼻音化有声音を鼻音と破裂音の連続として保持している。"},"type":"diachrony","scope":{"doculects":["doculect:hokkaido/southwest/saru"],"quantifier":"some","modality":"asserted","conditions":[]},"forms":["cikenki","antuki"],"statements":[{"id":"stmt:alonso2022@handbook-epub/l0032-04","stance":"asserts"}],"relations":[{"kind":"contrasts","claim":"claim:contact/japanese-loanwords-in-ainu--nasal-insertion-voiced-consonants","differs_in":"framework","note":"Attributes the nasal before voiced obstruents to donor dialect prenasalization in Tōhoku Japanese rather than an Ainu-internal insertion rule."}],"grouped_by":"act:group/2026-09-10T15-13-12-354Z","status":"grouped"}
{"id":"claim:contact/japanese-loanwords-in-ainu--the-word-ora-is-a-japanese-word-meaning","revision":1,"topic":"topic:contact/japanese-loanwords-in-ainu","topics":["topic:contact/japanese-loanwords-in-ainu"],"statement":{"en":"The word ora is a Japanese word meaning 'I'.","ja":"ora という語は「私」を意味する日本語である。"},"type":"diachrony","scope":{"doculects":[],"quantifier":"unstated","modality":"actual","conditions":[]},"forms":["ora"],"statements":[{"id":"stmt:shibatani1990@gemini-3-flash-preview/l0052-04","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-13-12-354Z","status":"grouped"}
{"id":"claim:contact/japanese-loanwords-in-ainu--ainu-contains-very-early-japonic-loanwords-such-as","revision":1,"topic":"topic:contact/japanese-loanwords-in-ainu","topics":["topic:contact/japanese-loanwords-in-ainu","topic:contact/japanese-loanwords-in-ainu--early-loans"],"statement":{"en":"Ainu contains very early Japonic loanwords such as sippo 'salt' and pasuy 'chopstick' that preserve Old Japanese or Pre-Old-Japanese phonological features such as the stop realization of *p and the diphthongoid sequence *uy.","ja":"アイヌ語には、*p の破裂音発音や二重母音様連鎖 *uy といった上代日本語あるいはプレ上代日本語の特徴を保持する sippo「塩」や pasuy「箸」などの極めて初期の日本語借用語が含まれている。"},"type":"diachrony","scope":{"doculects":["doculect:ainu"],"quantifier":"exists","modality":"actual","conditions":[]},"forms":["sippo","pasuy"],"statements":[{"id":"stmt:janhunen2022@handbook-epub/l0011-03","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-13-12-354Z","status":"grouped"}
{"id":"claim:contact/japanese-loanwords-in-ainu--the-verb-tondaro-is-formed-by-attaching-taro","revision":1,"topic":"topic:contact/japanese-loanwords-in-ainu","topics":["topic:contact/japanese-loanwords-in-ainu","topic:contact/japanese-loanwords-in-ainu--integration"],"statement":{"en":"The verb tondaro is formed by attaching -taro to the sound-euphonic form of the Japanese verb tobu ('to fly').","ja":"動詞 tondaro は日本語「飛ぶ」の音便形に -taro を付けてアイヌ語の動詞にしたものである。"},"type":"diachrony","scope":{"doculects":["doculect:hokkaido/southwest/saru"],"quantifier":"unstated","modality":"actual","conditions":[]},"forms":["tondaro","-taro"],"statements":[{"id":"stmt:nakagawa2024@gemini-3-flash-preview/l0566-01","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-13-12-354Z","status":"grouped"}
{"id":"claim:contact/japanese-loanwords-in-ainu--ainu-vocabulary-contains-several-unrelated-strata-including-layers","revision":1,"topic":"topic:contact/japanese-loanwords-in-ainu","topics":["topic:contact/japanese-loanwords-in-ainu","topic:contact/japanese-loanwords-in-ainu--overview"],"statement":{"en":"Ainu vocabulary contains several unrelated strata, including layers borrowed from Japanese and Nivkh.","ja":"アイヌ語の語彙には日本語やニヴフ語などの周辺言語に由来する層を含む複数の無関係な層が存在する。"},"type":"diachrony","scope":{"doculects":["doculect:ainu"],"quantifier":"unstated","modality":"actual","conditions":[]},"forms":[],"statements":[{"id":"stmt:bugaeva2012@gemini-3-flash-preview/l0003-02","stance":"reports"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-13-12-354Z","status":"grouped"}

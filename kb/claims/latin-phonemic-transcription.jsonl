{"id":"claim:sources/latin-phonemic-transcription--latin-c-represents-affricate","revision":1,"topic":"topic:sources/latin-phonemic-transcription","topics":["topic:sources/latin-phonemic-transcription","topic:sources/latin-phonemic-transcription--c-and-s"],"statement":{"en":"The Latin character c is used to represent the voiceless affricate [tʃ].","ja":"ラテン文字 c は無声破擦音 [tʃ] を表すために用いられる。"},"type":"form-function","scope":{"doculects":["doculect:ainu"],"quantifier":"universal","modality":"asserted","conditions":[]},"forms":["c"],"statements":[{"id":"stmt:bugaeva2022@handbook-epub/l0130-02","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-06-38-590Z","status":"grouped"}
{"id":"claim:sources/latin-phonemic-transcription--refrain-n-represents-nasal-vowel","revision":1,"topic":"topic:sources/latin-phonemic-transcription","topics":["topic:sources/latin-phonemic-transcription","topic:sources/latin-phonemic-transcription--correspondences"],"statement":{"en":"In the refrain n n kato, the grapheme n represents a nasalized vowel sound resembling [u].","ja":"リフレーン n n kato において、文字 n は [u] に類似した鼻音化母音を表す。"},"type":"form-function","scope":{"doculects":[],"quantifier":"specific","modality":"asserted","conditions":["in the refrain n n kato"]},"forms":["n n kato"],"statements":[{"id":"stmt:sato2008@gemini-3-flash-preview/l0303-03","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-06-38-590Z","status":"grouped"}
{"id":"claim:sources/latin-phonemic-transcription--sakhalin-h-represents-fricative-phoneme","revision":1,"topic":"topic:sources/latin-phonemic-transcription","topics":["topic:sources/latin-phonemic-transcription","topic:sources/latin-phonemic-transcription--other-romanizations"],"statement":{"en":"In the phonological description of Sakhalin Ainu, the grapheme h represents the phoneme /x/, which surfaces phonetically as [x], [ɕ], or [f] depending on the preceding vowel.","ja":"樺太アイヌ語の音韻記述において、文字 h は音素 /x/ を表し、先行母音に応じて音声的には [x]、[ɕ]、[f] などとして現れる。"},"type":"form-function","scope":{"doculects":["doculect:sakhalin"],"quantifier":"universal","modality":"asserted","conditions":[]},"forms":["h"],"statements":[{"id":"stmt:alonso2022@handbook-epub/l0035-08","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-06-38-590Z","status":"grouped"}
{"id":"claim:sources/latin-phonemic-transcription--refsing-transcription-system-origin","revision":1,"topic":"topic:sources/latin-phonemic-transcription","topics":["topic:sources/latin-phonemic-transcription","topic:sources/latin-phonemic-transcription--other-romanizations"],"statement":{"en":"Refsing's transcription adapts the conventions used by Japanese Ainuists with minor personal modifications.","ja":"レフシングの転写方式は、日本人アイヌ語研究者の慣用表記にわずかな独自の修正を加えたものに基づいている。"},"type":"other","scope":{"doculects":["doculect:hokkaido/southwest/shizunai"],"quantifier":"universal","modality":"asserted","conditions":[]},"forms":[],"statements":[{"id":"stmt:refsing1986@gemini-3-flash-preview/l0060-01","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-06-38-590Z","status":"grouped"}
{"id":"claim:sources/latin-phonemic-transcription--optional-sandhi-unmarked-in-transcription","revision":1,"topic":"topic:sources/latin-phonemic-transcription","topics":["topic:sources/latin-phonemic-transcription","topic:sources/latin-phonemic-transcription--phonemic-principle"],"statement":{"en":"Non-obligatory phonetic alternations occurring across morpheme boundaries are generally not marked in phonemic transcription.","ja":"形態素境界で生じる非義務的な音便交替は、音素的転写においては通例表記されない。"},"type":"alternation","scope":{"doculects":["doculect:hokkaido/southwest/shizunai"],"quantifier":"general","modality":"asserted","conditions":["across morpheme boundaries"]},"forms":[],"statements":[{"id":"stmt:refsing1986@gemini-3-flash-preview/l0065-04","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-06-38-590Z","status":"grouped"}

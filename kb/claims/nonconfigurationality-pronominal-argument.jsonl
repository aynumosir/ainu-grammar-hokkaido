{"id":"claim:clause/nonconfigurationality-pronominal-argument--overt-subject-noun-optional-cross-referencing-adjunct","revision":1,"topic":"topic:clause/nonconfigurationality-pronominal-argument","topics":["topic:clause/nonconfigurationality-pronominal-argument","topic:clause/nonconfigurationality-pronominal-argument--head-marking"],"statement":{"en":"An overt independent subject noun occurs in the clause as an optional element cross-referencing the third-person subject prefix φ- rather than an obligatory argument.","ja":"自立主語名詞は、3人称主格接辞 φ- と相互照応する随意要素として文中に現れており、必須の項ではない。"},"type":"analysis","scope":{"doculects":["doculect:ainu"],"quantifier":"general","modality":"factual","conditions":[]},"forms":["cise","uhuy"],"statements":[{"id":"stmt:sato2023b@pdftotext-pieces/l0005-05","stance":"asserts"}],"relations":[{"kind":"contrasts","claim":"claim:clause/nonconfigurationality-pronominal-argument--third-person-subject-nps-omitted-in-context","differs_in":"framework","note":"Satō analyzes overt nouns as appositional adjuncts to a bound prefix, whereas Bugaeva treats third-person subject omission as null-argument ellipsis of an NP."}],"grouped_by":"act:group/2026-09-26T07-52-28-143Z","status":"grouped"}
{"id":"claim:clause/nonconfigurationality-pronominal-argument--personal-pronouns-omitted-due-to-predicate-agreement","revision":1,"topic":"topic:clause/nonconfigurationality-pronominal-argument","topics":["topic:clause/nonconfigurationality-pronominal-argument","topic:clause/nonconfigurationality-pronominal-argument--null-arguments"],"statement":{"en":"Personal pronouns in subject and object positions are frequently omitted because person and number are obligatorily marked on predicates.","ja":"述語上に主語および目的語の人称と数が義務的に標示されるため、主語および目的語位置の人称代名詞は頻繁に省略される。"},"type":"distribution","scope":{"doculects":["doculect:ainu"],"quantifier":"frequently","modality":"factual","conditions":[]},"forms":[],"statements":[{"id":"stmt:bugaeva2006@gemini-3-flash-preview/l0002-04","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-26T07-52-28-143Z","status":"grouped"}
{"id":"claim:clause/nonconfigurationality-pronominal-argument--contextually-clear-objects-normally-omitted","revision":1,"topic":"topic:clause/nonconfigurationality-pronominal-argument","topics":["topic:clause/nonconfigurationality-pronominal-argument","topic:clause/nonconfigurationality-pronominal-argument--null-arguments"],"statement":{"en":"Objects that are clear from context are normally omitted, including causee objects in transitive causatives.","ja":"他動詞使役の被使役者目的語を含め、文脈上明らかな目的語は通常省略される。"},"type":"distribution","scope":{"doculects":["doculect:ainu"],"quantifier":"usually","modality":"factual","conditions":["contextually clear"]},"forms":[],"statements":[{"id":"stmt:bugaeva2014@pdftotext-pieces/l0005-03","stance":"asserts"}],"relations":[{"kind":"refines","claim":"claim:clause/nonconfigurationality-pronominal-argument--contextually-clear-arguments-not-overtly-expressed","differs_in":"scope","note":"Bugaeva 2014 focuses on object and causee omission, which instantiates the general argument ellipsis described by Nakagawa 2022."}],"grouped_by":"act:group/2026-09-26T07-52-28-143Z","status":"grouped"}
{"id":"claim:clause/nonconfigurationality-pronominal-argument--speech-act-participant-subjects-normally-omitted","revision":1,"topic":"topic:clause/nonconfigurationality-pronominal-argument","topics":["topic:clause/nonconfigurationality-pronominal-argument","topic:clause/nonconfigurationality-pronominal-argument--null-arguments"],"statement":{"en":"First-person, second-person, and indefinite-person subjects in the main clause are normally omitted because they are obligatorily marked on the verb.","ja":"主節の1人称・2人称・不定人称の主語は、動詞上に義務的に標示されるため通常省略される。"},"type":"distribution","scope":{"doculects":["doculect:ainu"],"quantifier":"usually","modality":"factual","conditions":["main clause"]},"forms":[],"statements":[{"id":"stmt:bugaeva2015@gemini-3-flash-preview/l0015-02","stance":"asserts"}],"relations":[{"kind":"refines","claim":"claim:clause/nonconfigurationality-pronominal-argument--personal-pronouns-omitted-due-to-predicate-agreement","differs_in":"scope","note":"Bugaeva 2015 restricts the agreement-based subject omission specifically to 1st, 2nd, and indefinite persons in the main clause."}],"grouped_by":"act:group/2026-09-26T07-52-28-143Z","status":"grouped"}
{"id":"claim:clause/nonconfigurationality-pronominal-argument--third-person-subject-nps-omitted-in-context","revision":1,"topic":"topic:clause/nonconfigurationality-pronominal-argument","topics":["topic:clause/nonconfigurationality-pronominal-argument","topic:clause/nonconfigurationality-pronominal-argument--null-arguments"],"statement":{"en":"Third-person subject noun phrases, which receive zero marking on the verb, can be omitted when context is sufficient.","ja":"動詞上でゼロ標示される3人称主語名詞句は、文脈が十分であれば省略できる。"},"type":"distribution","scope":{"doculects":["doculect:ainu"],"quantifier":"general","modality":"potential","conditions":["sufficient context"]},"forms":[],"statements":[{"id":"stmt:bugaeva2015@gemini-3-flash-preview/l0015-03","stance":"asserts"}],"relations":[{"kind":"refines","claim":"claim:clause/nonconfigurationality-pronominal-argument--contextually-clear-arguments-not-overtly-expressed","differs_in":"scope","note":"Bugaeva 2015 narrows contextual omission specifically to zero-marked third-person subject noun phrases."}],"grouped_by":"act:group/2026-09-26T07-52-28-143Z","status":"grouped"}
{"id":"claim:clause/nonconfigurationality-pronominal-argument--contextually-clear-arguments-not-overtly-expressed","revision":1,"topic":"topic:clause/nonconfigurationality-pronominal-argument","topics":["topic:clause/nonconfigurationality-pronominal-argument","topic:clause/nonconfigurationality-pronominal-argument--null-arguments"],"statement":{"en":"An argument noun phrase that is clear from context does not need to appear in the clause and is not represented by a pronoun.","ja":"文脈から明らかな項名詞句は文中に現れる必要がなく、代名詞でも代用されない。"},"type":"distribution","scope":{"doculects":["doculect:ainu"],"quantifier":"general","modality":"factual","conditions":["contextually clear"]},"forms":[],"statements":[{"id":"stmt:nakagawa2022pos@handbook-epub/l0095-07","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-26T07-52-28-143Z","status":"grouped"}
{"id":"claim:clause/nonconfigurationality-pronominal-argument--bare-prefixed-verb-clause-grammatically-complete","revision":1,"topic":"topic:clause/nonconfigurationality-pronominal-argument","topics":["topic:clause/nonconfigurationality-pronominal-argument","topic:clause/nonconfigurationality-pronominal-argument--null-arguments"],"statement":{"en":"A clause consisting of the null third-person subject prefix φ- and a verb is grammatically complete on its own without an independent noun.","ja":"3人称主格接辞 φ- を伴う動詞からなる節は、自立名詞がなくてもそれ自体で文法的に完全である。"},"type":"judgement","scope":{"doculects":["doculect:ainu"],"quantifier":"specific","modality":"factual","conditions":[]},"forms":["uhuy","kor","an"],"statements":[{"id":"stmt:sato2023b@pdftotext-pieces/l0005-04","stance":"asserts"}],"relations":[{"kind":"supports","claim":"claim:clause/nonconfigurationality-pronominal-argument--overt-subject-noun-optional-cross-referencing-adjunct","differs_in":"level-of-analysis","note":"The completeness of the bare verb clause provides the grammatical basis for treating the overt subject noun as an optional cross-referencing adjunct."}],"grouped_by":"act:group/2026-09-26T07-52-28-143Z","status":"grouped"}

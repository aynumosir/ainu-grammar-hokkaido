{"id":"claim:discourse/interjections-ideophones-sound-symbolism--sakhalin-interjection-taaa-discovery","revision":1,"topic":"topic:discourse/interjections-ideophones-sound-symbolism","topics":["topic:discourse/interjections-ideophones-sound-symbolism","topic:discourse/interjections-ideophones-sound-symbolism--inventory"],"statement":{"en":"In Sakhalin Ainu, the interjection ta'aa is used upon discovering or noticing something.","ja":"樺太アイヌにおいて、間投詞 ta'aa は何かを発見・認知した際に用いられる。"},"type":"form-function","scope":{"doculects":["doculect:sakhalin"],"quantifier":"specific","modality":"assertive","conditions":[]},"forms":["ta'aa"],"statements":[{"id":"stmt:murasaki2025@gemini-3-flash-preview/l0116-08","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-26T07-52-28-143Z","status":"grouped"}

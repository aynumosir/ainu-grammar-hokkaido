{"id":"claim:diachrony/hokkaido-lexical-dialectology-and-the-dialect-atlas--arpa-confined-to-hidaka","revision":1,"topic":"topic:diachrony/hokkaido-lexical-dialectology-and-the-dialect-atlas","topics":["topic:diachrony/hokkaido-lexical-dialectology-and-the-dialect-atlas","topic:diachrony/hokkaido-lexical-dialectology-and-the-dialect-atlas--ew-divide"],"statement":{"en":"The verb stem arpa 'to go' is confined to the Hidaka dialect, whereas oman is exclusively used in other regions.","ja":"動詞語幹 arpa「行く」は日高方言に限られ、その他の地域では専ら oman が用いられる。"},"type":"variation","scope":{"doculects":["doculect:hokkaido"],"quantifier":"all","modality":"asserted","conditions":[]},"forms":["arpa","oman"],"statements":[{"id":"stmt:kindaichi1936@gemini-3-flash-preview/l0106-02","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-26T07-52-28-143Z","status":"grouped"}
{"id":"claim:diachrony/hokkaido-lexical-dialectology-and-the-dialect-atlas--arpa-in-saru-dialect-group","revision":1,"topic":"topic:diachrony/hokkaido-lexical-dialectology-and-the-dialect-atlas","topics":["topic:diachrony/hokkaido-lexical-dialectology-and-the-dialect-atlas","topic:diachrony/hokkaido-lexical-dialectology-and-the-dialect-atlas--ew-divide"],"statement":{"en":"The verb meaning 'to go' is arpa in the Saru dialect group, but oman in all other dialects.","ja":"「行く」を表す動詞は沙流方言グループだけが arpa であり、それ以外の方言では oman である。"},"type":"variation","scope":{"doculects":["doculect:ainu"],"quantifier":"all","modality":"asserted","conditions":[]},"forms":["arpa","oman"],"statements":[{"id":"stmt:nakagawa2024@gemini-3-flash-preview/l0106-02","stance":"asserts"}],"relations":[{"kind":"contrasts","claim":"claim:diachrony/hokkaido-lexical-dialectology-and-the-dialect-atlas--arpa-confined-to-hidaka","differs_in":"framework","note":"Contrasts Kindaichi & Chiri's Hidaka dialect boundary with Nakagawa's Saru dialect group."}],"grouped_by":"act:group/2026-09-26T07-52-28-143Z","status":"grouped"}
{"id":"claim:diachrony/hokkaido-lexical-dialectology-and-the-dialect-atlas--arpa-in-saru-and-chitose","revision":1,"topic":"topic:diachrony/hokkaido-lexical-dialectology-and-the-dialect-atlas","topics":["topic:diachrony/hokkaido-lexical-dialectology-and-the-dialect-atlas","topic:diachrony/hokkaido-lexical-dialectology-and-the-dialect-atlas--saru-chitose"],"statement":{"en":"The verb meaning 'to go' is arpa in the Saru and Chitose dialects, but oman in all other dialects.","ja":"「行く」という意味の動詞は沙流方言および千歳方言では arpa であるが、他の方言ではすべて oman である。"},"type":"variation","scope":{"doculects":["doculect:hokkaido/southwest/saru","doculect:hokkaido/chitose","doculect:hokkaido"],"quantifier":"all","modality":"asserted","conditions":[]},"forms":["arpa","oman"],"statements":[{"id":"stmt:nakagawafukazawa2022@handbook-epub/l0049-06","stance":"asserts"}],"relations":[{"kind":"contradicts","claim":"claim:diachrony/hokkaido-lexical-dialectology-and-the-dialect-atlas--arpa-confined-to-hidaka","differs_in":"dialect","note":"Kindaichi & Chiri confine arpa to Hidaka, whereas Nakagawa & Fukazawa report arpa in Chitose as well."},{"kind":"refines","claim":"claim:diachrony/hokkaido-lexical-dialectology-and-the-dialect-atlas--arpa-in-saru-dialect-group","differs_in":"scope","note":"Specifies that the Saru dialect group distribution comprises Saru and Chitose dialects."}],"grouped_by":"act:group/2026-09-26T07-52-28-143Z","status":"grouped"}
{"id":"claim:diachrony/hokkaido-lexical-dialectology-and-the-dialect-atlas--parunpe-retains-pa-in-ca-dialects","revision":1,"topic":"topic:diachrony/hokkaido-lexical-dialectology-and-the-dialect-atlas","topics":["topic:diachrony/hokkaido-lexical-dialectology-and-the-dialect-atlas","topic:diachrony/hokkaido-lexical-dialectology-and-the-dialect-atlas--mouth-isogloss"],"statement":{"en":"The word for 'tongue' retains pa- even in ca- dialect areas as parunpe, and the form carunpe does not exist.","ja":"「舌」を意味する語 parunpe は ca- 地域でも pa- を用い、carunpe という語は存在しない。"},"type":"absence","scope":{"doculects":["doculect:hokkaido"],"quantifier":"all","modality":"asserted","conditions":[]},"forms":["parunpe","carunpe"],"statements":[{"id":"stmt:nakagawafukazawa2022@handbook-epub/l0052-05","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-26T07-52-28-143Z","status":"grouped"}
{"id":"claim:diachrony/hokkaido-lexical-dialectology-and-the-dialect-atlas--sanca-or-ta-mina-kane-in-pa-dialects","revision":1,"topic":"topic:diachrony/hokkaido-lexical-dialectology-and-the-dialect-atlas","topics":["topic:diachrony/hokkaido-lexical-dialectology-and-the-dialect-atlas","topic:diachrony/hokkaido-lexical-dialectology-and-the-dialect-atlas--mouth-isogloss"],"statement":{"en":"The idiomatic expression sanca or ta mina kane 'to have a smile on one's lips' containing ca 'mouth' is used even in pa- dialect regions.","ja":"ca「口」を含む慣用表現 sanca or ta mina kane「唇に笑みを浮かべて」は pa- 地域においても用いられる。"},"type":"existence","scope":{"doculects":["doculect:hokkaido"],"quantifier":"all","modality":"asserted","conditions":[]},"forms":["sanca or ta mina kane"],"statements":[{"id":"stmt:nakagawafukazawa2022@handbook-epub/l0052-06","stance":"asserts"}],"relations":[{"kind":"contrasts","claim":"claim:diachrony/hokkaido-lexical-dialectology-and-the-dialect-atlas--parunpe-retains-pa-in-ca-dialects","differs_in":"dialect","note":"Demonstrates the reciprocal penetration of pa- and ca- across the mouth isogloss boundary."}],"grouped_by":"act:group/2026-09-26T07-52-28-143Z","status":"grouped"}
{"id":"claim:diachrony/hokkaido-lexical-dialectology-and-the-dialect-atlas--ihunke-means-lullaby","revision":1,"topic":"topic:diachrony/hokkaido-lexical-dialectology-and-the-dialect-atlas","topics":["topic:diachrony/hokkaido-lexical-dialectology-and-the-dialect-atlas","topic:diachrony/hokkaido-lexical-dialectology-and-the-dialect-atlas--semantic-fields"],"statement":{"en":"The word ihunke means 'lullaby' in some dialect regions.","ja":"ihunke という語は地域によっては「子守唄」を意味する。"},"type":"form-function","scope":{"doculects":["doculect:ainu"],"quantifier":"some","modality":"asserted","conditions":[]},"forms":["ihunke"],"statements":[{"id":"stmt:ono2022@handbook-epub/l0080-02","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-26T07-52-28-143Z","status":"grouped"}
{"id":"claim:diachrony/hokkaido-lexical-dialectology-and-the-dialect-atlas--ihunke-means-to-curse","revision":1,"topic":"topic:diachrony/hokkaido-lexical-dialectology-and-the-dialect-atlas","topics":["topic:diachrony/hokkaido-lexical-dialectology-and-the-dialect-atlas","topic:diachrony/hokkaido-lexical-dialectology-and-the-dialect-atlas--semantic-fields"],"statement":{"en":"The word ihunke means 'to curse someone' in some dialect regions.","ja":"ihunke という語はある地域では「誰かを呪う」という意味である。"},"type":"form-function","scope":{"doculects":["doculect:ainu"],"quantifier":"some","modality":"asserted","conditions":[]},"forms":["ihunke"],"statements":[{"id":"stmt:ono2022@handbook-epub/l0080-03","stance":"asserts"}],"relations":[{"kind":"contrasts","claim":"claim:diachrony/hokkaido-lexical-dialectology-and-the-dialect-atlas--ihunke-means-lullaby","differs_in":"dialect","note":"Shows the regional divergence in the meaning of ihunke between 'to curse' and 'lullaby'."}],"grouped_by":"act:group/2026-09-26T07-52-28-143Z","status":"grouped"}
{"id":"claim:diachrony/hokkaido-lexical-dialectology-and-the-dialect-atlas--hapo-means-mother-outside-chitose","revision":1,"topic":"topic:diachrony/hokkaido-lexical-dialectology-and-the-dialect-atlas","topics":["topic:diachrony/hokkaido-lexical-dialectology-and-the-dialect-atlas","topic:diachrony/hokkaido-lexical-dialectology-and-the-dialect-atlas--saru-chitose"],"statement":{"en":"In most dialects other than Chitose, hápo means 'mother' rather than 'father'.","ja":"千歳方言以外の大部分の方言では、hápo は「お父さん」ではなく「お母さん」を意味する。"},"type":"variation","scope":{"doculects":["doculect:hokkaido"],"quantifier":"most","modality":"asserted","conditions":[]},"forms":["hápo"],"statements":[{"id":"stmt:sato2008@gemini-3-flash-preview/l0231-01","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-26T07-52-28-143Z","status":"grouped"}
{"id":"claim:diachrony/hokkaido-lexical-dialectology-and-the-dialect-atlas--totto-for-mother-avoids-homophonic-clash","revision":1,"topic":"topic:diachrony/hokkaido-lexical-dialectology-and-the-dialect-atlas","topics":["topic:diachrony/hokkaido-lexical-dialectology-and-the-dialect-atlas","topic:diachrony/hokkaido-lexical-dialectology-and-the-dialect-atlas--isogloss-types"],"statement":{"en":"In Ishikari and Chitose dialects, 'mother' is called totto instead of hapo, likely to avoid homophonic clash with the terms for 'father' (hampe and hapo).","ja":"石狩地方と千歳では「おかあさん」を totto と呼んでおり、これは「おとうさん」を指す hampe や hapo との同音衝突を避けるためと考えられる。"},"type":"diachrony","scope":{"doculects":["doculect:hokkaido/central/ishikari","doculect:hokkaido/chitose"],"quantifier":"all","modality":"proposes","conditions":[]},"forms":["totto","hapo"],"statements":[{"id":"stmt:nakagawa2024@gemini-3-flash-preview/l0220-02","stance":"proposes"}],"relations":[{"kind":"supports","claim":"claim:diachrony/hokkaido-lexical-dialectology-and-the-dialect-atlas--hapo-means-mother-outside-chitose","differs_in":null,"note":"Provides the historical explanation for why Chitose uses hapo for father and totto for mother."}],"grouped_by":"act:group/2026-09-26T07-52-28-143Z","status":"grouped"}
{"id":"claim:diachrony/hokkaido-lexical-dialectology-and-the-dialect-atlas--colloquial-mother-totto-in-mukawa","revision":1,"topic":"topic:diachrony/hokkaido-lexical-dialectology-and-the-dialect-atlas","topics":["topic:diachrony/hokkaido-lexical-dialectology-and-the-dialect-atlas","topic:diachrony/hokkaido-lexical-dialectology-and-the-dialect-atlas--semantic-fields"],"statement":{"en":"The colloquial word for 'mother' is hapo in most places, but totto in the interior of Mukawa, where elsewhere totto 'breast' is restricted to poetic language when referring to 'mother'.","ja":"口語の「母」は大抵の所では hapo であるが、鵡川の奥では totto といい、元来「乳房」を意味する totto が「母」の意味で使われるのは他地方では雅語に限られる。"},"type":"variation","scope":{"doculects":["doculect:hokkaido/southwest"],"quantifier":"all","modality":"asserted","conditions":[]},"forms":["hapo","totto"],"statements":[{"id":"stmt:kindaichi1936@gemini-3-flash-preview/l0039-05","stance":"asserts"}],"relations":[{"kind":"contrasts","claim":"claim:diachrony/hokkaido-lexical-dialectology-and-the-dialect-atlas--totto-for-mother-avoids-homophonic-clash","differs_in":"dialect","note":"Notes the use of totto for mother in the Mukawa interior alongside its occurrence in Ishikari and Chitose."}],"grouped_by":"act:group/2026-09-26T07-52-28-143Z","status":"grouped"}
{"id":"claim:diachrony/hokkaido-lexical-dialectology-and-the-dialect-atlas--father-dialect-variation-hokkaido","revision":1,"topic":"topic:diachrony/hokkaido-lexical-dialectology-and-the-dialect-atlas","topics":["topic:diachrony/hokkaido-lexical-dialectology-and-the-dialect-atlas","topic:diachrony/hokkaido-lexical-dialectology-and-the-dialect-atlas--isogloss-types"],"statement":{"en":"The term for 'father' displays substantial dialect variation across Hokkaido, including mici along the Pacific coast and Bihoro, iyapo in lower Saru, hampe in Ishikari, hapo in Chitose, aca in Soya and Samani, and acapo in Yakumo and Oshamambe.","ja":"「おとうさん」を表す語には大きな方言差があり、太平洋岸一帯および美幌で mici、沙流下流で iyapo、石狩で hampe、千歳で hapo、宗谷・様似で aca、八雲・長万部で acapo が使われる。"},"type":"variation","scope":{"doculects":["doculect:hokkaido"],"quantifier":"all","modality":"asserted","conditions":[]},"forms":["mici","iyapo","hampe","hapo","aca","acapo"],"statements":[{"id":"stmt:nakagawa2024@gemini-3-flash-preview/l0219-02","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-26T07-52-28-143Z","status":"grouped"}
{"id":"claim:diachrony/hokkaido-lexical-dialectology-and-the-dialect-atlas--colloquial-father-southwest-variation","revision":1,"topic":"topic:diachrony/hokkaido-lexical-dialectology-and-the-dialect-atlas","topics":["topic:diachrony/hokkaido-lexical-dialectology-and-the-dialect-atlas","topic:diachrony/hokkaido-lexical-dialectology-and-the-dialect-atlas--semantic-fields"],"statement":{"en":"In Southwestern Hokkaido colloquial speech, the word for 'father' varies locally: Mukawa has iyapo, Atsuma has hapo, Shiraoi, Horobetsu, and Muroran have michi, and Usu, Abuta, and Toyoura have achipo.","ja":"北海道南西部の口語において「父」を表す語は地域によって異なり、鵡川では iyapo、厚真では hapo、白老・幌別・室蘭では michi、有珠・虻田・豊浦では achipo である。"},"type":"variation","scope":{"doculects":["doculect:hokkaido/southwest"],"quantifier":"all","modality":"asserted","conditions":[]},"forms":["iyapo","hapo","mici","achipo"],"statements":[{"id":"stmt:kindaichi1936@gemini-3-flash-preview/l0039-04","stance":"asserts"}],"relations":[{"kind":"refines","claim":"claim:diachrony/hokkaido-lexical-dialectology-and-the-dialect-atlas--father-dialect-variation-hokkaido","differs_in":"scope","note":"Gives a more granular Southwest Hokkaido distribution of terms for father (Mukawa, Atsuma, Shiraoi, Muroran, Usu, Toyoura)."}],"grouped_by":"act:group/2026-09-26T07-52-28-143Z","status":"grouped"}
{"id":"claim:diachrony/hokkaido-lexical-dialectology-and-the-dialect-atlas--iyapo-father-saru-mouth","revision":1,"topic":"topic:diachrony/hokkaido-lexical-dialectology-and-the-dialect-atlas","topics":["topic:diachrony/hokkaido-lexical-dialectology-and-the-dialect-atlas","topic:diachrony/hokkaido-lexical-dialectology-and-the-dialect-atlas--saru-chitose"],"statement":{"en":"The kinship term iyapo 'father' is found in an isolated distribution around the mouth of the Saru River.","ja":"親族名称 iyapo「父」は、沙流川河口付近に孤立して分布している。"},"type":"distribution","scope":{"doculects":["doculect:hokkaido/southwest/saru"],"quantifier":"all","modality":"asserted","conditions":[]},"forms":["iyapo"],"statements":[{"id":"stmt:nakagawafukazawa2022@handbook-epub/l0052-15","stance":"asserts"}],"relations":[{"kind":"supports","claim":"claim:diachrony/hokkaido-lexical-dialectology-and-the-dialect-atlas--father-dialect-variation-hokkaido","differs_in":null,"note":"Both report the localized occurrence of iyapo around the mouth/lower basin of the Saru River."}],"grouped_by":"act:group/2026-09-26T07-52-28-143Z","status":"grouped"}
{"id":"claim:diachrony/hokkaido-lexical-dialectology-and-the-dialect-atlas--the-verb-resu-raise-in-southwestern-ainu-and","revision":1,"topic":"topic:diachrony/hokkaido-lexical-dialectology-and-the-dialect-atlas","topics":["topic:diachrony/hokkaido-lexical-dialectology-and-the-dialect-atlas","topic:diachrony/hokkaido-lexical-dialectology-and-the-dialect-atlas--ew-divide"],"statement":{"en":"The verb resu 'raise' in Southwestern Ainu and reska 'raise' in Northeastern Ainu are dialectal variants.","ja":"「育てる」を意味する動詞resu（北海道南西部方言）とreska（北海道北東部方言）は方言異形である。"},"type":"variation","scope":{"doculects":["doculect:hokkaido/southwest","doculect:hokkaido/northeast"],"quantifier":"all","modality":"actual","conditions":[]},"forms":["resu","reska"],"statements":[{"id":"stmt:bugaeva2021poss@pdftotext-pieces/l0014-02","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-26T07-52-28-143Z","status":"grouped"}
{"id":"claim:diachrony/hokkaido-lexical-dialectology-and-the-dialect-atlas--in-eastern-hokkaido-dialects-certain-kinship-terms-that","revision":1,"topic":"topic:diachrony/hokkaido-lexical-dialectology-and-the-dialect-atlas","topics":["topic:diachrony/hokkaido-lexical-dialectology-and-the-dialect-atlas","topic:diachrony/hokkaido-lexical-dialectology-and-the-dialect-atlas--ew-divide"],"statement":{"en":"In Eastern Hokkaido dialects, certain kinship terms that take the concept-form construction have fused with kor, resulting in forms like konnarpe 'aunt', koracapo 'uncle', and koruci 'grandmother'.","ja":"北海道東部では、概念形構文をとる親族名称の一部で kor と親族名称が融合し、konnarpe「おばさん」、koracapo「おじさん」、koruci「おばあさん」のような形が使われる。"},"type":"variation","scope":{"doculects":["doculect:hokkaido/northeast"],"quantifier":"unstated","modality":"actual","conditions":[]},"forms":["konnarpe","koracapo","koruci"],"statements":[{"id":"stmt:nakagawa2024@gemini-3-flash-preview/l0220-03","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-26T07-52-28-143Z","status":"grouped"}
{"id":"claim:diachrony/hokkaido-lexical-dialectology-and-the-dialect-atlas--the-words-penup-and-cape-used-as-offshore","revision":1,"topic":"topic:diachrony/hokkaido-lexical-dialectology-and-the-dialect-atlas","topics":["topic:diachrony/hokkaido-lexical-dialectology-and-the-dialect-atlas","topic:diachrony/hokkaido-lexical-dialectology-and-the-dialect-atlas--isogloss-types"],"statement":{"en":"The words penup and cape, used as offshore taboo words in the Shiraoi dialect, are ordinary words for 'ikema' and 'cat' in other dialects.","ja":"白老方言で沖言葉として使われる penup と cape は、他方言ではそれぞれ「イケマ」「ネコ」を指す言葉として普通に使われている。"},"type":"variation","scope":{"doculects":["doculect:hokkaido"],"quantifier":"generic","modality":"actual","conditions":[]},"forms":["penup","cape"],"statements":[{"id":"stmt:nakagawa2024@gemini-3-flash-preview/l0526-03","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-26T07-52-28-143Z","status":"grouped"}
{"id":"claim:diachrony/hokkaido-lexical-dialectology-and-the-dialect-atlas--depending-on-the-dialect-the-forms-meaning-tooth","revision":1,"topic":"topic:diachrony/hokkaido-lexical-dialectology-and-the-dialect-atlas","topics":["topic:diachrony/hokkaido-lexical-dialectology-and-the-dialect-atlas","topic:diachrony/hokkaido-lexical-dialectology-and-the-dialect-atlas--isogloss-types"],"statement":{"en":"Depending on the dialect, the forms meaning 'tooth' vary among mimak, nimak, imak, and imah, which derive from a common source.","ja":"「歯」を意味する形式は方言によって mimak、nimak、imak、imah などと異なり、同源に由来するとみなされる。"},"type":"variation","scope":{"doculects":["doculect:ainu"],"quantifier":"all","modality":"actual","conditions":[]},"forms":["mimak","nimak","imak","imah"],"statements":[{"id":"stmt:nakagawafukazawa2022@handbook-epub/l0049-02","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-26T07-52-28-143Z","status":"grouped"}
{"id":"claim:diachrony/hokkaido-lexical-dialectology-and-the-dialect-atlas--the-kinship-term-mici-father-is-distributed-along","revision":1,"topic":"topic:diachrony/hokkaido-lexical-dialectology-and-the-dialect-atlas","topics":["topic:diachrony/hokkaido-lexical-dialectology-and-the-dialect-atlas","topic:diachrony/hokkaido-lexical-dialectology-and-the-dialect-atlas--isogloss-types"],"statement":{"en":"The kinship term mici 'father' is distributed along the entire Pacific Coast from the Kurils on the east to Horobetsu on the west.","ja":"親族名称mici「父」は、東の千島から西の幌別まで太平洋沿岸全域に広く分布している。"},"type":"distribution","scope":{"doculects":["doculect:kuril","doculect:hokkaido/southwest/horobetsu","doculect:hokkaido"],"quantifier":"all","modality":"actual","conditions":[]},"forms":["mici"],"statements":[{"id":"stmt:nakagawafukazawa2022@handbook-epub/l0052-14","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-26T07-52-28-143Z","status":"grouped"}
{"id":"claim:diachrony/hokkaido-lexical-dialectology-and-the-dialect-atlas--the-verb-meaning-come-is-ek-in-all","revision":1,"topic":"topic:diachrony/hokkaido-lexical-dialectology-and-the-dialect-atlas","topics":["topic:diachrony/hokkaido-lexical-dialectology-and-the-dialect-atlas","topic:diachrony/hokkaido-lexical-dialectology-and-the-dialect-atlas--sa-ku-comparative"],"statement":{"en":"The verb meaning 'come' is ek in all Hokkaido dialects and the regularly corresponding form eh in all Sakhalin dialects.","ja":"「来る」という意味の動詞は北海道方言全般で ek であり、樺太方言全般では規則的に対応する形式 eh である。"},"type":"variation","scope":{"doculects":["doculect:hokkaido","doculect:sakhalin"],"quantifier":"all","modality":"actual","conditions":[]},"forms":["ek","eh"],"statements":[{"id":"stmt:nakagawafukazawa2022@handbook-epub/l0049-05","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-26T07-52-28-143Z","status":"grouped"}
{"id":"claim:diachrony/hokkaido-lexical-dialectology-and-the-dialect-atlas--in-chitose-ainu-the-two-forms-papus-and","revision":1,"topic":"topic:diachrony/hokkaido-lexical-dialectology-and-the-dialect-atlas","topics":["topic:diachrony/hokkaido-lexical-dialectology-and-the-dialect-atlas","topic:diachrony/hokkaido-lexical-dialectology-and-the-dialect-atlas--semantic-fields"],"statement":{"en":"In Chitose Ainu, the two forms papus and patoy are distinguished in meaning, with papus meaning 'a part of the mouth that sticks out' and patoy meaning 'the whole of the lips'.","ja":"千歳方言においてpapusとpatoyの2形は意味上使い分けられており、前者は「口の突き出た部分」、後者は「唇全体」を意味する。"},"type":"form-function","scope":{"doculects":["doculect:hokkaido/chitose"],"quantifier":"all","modality":"actual","conditions":[]},"forms":["papus","patoy"],"statements":[{"id":"stmt:nakagawafukazawa2022@handbook-epub/l0052-03","stance":"reports"}],"relations":[],"grouped_by":"act:group/2026-09-26T07-52-28-143Z","status":"grouped"}
{"id":"claim:diachrony/hokkaido-lexical-dialectology-and-the-dialect-atlas--in-chitose-ainu-anemone-flaccida-is-called-ohawkina","revision":1,"topic":"topic:diachrony/hokkaido-lexical-dialectology-and-the-dialect-atlas","topics":["topic:diachrony/hokkaido-lexical-dialectology-and-the-dialect-atlas","topic:diachrony/hokkaido-lexical-dialectology-and-the-dialect-atlas--semantic-fields"],"statement":{"en":"In Chitose Ainu, Anemone flaccida is called ohawkina, while in other regions it is sometimes called pukusakina.","ja":"ニリンソウは千歳では ohawkina と言うが、他の地方では pukusakina と呼ばれることもある。"},"type":"variation","scope":{"doculects":["doculect:hokkaido/chitose"],"quantifier":"all","modality":"actual","conditions":[]},"forms":["ohawkina","pukusakina"],"statements":[{"id":"stmt:sato2008@gemini-3-flash-preview/l0125-03","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-26T07-52-28-143Z","status":"grouped"}
{"id":"claim:diachrony/hokkaido-lexical-dialectology-and-the-dialect-atlas--the-noun-aha-apios-fortunei-is-called-eha","revision":1,"topic":"topic:diachrony/hokkaido-lexical-dialectology-and-the-dialect-atlas","topics":["topic:diachrony/hokkaido-lexical-dialectology-and-the-dialect-atlas","topic:diachrony/hokkaido-lexical-dialectology-and-the-dialect-atlas--semantic-fields"],"statement":{"en":"The noun aha 'Apios fortunei' is called eha in some dialects.","ja":"aha「ヤブマメ」は地方によっては eha と呼ばれることもある。"},"type":"variation","scope":{"doculects":["doculect:ainu"],"quantifier":"exists","modality":"actual","conditions":["in some dialects"]},"forms":["aha","eha"],"statements":[{"id":"stmt:sato2008@gemini-3-flash-preview/l0140-04","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-26T07-52-28-143Z","status":"grouped"}

{"id":"claim:clause/constituent-order-head-final--ainu-basic-constituent-order-sov","revision":1,"topic":"topic:clause/constituent-order-head-final","topics":["topic:clause/constituent-order-head-final","topic:clause/constituent-order-head-final--verb-final"],"statement":{"en":"The basic constituent order of Ainu is SOV.","ja":"アイヌ語の基本語順はSOVである。"},"type":"ordering","scope":{"doculects":["doculect:ainu"],"quantifier":"in-general","modality":"asserted","conditions":[]},"forms":[],"statements":[{"id":"stmt:bugaeva2006@gemini-3-flash-preview/l0001-04","stance":"asserts"},{"id":"stmt:bugaeva2022@handbook-epub/l0002-10","stance":"asserts"},{"id":"stmt:bugaeva2022@handbook-epub/l0008-02","stance":"asserts"},{"id":"stmt:shibatani1990@gemini-3-flash-preview/l0017-03","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-13-12-354Z","status":"grouped"}
{"id":"claim:clause/constituent-order-head-final--ainu-basic-constituent-order-sv-aov","revision":1,"topic":"topic:clause/constituent-order-head-final","topics":["topic:clause/constituent-order-head-final","topic:clause/constituent-order-head-final--verb-final"],"statement":{"en":"The basic constituent order of Ainu is SV in intransitive clauses and AOV in transitive clauses.","ja":"アイヌ語の基本的構成素順序は自動詞節でSV、他動詞節でAOVである。"},"type":"ordering","scope":{"doculects":["doculect:ainu"],"quantifier":"in-general","modality":"asserted","conditions":[]},"forms":[],"statements":[{"id":"stmt:bugaeva2008@pdftotext-pieces/l0003-03","stance":"asserts"},{"id":"stmt:bugaeva2012@gemini-3-flash-preview/l0008-09","stance":"asserts"},{"id":"stmt:bugaeva2015@gemini-3-flash-preview/l0002-04","stance":"asserts"},{"id":"stmt:bugaeva2016@pdftotext-pieces/l0002-11","stance":"asserts"}],"relations":[{"kind":"contrasts","claim":"claim:clause/constituent-order-head-final--ainu-basic-constituent-order-sov","differs_in":"framework","note":"SV/AOV formulation adopts Dixonian syntactic primitive labels rather than traditional SOV."}],"grouped_by":"act:group/2026-09-10T15-13-12-354Z","status":"grouped"}
{"id":"claim:clause/constituent-order-head-final--modifiers-precede-modified-elements","revision":1,"topic":"topic:clause/constituent-order-head-final","topics":["topic:clause/constituent-order-head-final","topic:clause/constituent-order-head-final--profile"],"statement":{"en":"Modifiers strictly precede the elements they modify.","ja":"修飾語は常に被修飾語に先行する。"},"type":"ordering","scope":{"doculects":["doculect:ainu"],"quantifier":"all","modality":"asserted","conditions":[]},"forms":[],"statements":[{"id":"stmt:bugaeva2015@gemini-3-flash-preview/l0002-06","stance":"asserts"},{"id":"stmt:kindaichi1936@gemini-3-flash-preview/l0210-01","stance":"asserts"},{"id":"stmt:refsing1986@gemini-3-flash-preview/l0034-01","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-13-12-354Z","status":"grouped"}
{"id":"claim:clause/constituent-order-head-final--objects-and-complements-precede-verb","revision":1,"topic":"topic:clause/constituent-order-head-final","topics":["topic:clause/constituent-order-head-final","topic:clause/constituent-order-head-final--verb-final"],"statement":{"en":"Nominal objects and complements precede the verb.","ja":"目的語および補語は動詞に先行する。"},"type":"ordering","scope":{"doculects":["doculect:ainu"],"quantifier":"all","modality":"asserted","conditions":[]},"forms":[],"statements":[{"id":"stmt:kindaichi1936@gemini-3-flash-preview/l0210-03","stance":"asserts"},{"id":"stmt:refsing1986@gemini-3-flash-preview/l0034-02","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-13-12-354Z","status":"grouped"}
{"id":"claim:clause/constituent-order-head-final--nominal-subject-yields-sov-order-shizunai","revision":1,"topic":"topic:clause/constituent-order-head-final","topics":["topic:clause/constituent-order-head-final","topic:clause/constituent-order-head-final--np-order"],"statement":{"en":"In transitive clauses with a nominal subject, the object precedes the verb and follows the subject, yielding S-O-V order.","ja":"他動詞節において名詞主語をとる場合、目的語は動詞の前かつ主語の後に置かれ、S-O-Vの語順となる。"},"type":"ordering","scope":{"doculects":["doculect:hokkaido/southwest/shizunai"],"quantifier":"in-general","modality":"asserted","conditions":["subject-is-nominal"]},"forms":[],"statements":[{"id":"stmt:refsing1986@gemini-3-flash-preview/l0138-02","stance":"asserts"},{"id":"stmt:refsing1986@gemini-3-flash-preview/l0139-02","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-13-12-354Z","status":"grouped"}
{"id":"claim:clause/constituent-order-head-final--pronominal-subject-affix-yields-osv-order-shizunai","revision":1,"topic":"topic:clause/constituent-order-head-final","topics":["topic:clause/constituent-order-head-final","topic:clause/constituent-order-head-final--np-order"],"statement":{"en":"When the subject is a pronominal prefix, it attaches directly to the verb, yielding an O-S-V constituent order with a nominal object.","ja":"主語が人称接辞である場合、動詞の直前に付加されるため、名詞目的語に対してO-S-Vの語順を生じる。"},"type":"ordering","scope":{"doculects":["doculect:hokkaido/southwest/shizunai"],"quantifier":"in-general","modality":"asserted","conditions":["subject-is-pronominal-affix"]},"forms":[],"statements":[{"id":"stmt:refsing1986@gemini-3-flash-preview/l0138-03","stance":"asserts"},{"id":"stmt:refsing1986@gemini-3-flash-preview/l0139-03","stance":"asserts"}],"relations":[{"kind":"contrasts","claim":"claim:clause/constituent-order-head-final--nominal-subject-yields-sov-order-shizunai","differs_in":"conditions","note":"Pronominal subject prefixes yield surface OSV, contrasting with nominal subject SOV."}],"grouped_by":"act:group/2026-09-10T15-13-12-354Z","status":"grouped"}
{"id":"claim:clause/constituent-order-head-final--ditransitive-constituent-order-nominal-subject-shizunai","revision":1,"topic":"topic:clause/constituent-order-head-final","topics":["topic:clause/constituent-order-head-final","topic:clause/constituent-order-head-final--np-order"],"statement":{"en":"In clauses with three-place verbs and a nominal subject, the constituent order is subject – indirect object – direct object – verb.","ja":"3項動詞において主語が名詞である場合、構成素順序は「主語 - 間接目的語 - 直接目的語 - 動詞」となる。"},"type":"ordering","scope":{"doculects":["doculect:hokkaido/southwest/shizunai"],"quantifier":"in-general","modality":"asserted","conditions":["three-place-verb","subject-is-nominal"]},"forms":[],"statements":[{"id":"stmt:refsing1986@gemini-3-flash-preview/l0138-10","stance":"asserts"},{"id":"stmt:refsing1986@gemini-3-flash-preview/l0139-09","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-13-12-354Z","status":"grouped"}
{"id":"claim:clause/constituent-order-head-final--ditransitive-constituent-order-pronominal-subject-shizunai","revision":1,"topic":"topic:clause/constituent-order-head-final","topics":["topic:clause/constituent-order-head-final","topic:clause/constituent-order-head-final--np-order"],"statement":{"en":"In clauses with three-place verbs where the subject is a pronominal affix, the most frequent constituent order is indirect object – direct object – subject – verb.","ja":"3項動詞において主語が人称接辞である場合、最も頻度の高い構成素順序は「間接目的語 - 直接目的語 - 主語 - 動詞」である。"},"type":"ordering","scope":{"doculects":["doculect:hokkaido/southwest/shizunai"],"quantifier":"most","modality":"asserted","conditions":["three-place-verb","subject-is-pronominal-affix"]},"forms":[],"statements":[{"id":"stmt:refsing1986@gemini-3-flash-preview/l0138-09","stance":"asserts"},{"id":"stmt:refsing1986@gemini-3-flash-preview/l0139-08","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-13-12-354Z","status":"grouped"}
{"id":"claim:clause/constituent-order-head-final--minimal-complete-sentence-is-verb-shizunai","revision":1,"topic":"topic:clause/constituent-order-head-final","topics":["topic:clause/constituent-order-head-final","topic:clause/constituent-order-head-final--verb-final"],"statement":{"en":"In Shizunai Ainu, a minimal complete sentence consists of a single verb.","ja":"静内アイヌ語において、最小の完全な文は動詞1語から構成される。"},"type":"analysis","scope":{"doculects":["doculect:hokkaido/southwest/shizunai"],"quantifier":"in-general","modality":"asserted","conditions":[]},"forms":[],"statements":[{"id":"stmt:refsing1986@gemini-3-flash-preview/l0260-05","stance":"asserts"},{"id":"stmt:refsing1986@gemini-3-flash-preview/l0261-06","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-13-12-354Z","status":"grouped"}
{"id":"claim:clause/constituent-order-head-final--grammatical-roles-signaled-by-word-order-and-context","revision":1,"topic":"topic:clause/constituent-order-head-final","topics":["topic:clause/constituent-order-head-final","topic:clause/constituent-order-head-final--np-order"],"statement":{"en":"Ainu lacks case particles corresponding to Japanese ga and o, with core syntactic roles indicated by word order and context.","ja":"アイヌ語には日本語の「が」や「を」に相当する格助詞がなく、主語や目的語などの文法的役割は語順や文脈によって示される。"},"type":"absence","scope":{"doculects":["doculect:ainu"],"quantifier":"in-general","modality":"asserted","conditions":[]},"forms":[],"statements":[{"id":"stmt:sato2008@gemini-3-flash-preview/l0020-03","stance":"asserts"},{"id":"stmt:sato2008@gemini-3-flash-preview/l0038-01","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-13-12-354Z","status":"grouped"}
{"id":"claim:clause/constituent-order-head-final--noun-phrases-in-ainu-have-no-grammatical-marking","revision":1,"topic":"topic:clause/constituent-order-head-final","topics":["topic:clause/constituent-order-head-final"],"statement":{"en":"Noun phrases in Ainu have no grammatical marking for the syntactic roles of subject and object.","ja":"アイヌ語において、名詞句には主語および目的語という統語的役割の標示が存在しない。"},"type":"absence","scope":{"doculects":["doculect:ainu"],"quantifier":"all","modality":"actual","conditions":[]},"forms":[],"statements":[{"id":"stmt:nakagawa2022pos@handbook-epub/l0096-07","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-13-12-354Z","status":"grouped"}
{"id":"claim:clause/constituent-order-head-final--the-basic-structure-of-ainu-sentences-is-determined","revision":1,"topic":"topic:clause/constituent-order-head-final","topics":["topic:clause/constituent-order-head-final"],"statement":{"en":"The basic structure of Ainu sentences is determined primarily by verbal valency and five structures based on typological properties of head-marking languages.","ja":"アイヌ語の文の基本構造は主として動詞の結合価と、主要部標示言語の類型論的性質に基づく5つの構造によって決定される。"},"type":"analysis","scope":{"doculects":["doculect:ainu"],"quantifier":"generic","modality":"actual","conditions":[]},"forms":[],"statements":[{"id":"stmt:sato2025a@pdftotext-pieces/l0001-01","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-13-12-354Z","status":"grouped"}
{"id":"claim:clause/constituent-order-head-final--an-ainu-sentence-may-appear-as-independent-noun","revision":1,"topic":"topic:clause/constituent-order-head-final","topics":["topic:clause/constituent-order-head-final"],"statement":{"en":"An Ainu sentence may appear as independent noun phrase(s) and a predicate, as well as a predicate marked for person without an independent noun phrase.","ja":"アイヌ語の文は独立した名詞句と述語から構成されることもあれば、名詞句を伴わず人称標示された述語のみで現れることもある。"},"type":"distribution","scope":{"doculects":["doculect:ainu"],"quantifier":"generic","modality":"possible","conditions":[]},"forms":["mina","ku-inkar"],"statements":[{"id":"stmt:sato2025a@pdftotext-pieces/l0002-01","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-13-12-354Z","status":"grouped"}
{"id":"claim:clause/constituent-order-head-final--ainu-basic-sentences-are-determined-according-to-the","revision":1,"topic":"topic:clause/constituent-order-head-final","topics":["topic:clause/constituent-order-head-final"],"statement":{"en":"Ainu basic sentences are determined according to the type of verb: a one-place, a two-place, a three-place, or a copula verb.","ja":"アイヌ語の基本文は動詞のタイプ（1項動詞、2項動詞、3項動詞、繋辞動詞）に応じて決定される。"},"type":"analysis","scope":{"doculects":["doculect:ainu"],"quantifier":"generic","modality":"actual","conditions":[]},"forms":[],"statements":[{"id":"stmt:sato2025a@pdftotext-pieces/l0003-01","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-13-12-354Z","status":"grouped"}
{"id":"claim:clause/constituent-order-head-final--an-adverbial-phrase-ap-usually-precedes-a-vp","revision":1,"topic":"topic:clause/constituent-order-head-final","topics":["topic:clause/constituent-order-head-final","topic:clause/constituent-order-head-final--negation-adjuncts"],"statement":{"en":"An adverbial phrase (AP) usually precedes a VP and modifies it.","ja":"副詞部（AP）は普通、VPより前に位置してVPを修飾する。"},"type":"ordering","scope":{"doculects":["doculect:sakhalin"],"quantifier":"usually","modality":"actual","conditions":[]},"forms":[],"statements":[{"id":"stmt:murasaki2025@gemini-3-flash-preview/l0112-01","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-13-12-354Z","status":"grouped"}
{"id":"claim:clause/constituent-order-head-final--adverbial-phrases-in-ainu-can-occur-in-any","revision":1,"topic":"topic:clause/constituent-order-head-final","topics":["topic:clause/constituent-order-head-final","topic:clause/constituent-order-head-final--negation-adjuncts"],"statement":{"en":"Adverbial phrases in Ainu can occur in any number within a clause, regardless of the arity of the verb phrase.","ja":"アイヌ語の副詞句は、動詞句のアリティに関わらず、文の中にいくつでも置くことができる。"},"type":"distribution","scope":{"doculects":["doculect:ainu"],"quantifier":"generic","modality":"possible","conditions":[]},"forms":[],"statements":[{"id":"stmt:nakagawa2024@gemini-3-flash-preview/l0357-02","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-13-12-354Z","status":"grouped"}
{"id":"claim:clause/constituent-order-head-final--there-is-no-fixed-order-between-adverbial-phrases","revision":1,"topic":"topic:clause/constituent-order-head-final","topics":["topic:clause/constituent-order-head-final","topic:clause/constituent-order-head-final--negation-adjuncts"],"statement":{"en":"There is no fixed order between adverbial phrases and noun phrases, as long as both precede the verb phrase.","ja":"副詞句と名詞句の順番に特に決まりはなく、ともに動詞句の前であればよい。"},"type":"ordering","scope":{"doculects":["doculect:ainu"],"quantifier":"all","modality":"possible","conditions":[]},"forms":[],"statements":[{"id":"stmt:nakagawa2024@gemini-3-flash-preview/l0358-01","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-13-12-354Z","status":"grouped"}
{"id":"claim:clause/constituent-order-head-final--grammatical-subjects-do-not-necessarily-precede-objects-or","revision":1,"topic":"topic:clause/constituent-order-head-final","topics":["topic:clause/constituent-order-head-final","topic:clause/constituent-order-head-final--negation-adjuncts"],"statement":{"en":"Grammatical subjects do not necessarily precede objects or vice versa; rather, topicalized elements marked by secondary particles such as anakne or ka tend to appear clause-initially regardless of their grammatical role.","ja":"主語が目的語の前に来るとは限らずその逆とも言えず、文法的な役割に関わらず anakne や ka などの副助詞によって主題化された要素が文頭に来る傾向がある。"},"type":"distribution","scope":{"doculects":["doculect:ainu"],"quantifier":"generic","modality":"actual","conditions":[]},"forms":["anakne","ka"],"statements":[{"id":"stmt:nakagawa2024@gemini-3-flash-preview/l0361-01","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-13-12-354Z","status":"grouped"}
{"id":"claim:clause/constituent-order-head-final--the-order-of-predicate-adjuncts-in-the-shizunai","revision":1,"topic":"topic:clause/constituent-order-head-final","topics":["topic:clause/constituent-order-head-final","topic:clause/constituent-order-head-final--negation-adjuncts"],"statement":{"en":"The order of predicate adjuncts in the Shizunai dialect is very free.","ja":"静内方言における述語付加語の語順は非常に自由である。"},"type":"ordering","scope":{"doculects":["doculect:hokkaido/southwest/shizunai"],"quantifier":"all","modality":"actual","conditions":[]},"forms":[],"statements":[{"id":"stmt:refsing1986@gemini-3-flash-preview/l0034-09","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-13-12-354Z","status":"grouped"}
{"id":"claim:clause/constituent-order-head-final--a-sentence-consists-of-a-predicate-preceded-optionally","revision":1,"topic":"topic:clause/constituent-order-head-final","topics":["topic:clause/constituent-order-head-final","topic:clause/constituent-order-head-final--negation-adjuncts"],"statement":{"en":"A sentence consists of a predicate preceded optionally by any order and number of relational adjuncts, adverbial adjuncts, and quotational adjuncts.","ja":"文は述語から構成され、その前には関係添辞、副詞的添辞、引用添辞が任意の順序および個数で先行しうる。"},"type":"ordering","scope":{"doculects":["doculect:hokkaido/southwest/shizunai"],"quantifier":"all","modality":"necessary","conditions":[]},"forms":[],"statements":[{"id":"stmt:refsing1986@gemini-3-flash-preview/l0262-01","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-13-12-354Z","status":"grouped"}
{"id":"claim:clause/constituent-order-head-final--topics-temporal-expressions-and-locative-expressions-are-usually","revision":1,"topic":"topic:clause/constituent-order-head-final","topics":["topic:clause/constituent-order-head-final","topic:clause/constituent-order-head-final--negation-adjuncts"],"statement":{"en":"Topics, temporal expressions, and locative expressions are usually placed at the beginning of a sentence.","ja":"主題ならびに時間表現や場所表現は通常文頭に置かれる。"},"type":"ordering","scope":{"doculects":["doculect:hokkaido/southwest/shizunai"],"quantifier":"usually","modality":"actual","conditions":[]},"forms":[],"statements":[{"id":"stmt:refsing1986@gemini-3-flash-preview/l0264-03","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-13-12-354Z","status":"grouped"}
{"id":"claim:clause/constituent-order-head-final--adverbials-cannot-be-inserted-freely-between-a-verb","revision":1,"topic":"topic:clause/constituent-order-head-final","topics":["topic:clause/constituent-order-head-final","topic:clause/constituent-order-head-final--negation-adjuncts"],"statement":{"en":"Adverbials cannot be inserted freely between a verb and its object in Ainu.","ja":"アイヌ語において動詞とその目的語の間に副詞句を自由に挿入することはできない。"},"type":"distribution","scope":{"doculects":["doculect:ainu"],"quantifier":"none","modality":"necessary","conditions":[]},"forms":[],"statements":[{"id":"stmt:sato2016@pdftotext-pieces/l0006-01","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-13-12-354Z","status":"grouped"}
{"id":"claim:clause/constituent-order-head-final--an-adverb-precedes-the-verb-in-ainu","revision":1,"topic":"topic:clause/constituent-order-head-final","topics":["topic:clause/constituent-order-head-final","topic:clause/constituent-order-head-final--negation-adjuncts"],"statement":{"en":"An adverb precedes the verb in Ainu.","ja":"アイヌ語において副詞は動詞に先行する。"},"type":"ordering","scope":{"doculects":["doculect:ainu"],"quantifier":"generic","modality":"actual","conditions":[]},"forms":[],"statements":[{"id":"stmt:shibatani1990@gemini-3-flash-preview/l0021-04","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-13-12-354Z","status":"grouped"}
{"id":"claim:clause/constituent-order-head-final--ainu-is-basically-an-sov-language-with-flexibility","revision":1,"topic":"topic:clause/constituent-order-head-final","topics":["topic:clause/constituent-order-head-final","topic:clause/constituent-order-head-final--np-order"],"statement":{"en":"Ainu is basically an SOV language with flexibility in the relative ordering of subject and object, but it is strictly verb-final.","ja":"アイヌ語は基本的にSOV型言語であり、主語と目的語の語順には柔軟性があるが、厳密に動詞末尾である。"},"type":"ordering","scope":{"doculects":["doculect:ainu"],"quantifier":"all","modality":"actual","conditions":[]},"forms":[],"statements":[{"id":"stmt:bugaeva2022@handbook-epub/l0005-10","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-13-12-354Z","status":"grouped"}
{"id":"claim:clause/constituent-order-head-final--the-functions-of-nominative-accusative-and-vocative-cases","revision":1,"topic":"topic:clause/constituent-order-head-final","topics":["topic:clause/constituent-order-head-final","topic:clause/constituent-order-head-final--np-order"],"statement":{"en":"The functions of nominative, accusative, and vocative cases are indicated by word order and environment.","ja":"主格・対格・呼格の機能は語序や環境などによって示される。"},"type":"form-function","scope":{"doculects":[],"quantifier":"all","modality":"actual","conditions":[]},"forms":[],"statements":[{"id":"stmt:kindaichi1936@gemini-3-flash-preview/l0047-03","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-13-12-354Z","status":"grouped"}
{"id":"claim:clause/constituent-order-head-final--dative-case-is-indicated-by-word-order-when","revision":1,"topic":"topic:clause/constituent-order-head-final","topics":["topic:clause/constituent-order-head-final","topic:clause/constituent-order-head-final--np-order"],"statement":{"en":"Dative case is indicated by word order when it functions as the indirect object of a transitive verb.","ja":"与格は、他動詞の間接目的語であるときは語序によって示される。"},"type":"form-function","scope":{"doculects":[],"quantifier":"all","modality":"actual","conditions":["indirect object of transitive verb"]},"forms":[],"statements":[{"id":"stmt:kindaichi1936@gemini-3-flash-preview/l0047-06","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-13-12-354Z","status":"grouped"}
{"id":"claim:clause/constituent-order-head-final--the-three-noun-phrase-arguments-of-the-verb","revision":1,"topic":"topic:clause/constituent-order-head-final","topics":["topic:clause/constituent-order-head-final","topic:clause/constituent-order-head-final--np-order"],"statement":{"en":"The three noun phrase arguments of the verb e-pakasnu 'teach someone something' precede the verb, but their relative order is free.","ja":"動詞 e-pakasnu「教える」の3つの名詞句項は動詞の前に置かれるが、その語順は自由である。"},"type":"ordering","scope":{"doculects":["doculect:hokkaido/chitose"],"quantifier":"generic","modality":"actual","conditions":[]},"forms":["e-pakasnu"],"statements":[{"id":"stmt:nakagawa2022pos@handbook-epub/l0095-02","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-13-12-354Z","status":"grouped"}
{"id":"claim:clause/constituent-order-head-final--the-relative-order-among-noun-phrases-or-between","revision":1,"topic":"topic:clause/constituent-order-head-final","topics":["topic:clause/constituent-order-head-final","topic:clause/constituent-order-head-final--np-order"],"statement":{"en":"The relative order among noun phrases, or between noun phrases and adverbial phrases, before the verb phrase is not grammatically fixed to subject-object-verb order.","ja":"動詞句の前の名詞句と名詞句、名詞句と副詞句の順番は、一定の傾向はあるものの文法的に決まっているわけではなく、必ずしも主語・目的語・動詞の順番に並ぶとは限らない。"},"type":"ordering","scope":{"doculects":["doculect:ainu"],"quantifier":"generic","modality":"possible","conditions":[]},"forms":[],"statements":[{"id":"stmt:nakagawa2024@gemini-3-flash-preview/l0359-04","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-13-12-354Z","status":"grouped"}
{"id":"claim:clause/constituent-order-head-final--because-ainu-lacks-case-marking-particles-like-japanese","revision":1,"topic":"topic:clause/constituent-order-head-final","topics":["topic:clause/constituent-order-head-final","topic:clause/constituent-order-head-final--np-order"],"statement":{"en":"Because Ainu lacks case-marking particles like Japanese ga and o, and noun phrases bear no grammatical markers of subject or object, the grammatical role of noun phrases cannot be determined grammatically but must be judged by context and real-world knowledge.","ja":"アイヌ語には日本語の「が」や「を」にあたるような格助詞がなく、名詞句自体に主語や目的語を示す指標もないため、どの名詞句が主語や目的語であるかは文法的には決定できず文脈や常識で判断される。"},"type":"absence","scope":{"doculects":["doculect:ainu"],"quantifier":"all","modality":"actual","conditions":[]},"forms":[],"statements":[{"id":"stmt:nakagawa2024@gemini-3-flash-preview/l0360-01","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-13-12-354Z","status":"grouped"}
{"id":"claim:clause/constituent-order-head-final--in-chitose-ainu-all-three-orders-of-indirect","revision":1,"topic":"topic:clause/constituent-order-head-final","topics":["topic:clause/constituent-order-head-final","topic:clause/constituent-order-head-final--np-order"],"statement":{"en":"In Chitose Ainu, all three orders of indirect object, direct object, and subject (IO-S-DO, IO-DO-S, and S-IO-DO) are attested in natural speech with the ditransitive verb epakasnu.","ja":"千歳方言において、3項動詞 epakasnu「教える」を述語とする文では、間接目的語・主語・直接目的語、間接目的語・直接目的語・主語、主語・間接目的語・直接目的語の3通りの語順が同一話者の実例で確認される。"},"type":"variation","scope":{"doculects":["doculect:hokkaido/chitose"],"quantifier":"exists","modality":"actual","conditions":["with the 3-argument verb epakasnu"]},"forms":["epakasnu"],"statements":[{"id":"stmt:nakagawa2024@gemini-3-flash-preview/l0360-02","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-13-12-354Z","status":"grouped"}
{"id":"claim:clause/constituent-order-head-final--when-the-subject-is-a-noun-or-pronoun","revision":1,"topic":"topic:clause/constituent-order-head-final","topics":["topic:clause/constituent-order-head-final","topic:clause/constituent-order-head-final--np-order"],"statement":{"en":"When the subject is a noun or pronoun, it precedes the verb, and if an object or complement is present, the word order is SOV.","ja":"主語が名詞または代名詞である場合は動詞に先行し、目的語または補語が存在するときの語順はSOVとなる。"},"type":"ordering","scope":{"doculects":["doculect:ainu"],"quantifier":"all","modality":"actual","conditions":["subject is a noun or pronoun"]},"forms":[],"statements":[{"id":"stmt:refsing1986@gemini-3-flash-preview/l0034-04","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-13-12-354Z","status":"grouped"}
{"id":"claim:clause/constituent-order-head-final--when-the-subject-is-a-pronominal-affix-and","revision":1,"topic":"topic:clause/constituent-order-head-final","topics":["topic:clause/constituent-order-head-final","topic:clause/constituent-order-head-final--np-order"],"statement":{"en":"When the subject is a pronominal affix and the object is a noun, the word order becomes OSV.","ja":"主語が人称接辞で目的語が名詞である場合、語順はOSVとなる。"},"type":"ordering","scope":{"doculects":["doculect:ainu"],"quantifier":"all","modality":"actual","conditions":["subject is a pronominal affix","object is a noun"]},"forms":[],"statements":[{"id":"stmt:refsing1986@gemini-3-flash-preview/l0034-08","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-13-12-354Z","status":"grouped"}
{"id":"claim:clause/constituent-order-head-final--in-clause-constituent-order-a-subject-generally-precedes","revision":1,"topic":"topic:clause/constituent-order-head-final","topics":["topic:clause/constituent-order-head-final","topic:clause/constituent-order-head-final--np-order"],"statement":{"en":"In clause constituent order, a subject generally precedes an object.","ja":"節の構成素順序において、主語は一般に目的語に先行する。"},"type":"ordering","scope":{"doculects":["doculect:hokkaido/southwest/shizunai"],"quantifier":"usually","modality":"actual","conditions":[]},"forms":[],"statements":[{"id":"stmt:refsing1986@gemini-3-flash-preview/l0264-02","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-13-12-354Z","status":"grouped"}
{"id":"claim:clause/constituent-order-head-final--the-order-of-the-indirect-object-and-the","revision":1,"topic":"topic:clause/constituent-order-head-final","topics":["topic:clause/constituent-order-head-final","topic:clause/constituent-order-head-final--np-order"],"statement":{"en":"The order of the indirect object and the direct object in a ditransitive clause can be swapped.","ja":"間接目的語と直接目的語の語順は入れ替わることもある。"},"type":"ordering","scope":{"doculects":["doculect:ainu"],"quantifier":"generic","modality":"possible","conditions":[]},"forms":[],"statements":[{"id":"stmt:sato2008@gemini-3-flash-preview/l0038-05","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-13-12-354Z","status":"grouped"}
{"id":"claim:clause/constituent-order-head-final--because-nouns-lack-case-inflections-word-order-determines","revision":1,"topic":"topic:clause/constituent-order-head-final","topics":["topic:clause/constituent-order-head-final","topic:clause/constituent-order-head-final--np-order"],"statement":{"en":"Because nouns lack case inflections, word order determines the grammatical functions of certain nouns in Ainu.","ja":"名詞に格語尾変化がないため、語順がアイヌ語における特定の名詞の文法機能を決定する上で重要な役割を果たす。"},"type":"analysis","scope":{"doculects":["doculect:ainu"],"quantifier":"all","modality":"actual","conditions":[]},"forms":[],"statements":[{"id":"stmt:shibatani1990@gemini-3-flash-preview/l0020-08","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-13-12-354Z","status":"grouped"}
{"id":"claim:clause/constituent-order-head-final--in-clauses-with-ablative-oblique-nominals-the-subject","revision":1,"topic":"topic:clause/constituent-order-head-final","topics":["topic:clause/constituent-order-head-final","topic:clause/constituent-order-head-final--np-order"],"statement":{"en":"In clauses with ablative oblique nominals, the subject normally precedes the ablative nominal, whereas the object normally follows it, appearing immediately before the verb.","ja":"奪格の斜格名詞句を含む節では、通常、主語は奪格名詞の前に生じ、目的語は奪格名詞の後・動詞の直前に生じる。"},"type":"ordering","scope":{"doculects":["doculect:ainu"],"quantifier":"usually","modality":"actual","conditions":["in clauses with ablative oblique nominals"]},"forms":[],"statements":[{"id":"stmt:shibatani1990@gemini-3-flash-preview/l0038-05","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-13-12-354Z","status":"grouped"}
{"id":"claim:clause/constituent-order-head-final--particles-are-all-postpositions","revision":1,"topic":"topic:clause/constituent-order-head-final","topics":["topic:clause/constituent-order-head-final","topic:clause/constituent-order-head-final--postpositions"],"statement":{"en":"Particles are all postpositions.","ja":"助詞は悉く後置詞である。"},"type":"ordering","scope":{"doculects":["doculect:ainu"],"quantifier":"all","modality":"actual","conditions":[]},"forms":[],"statements":[{"id":"stmt:kindaichi1936@gemini-3-flash-preview/l0210-04","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-13-12-354Z","status":"grouped"}
{"id":"claim:clause/constituent-order-head-final--modifiers-precede-what-they-modify-and-subordinate-clauses","revision":1,"topic":"topic:clause/constituent-order-head-final","topics":["topic:clause/constituent-order-head-final","topic:clause/constituent-order-head-final--profile"],"statement":{"en":"Modifiers precede what they modify, and subordinate clauses come before main clauses.","ja":"修飾語句は被修飾語に前置され、従属節は主節の前に現れる。"},"type":"ordering","scope":{"doculects":["doculect:ainu"],"quantifier":"all","modality":"actual","conditions":[]},"forms":[],"statements":[{"id":"stmt:bugaeva2012@gemini-3-flash-preview/l0008-10","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-13-12-354Z","status":"grouped"}
{"id":"claim:clause/constituent-order-head-final--all-nominal-and-clausal-modifiers-precede-the-element","revision":1,"topic":"topic:clause/constituent-order-head-final","topics":["topic:clause/constituent-order-head-final","topic:clause/constituent-order-head-final--profile"],"statement":{"en":"All nominal and clausal modifiers precede the element they modify in Ainu.","ja":"アイヌ語において修飾語は全て前置される。"},"type":"ordering","scope":{"doculects":["doculect:hokkaido/southwest"],"quantifier":"all","modality":"actual","conditions":[]},"forms":[],"statements":[{"id":"stmt:bugaeva2014@pdftotext-pieces/l0002-05","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-13-12-354Z","status":"grouped"}
{"id":"claim:clause/constituent-order-head-final--adjectives-precede-nouns-and-adverbs-precede-verbs","revision":1,"topic":"topic:clause/constituent-order-head-final","topics":["topic:clause/constituent-order-head-final","topic:clause/constituent-order-head-final--profile"],"statement":{"en":"Adjectives precede nouns, and adverbs precede verbs.","ja":"從つて形容詞は名詞に、副詞は動詞に先行する。"},"type":"ordering","scope":{"doculects":["doculect:ainu"],"quantifier":"all","modality":"actual","conditions":[]},"forms":[],"statements":[{"id":"stmt:kindaichi1936@gemini-3-flash-preview/l0210-02","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-13-12-354Z","status":"grouped"}
{"id":"claim:clause/constituent-order-head-final--in-ainu-only-noun-phrases-can-serve-as","revision":1,"topic":"topic:clause/constituent-order-head-final","topics":["topic:clause/constituent-order-head-final","topic:clause/constituent-order-head-final--profile"],"statement":{"en":"In Ainu, only noun phrases can serve as arguments of a verb phrase, and the number of noun phrases a verb phrase can take is fixed by its valency (arity).","ja":"アイヌ語において、動詞句の項となることができるのは名詞句だけであり、動詞句ごとに取ることができる名詞句の数は決まっていて、それ以上の名詞句をとることはできない。"},"type":"distribution","scope":{"doculects":["doculect:ainu"],"quantifier":"all","modality":"necessary","conditions":[]},"forms":[],"statements":[{"id":"stmt:nakagawa2024@gemini-3-flash-preview/l0357-01","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-13-12-354Z","status":"grouped"}
{"id":"claim:clause/constituent-order-head-final--elements-showing-case-relations-follow-the-noun-phrase","revision":1,"topic":"topic:clause/constituent-order-head-final","topics":["topic:clause/constituent-order-head-final","topic:clause/constituent-order-head-final--profile"],"statement":{"en":"Elements showing case relations follow the noun phrase, auxiliary verbs follow verbs, and noun modifiers (such as adnominals and verb phrases) precede the head noun.","ja":"格関係を示すものは名詞句の後に、助動詞は動詞の後ろに、連体詞や動詞句などの名詞修飾要素は被修飾要素である名詞の前に置かれる。"},"type":"ordering","scope":{"doculects":["doculect:ainu"],"quantifier":"generic","modality":"necessary","conditions":[]},"forms":[],"statements":[{"id":"stmt:nakagawa2024@gemini-3-flash-preview/l0361-02","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-13-12-354Z","status":"grouped"}
{"id":"claim:clause/constituent-order-head-final--ainu-word-order-is-basically-the-same-as","revision":1,"topic":"topic:clause/constituent-order-head-final","topics":["topic:clause/constituent-order-head-final","topic:clause/constituent-order-head-final--profile"],"statement":{"en":"Ainu word order is basically the same as Japanese word order.","ja":"アイヌ語の語順は日本語と基本的に同じである。"},"type":"ordering","scope":{"doculects":["doculect:ainu"],"quantifier":"generic","modality":"actual","conditions":[]},"forms":[],"statements":[{"id":"stmt:sato2008@gemini-3-flash-preview/l0019-01","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-13-12-354Z","status":"grouped"}
{"id":"claim:clause/constituent-order-head-final--the-basic-word-order-in-ainu-is-aov","revision":1,"topic":"topic:clause/constituent-order-head-final","topics":["topic:clause/constituent-order-head-final","topic:clause/constituent-order-head-final--verb-final"],"statement":{"en":"The basic word order in Ainu is AOV.","ja":"アイヌ語の基本語順はAOVである。"},"type":"distribution","scope":{"doculects":["doculect:ainu"],"quantifier":"generic","modality":"actual","conditions":[]},"forms":[],"statements":[{"id":"stmt:bugaeva2015@gemini-3-flash-preview/l0015-01","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-13-12-354Z","status":"grouped"}
{"id":"claim:clause/constituent-order-head-final--when-the-subject-appears-as-an-independent-word","revision":1,"topic":"topic:clause/constituent-order-head-final","topics":["topic:clause/constituent-order-head-final","topic:clause/constituent-order-head-final--verb-final"],"statement":{"en":"When the subject appears as an independent word (noun or pronoun), which is limited to the third person, the constituent order is 'subject + Class II verb' or 'subject + object/complement + Class I verb'.","ja":"主語が單語（名詞・代名詞）として現はれる場合（第III人稱に限る）には、「主語＋動詞（第II類）」或は「主語＋目的語或は補足語＋動詞（第I類）」の順序である。"},"type":"ordering","scope":{"doculects":["doculect:ainu"],"quantifier":"all","modality":"actual","conditions":["when subject is an independent word (third person)"]},"forms":[],"statements":[{"id":"stmt:kindaichi1936@gemini-3-flash-preview/l0210-05","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-13-12-354Z","status":"grouped"}
{"id":"claim:clause/constituent-order-head-final--for-class-i-verbs-first-person-subject-markers","revision":1,"topic":"topic:clause/constituent-order-head-final","topics":["topic:clause/constituent-order-head-final","topic:clause/constituent-order-head-final--verb-final"],"statement":{"en":"For Class I verbs, first-person subject markers appear as prefixes, resulting in the order 'object/complement + (subject-)verb'.","ja":"第I類の動詞において第I人稱主語は接頭辭として現はれ、目的語または補足語をとる場合は「目的語或は補足語＋(主語)動詞」の順序をとる。"},"type":"ordering","scope":{"doculects":["doculect:ainu"],"quantifier":"all","modality":"actual","conditions":["first person with Class I verbs"]},"forms":["a-"],"statements":[{"id":"stmt:kindaichi1936@gemini-3-flash-preview/l0211-01","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-13-12-354Z","status":"grouped"}
{"id":"claim:clause/constituent-order-head-final--the-basic-constituent-order-of-a-sakhalin-ainu","revision":1,"topic":"topic:clause/constituent-order-head-final","topics":["topic:clause/constituent-order-head-final","topic:clause/constituent-order-head-final--verb-final"],"statement":{"en":"The basic constituent order of a Sakhalin Ainu clause is SOV, with the verb phrase occurring sentence-finally.","ja":"樺太アイヌ語の文は SOV 型の語順で、動詞部（VP）が最後に来る。"},"type":"ordering","scope":{"doculects":["doculect:sakhalin"],"quantifier":"generic","modality":"actual","conditions":[]},"forms":[],"statements":[{"id":"stmt:murasaki2025@gemini-3-flash-preview/l0097-04","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-13-12-354Z","status":"grouped"}
{"id":"claim:clause/constituent-order-head-final--sakhalin-ainu-distinguishes-six-simple-clause-types-by","revision":1,"topic":"topic:clause/constituent-order-head-final","topics":["topic:clause/constituent-order-head-final","topic:clause/constituent-order-head-final--verb-final"],"statement":{"en":"Sakhalin Ainu distinguishes six simple clause types by the argument requirements of the VP: complete verb clause (0 NPs), designating clause (2 NPs + CP), existential clause (1 NP + EV), intransitive clause (1 NP + VP1), monotransitive clause (2 NPs + VP2), and ditransitive clause (3 NPs + VP3).","ja":"樺太アイヌ語では、VPのNPの取り方によって、完全動詞文（0項）、指定詞文（2項+CP）、存在詞文（1項+EV）、自動詞文（1項+VP1）、一他動詞文（2項+VP2）、二他動詞文（3項+VP3）の6つの文タイプが区別される。"},"type":"analysis","scope":{"doculects":["doculect:sakhalin"],"quantifier":"all","modality":"actual","conditions":[]},"forms":[],"statements":[{"id":"stmt:murasaki2025@gemini-3-flash-preview/l0097-05","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-13-12-354Z","status":"grouped"}
{"id":"claim:clause/constituent-order-head-final--a-sentence-final-phrase-expressing-evidential-grounding-or","revision":1,"topic":"topic:clause/constituent-order-head-final","topics":["topic:clause/constituent-order-head-final","topic:clause/constituent-order-head-final--verb-final"],"statement":{"en":"A sentence-final phrase expressing evidential grounding or speaker attitude can be placed after the verb phrase, but a sentence is grammatically complete without it.","ja":"動詞句の後ろには話者の判断の根拠や聞き手に対する気持ちなどを表す文末句を置くことができるが、無くても文は成立する。"},"type":"distribution","scope":{"doculects":["doculect:ainu"],"quantifier":"generic","modality":"possible","conditions":[]},"forms":[],"statements":[{"id":"stmt:nakagawa2024@gemini-3-flash-preview/l0357-03","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-13-12-354Z","status":"grouped"}
{"id":"claim:clause/constituent-order-head-final--in-an-ainu-clause-the-verb-phrase-plus","revision":1,"topic":"topic:clause/constituent-order-head-final","topics":["topic:clause/constituent-order-head-final","topic:clause/constituent-order-head-final--verb-final"],"statement":{"en":"In an Ainu clause, the verb phrase (plus any sentence-final phrase) occurs sentence-finally, and all other elements precede it.","ja":"アイヌ語の文は、動詞句（＋文末句）が最後に来て、それ以外の要素はその前に置かれる。"},"type":"ordering","scope":{"doculects":["doculect:ainu"],"quantifier":"all","modality":"necessary","conditions":[]},"forms":[],"statements":[{"id":"stmt:nakagawa2024@gemini-3-flash-preview/l0359-03","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-13-12-354Z","status":"grouped"}
{"id":"claim:clause/constituent-order-head-final--a-sentence-whose-total-arity-sums-to-0","revision":1,"topic":"topic:clause/constituent-order-head-final","topics":["topic:clause/constituent-order-head-final","topic:clause/constituent-order-head-final--verb-final"],"statement":{"en":"A sentence whose total arity sums to 0 is a complete sentence, whereas a sentence whose arity is non-zero is an incomplete sentence.","ja":"文中のアリティの合計が 0 である文は完結文であり、0 以外である文は未完結文である。"},"type":"terminology","scope":{"doculects":["doculect:ainu"],"quantifier":"all","modality":"actual","conditions":[]},"forms":[],"statements":[{"id":"stmt:nakagawa2024@gemini-3-flash-preview/l0366-02","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-13-12-354Z","status":"grouped"}
{"id":"claim:clause/constituent-order-head-final--noun-phrases-and-adverbial-phrases-occur-outside-the","revision":1,"topic":"topic:clause/constituent-order-head-final","topics":["topic:clause/constituent-order-head-final","topic:clause/constituent-order-head-final--verb-final"],"statement":{"en":"Noun phrases and adverbial phrases occur outside the verb phrase, whereas elements other than the main verb inside the verb phrase follow the verb.","ja":"名詞句や副詞句は動詞句の外にある要素であり、動詞句内にある主動詞以外の要素は、動詞の後ろに来る。"},"type":"ordering","scope":{"doculects":["doculect:hokkaido"],"quantifier":"all","modality":"actual","conditions":[]},"forms":[],"statements":[{"id":"stmt:nakagawa2024@gemini-3-flash-preview/l0367-01","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-13-12-354Z","status":"grouped"}
{"id":"claim:clause/constituent-order-head-final--the-element-at-the-head-of-a-verb","revision":1,"topic":"topic:clause/constituent-order-head-final","topics":["topic:clause/constituent-order-head-final","topic:clause/constituent-order-head-final--verb-final"],"statement":{"en":"The element at the head of a verb phrase is analyzed as the main verb, even in third-person contexts where personal affixes do not overtly mark it.","ja":"人称接辞によって主動詞であることが示されていなくても（つまり3人称の場合でも）、動詞句の先頭にあるのが主動詞であると考えることができる。"},"type":"analysis","scope":{"doculects":["doculect:hokkaido"],"quantifier":"all","modality":"actual","conditions":[]},"forms":[],"statements":[{"id":"stmt:nakagawa2024@gemini-3-flash-preview/l0367-02","stance":"proposes"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-13-12-354Z","status":"grouped"}
{"id":"claim:clause/constituent-order-head-final--a-predicate-consists-of-either-a-verb-expression","revision":1,"topic":"topic:clause/constituent-order-head-final","topics":["topic:clause/constituent-order-head-final","topic:clause/constituent-order-head-final--verb-final"],"statement":{"en":"A predicate consists of either a verb expression or a copula expression, which may or may not be followed by a sentence-final form or suffix.","ja":"述語は動詞表現または係辞表現のいずれかであり、文末形式／接尾辞が後続する場合と後続しない場合がある。"},"type":"analysis","scope":{"doculects":["doculect:hokkaido/southwest/shizunai"],"quantifier":"all","modality":"actual","conditions":[]},"forms":[],"statements":[{"id":"stmt:refsing1986@gemini-3-flash-preview/l0264-04","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-13-12-354Z","status":"grouped"}
{"id":"claim:clause/constituent-order-head-final--a-predicate-without-any-adjuncts-may-in-itself","revision":1,"topic":"topic:clause/constituent-order-head-final","topics":["topic:clause/constituent-order-head-final","topic:clause/constituent-order-head-final--verb-final"],"statement":{"en":"A predicate without any adjuncts may in itself form a complete sentence.","ja":"付加語を伴わない述語だけで文を構成することができる。"},"type":"distribution","scope":{"doculects":["doculect:hokkaido/southwest/shizunai"],"quantifier":"generic","modality":"possible","conditions":[]},"forms":[],"statements":[{"id":"stmt:refsing1986@gemini-3-flash-preview/l0264-05","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-13-12-354Z","status":"grouped"}
{"id":"claim:clause/constituent-order-head-final--in-ainu-clauses-verbs-are-normally-placed-at","revision":1,"topic":"topic:clause/constituent-order-head-final","topics":["topic:clause/constituent-order-head-final","topic:clause/constituent-order-head-final--verb-final"],"statement":{"en":"In Ainu clauses, verbs are normally placed at the end of the sentence, but the mutual ordering of subjects, objects, complements, and adjunct modifiers can vary.","ja":"動詞は通常文末に置かれるが，主語，目的語，補語，修飾語の相互の順序は入れかわることもある。"},"type":"ordering","scope":{"doculects":["doculect:ainu"],"quantifier":"usually","modality":"actual","conditions":[]},"forms":[],"statements":[{"id":"stmt:sato2008@gemini-3-flash-preview/l0038-07","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-13-12-354Z","status":"grouped"}
{"id":"claim:clause/constituent-order-head-final--sentences-in-ainu-frequently-lack-overt-subjects-because","revision":1,"topic":"topic:clause/constituent-order-head-final","topics":["topic:clause/constituent-order-head-final","topic:clause/constituent-order-head-final--verb-final"],"statement":{"en":"Sentences in Ainu frequently lack overt subjects because person is indexed on predicates.","ja":"アイヌ語では人称が述語に標示されるため、多くの文が明示的な主語を持たない。"},"type":"distribution","scope":{"doculects":["doculect:ainu"],"quantifier":"generic","modality":"actual","conditions":[]},"forms":[],"statements":[{"id":"stmt:shibatani1990@gemini-3-flash-preview/l0018-03","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-13-12-354Z","status":"grouped"}

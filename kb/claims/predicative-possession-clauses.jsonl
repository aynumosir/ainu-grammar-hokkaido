{"id":"claim:clause/predicative-possession-clauses--existential-possession-an-oka","revision":1,"topic":"topic:clause/predicative-possession-clauses","topics":["topic:clause/predicative-possession-clauses","topic:clause/predicative-possession-clauses--be-possession"],"statement":{"en":"Possession other than inalienable possession may be expressed by constructions using the existential verb an (singular) or oka (plural).","ja":"譲渡不可能所有以外の所有は、存在動詞 an（単数）または oka（複数）を用いた構文によって表すことができる。"},"type":"form-function","scope":{"doculects":["doculect:hokkaido/southwest/shizunai"],"quantifier":"may","modality":"possibility","conditions":["alienable or non-inalienable possession"]},"forms":["an","oka"],"statements":[{"id":"stmt:refsing1986@gemini-3-flash-preview/l0154-10","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-26T08-31-28-856Z","status":"grouped"}

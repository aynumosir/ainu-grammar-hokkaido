{"id":"claim:complex/sequential-wa-and-clause-chaining--sakhalin-teh-sequential-completion","revision":1,"topic":"topic:complex/sequential-wa-and-clause-chaining","topics":["topic:complex/sequential-wa-and-clause-chaining"],"statement":{"en":"In Sakhalin Ainu, the conjunctive particle teh indicates that an action finishes before the subsequent action takes place ('after doing, having done').","ja":"樺太アイヌ語において、接続助詞tehは先行する動作が終了してから次の動作が行われること（「〜して」「〜てから」）を表す。"},"type":"form-function","scope":{"doculects":["doculect:sakhalin"],"quantifier":"all","modality":"asserted","conditions":[]},"forms":["teh"],"statements":[{"id":"stmt:murasaki2025@gemini-3-flash-preview/l0065-01","stance":"asserts"},{"id":"stmt:murasaki2025@gemini-3-flash-preview/l0102-03","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-13-12-354Z","status":"grouped"}
{"id":"claim:complex/sequential-wa-and-clause-chaining--saru-ma-allomorph-of-wa","revision":1,"topic":"topic:complex/sequential-wa-and-clause-chaining","topics":["topic:complex/sequential-wa-and-clause-chaining","topic:complex/sequential-wa-and-clause-chaining--allomorph-ma"],"statement":{"en":"In Saru Ainu, ma is an alternating form of the conjunctive particle wa.","ja":"沙流アイヌ語において、maは接続助詞waの交替形である。"},"type":"alternation","scope":{"doculects":["doculect:hokkaido/southwest/saru"],"quantifier":"all","modality":"asserted","conditions":[]},"forms":["ma","wa"],"statements":[{"id":"stmt:sato2008@gemini-3-flash-preview/l0320-02","stance":"asserts"},{"id":"stmt:sato2008@gemini-3-flash-preview/l0328-03","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-13-12-354Z","status":"grouped"}
{"id":"claim:complex/sequential-wa-and-clause-chaining--in-sakhalin-ainu-the-conjunction-tex-cognate-with","revision":1,"topic":"topic:complex/sequential-wa-and-clause-chaining","topics":["topic:complex/sequential-wa-and-clause-chaining"],"statement":{"en":"In Sakhalin Ainu, the conjunction tex (cognate with Hokkaido te) is also used.","ja":"これは樺太においても行はれ、接続助詞 tex が使われる。"},"type":"existence","scope":{"doculects":["doculect:sakhalin"],"quantifier":"unstated","modality":"actual","conditions":[]},"forms":["tex"],"statements":[{"id":"stmt:kindaichi1936@gemini-3-flash-preview/l0160-01","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-13-12-354Z","status":"grouped"}
{"id":"claim:complex/sequential-wa-and-clause-chaining--in-saru-and-chitose-tek-is-not-used","revision":1,"topic":"topic:complex/sequential-wa-and-clause-chaining","topics":["topic:complex/sequential-wa-and-clause-chaining"],"statement":{"en":"In Saru and Chitose, tek is not used as a conjunctive particle, but functions as an auxiliary verb or secondary particle meaning that an action is performed in a short time ('abruptly, quickly').","ja":"沙流方言や千歳方言では tek は接続助詞としては使われず、助動詞や副助詞として短い時間で行為が行われること（「ぱっと〜する、さっと〜する」）を指す。"},"type":"form-function","scope":{"doculects":["doculect:hokkaido/southwest/saru","doculect:hokkaido/chitose"],"quantifier":"generic","modality":"actual","conditions":[]},"forms":["tek"],"statements":[{"id":"stmt:nakagawa2024@gemini-3-flash-preview/l0340-02","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-13-12-354Z","status":"grouped"}
{"id":"claim:complex/sequential-wa-and-clause-chaining--in-western-hokkaido-dialects-close-to-saru-such","revision":1,"topic":"topic:complex/sequential-wa-and-clause-chaining","topics":["topic:complex/sequential-wa-and-clause-chaining"],"statement":{"en":"In western Hokkaido dialects close to Saru, such as Horobetsu and Shizunai, the conjunctive particle tek is semantically constrained to actions in the preceding clause occurring in a short time, whereas other dialects show no such restriction.","ja":"沙流方言に近い幌別、静内といった北海道西部の方言では、接続助詞 tek に「前文の行為が短時間で行われる」という意味の制限があるが、それ以外の方言にはそういった制約がない。"},"type":"variation","scope":{"doculects":["doculect:hokkaido/southwest/horobetsu","doculect:hokkaido/southwest/shizunai"],"quantifier":"generic","modality":"actual","conditions":[]},"forms":["tek"],"statements":[{"id":"stmt:nakagawa2024@gemini-3-flash-preview/l0341-01","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-13-12-354Z","status":"grouped"}
{"id":"claim:complex/sequential-wa-and-clause-chaining--the-conjunctionalizer-tek-is-used-only-rarely-in","revision":1,"topic":"topic:complex/sequential-wa-and-clause-chaining","topics":["topic:complex/sequential-wa-and-clause-chaining"],"statement":{"en":"The conjunctionalizer tek is used only rarely in the Shizunai dialect.","ja":"接続助詞tekは静内方言では稀にしか用いられない。"},"type":"frequency","scope":{"doculects":["doculect:hokkaido/southwest/shizunai"],"quantifier":"unstated","modality":"actual","conditions":[]},"forms":["tek"],"statements":[{"id":"stmt:refsing1986@gemini-3-flash-preview/l0240-06","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-13-12-354Z","status":"grouped"}
{"id":"claim:complex/sequential-wa-and-clause-chaining--the-meaning-of-tek-is-purely-temporal-marking","revision":1,"topic":"topic:complex/sequential-wa-and-clause-chaining","topics":["topic:complex/sequential-wa-and-clause-chaining"],"statement":{"en":"The meaning of tek is purely temporal, marking that the event in the conjunctionalized sentence occurs before the main predicate with no causal relationship indicated.","ja":"tekの意味は純粋に時間的であり、接続節の出来事が主述語の表す出来事より前に起こることを示し、両者の間に因果関係は示されない。"},"type":"form-function","scope":{"doculects":["doculect:hokkaido/southwest/shizunai"],"quantifier":"unstated","modality":"actual","conditions":[]},"forms":["tek"],"statements":[{"id":"stmt:refsing1986@gemini-3-flash-preview/l0240-07","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-13-12-354Z","status":"grouped"}
{"id":"claim:complex/sequential-wa-and-clause-chaining--the-conjunction-wa-has-the-allomorph-ma-after","revision":1,"topic":"topic:complex/sequential-wa-and-clause-chaining","topics":["topic:complex/sequential-wa-and-clause-chaining","topic:complex/sequential-wa-and-clause-chaining--allomorph-ma"],"statement":{"en":"The conjunction wa has the allomorph ma after predicates ending in -n or -m.","ja":"接続辞waは、-nまたは-mで終わる述語の後で異形態maをとる。"},"type":"alternation","scope":{"doculects":["doculect:hokkaido/southwest/shizunai"],"quantifier":"all","modality":"necessary","conditions":["after predicates ending in -n or -m"]},"forms":["wa","ma"],"statements":[{"id":"stmt:refsing1986@gemini-3-flash-preview/l0234-06","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-13-12-354Z","status":"grouped"}
{"id":"claim:complex/sequential-wa-and-clause-chaining--after-verbs-with-negative-meanings-the-connective-doing","revision":1,"topic":"topic:complex/sequential-wa-and-clause-chaining","topics":["topic:complex/sequential-wa-and-clause-chaining","topic:complex/sequential-wa-and-clause-chaining--allomorph-ma"],"statement":{"en":"After verbs with negative meanings, the connective 'doing...' is expressed by no instead of wa.","ja":"否定の意味の動詞の後では「〜して」は wa ではなく no という形式で表される。"},"type":"distribution","scope":{"doculects":["doculect:hokkaido"],"quantifier":"generic","modality":"actual","conditions":["after verbs with negative meaning"]},"forms":["wa","no"],"statements":[{"id":"stmt:sato2008@gemini-3-flash-preview/l0191-01","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-13-12-354Z","status":"grouped"}
{"id":"claim:complex/sequential-wa-and-clause-chaining--the-particle-wa-and-ing-alternates-to-ma","revision":1,"topic":"topic:complex/sequential-wa-and-clause-chaining","topics":["topic:complex/sequential-wa-and-clause-chaining","topic:complex/sequential-wa-and-clause-chaining--allomorph-ma"],"statement":{"en":"The particle wa 'and / -ing' alternates to ma after the consonant n.","ja":"wa「て」は n の後で ma に交替する。"},"type":"alternation","scope":{"doculects":["doculect:ainu"],"quantifier":"all","modality":"necessary","conditions":["after n"]},"forms":["wa","ma"],"statements":[{"id":"stmt:sato2008@gemini-3-flash-preview/l0323-01","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-13-12-354Z","status":"grouped"}
{"id":"claim:complex/sequential-wa-and-clause-chaining--pa-is-an-allomorph-or-variant-of-the","revision":1,"topic":"topic:complex/sequential-wa-and-clause-chaining","topics":["topic:complex/sequential-wa-and-clause-chaining","topic:complex/sequential-wa-and-clause-chaining--allomorph-ma"],"statement":{"en":"pa is an allomorph or variant of the conjunctive particle wa 'and then / doing...'.","ja":"pa は接続助詞 wa「〜て」の異形である。"},"type":"alternation","scope":{"doculects":[],"quantifier":"unstated","modality":"actual","conditions":[]},"forms":["pa","wa"],"statements":[{"id":"stmt:sato2008@gemini-3-flash-preview/l0388-07","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-13-12-354Z","status":"grouped"}
{"id":"claim:complex/sequential-wa-and-clause-chaining--the-conjunction-aine-derived-from-a-hine-indicates","revision":1,"topic":"topic:complex/sequential-wa-and-clause-chaining","topics":["topic:complex/sequential-wa-and-clause-chaining","topic:complex/sequential-wa-and-clause-chaining--ayne-culminative"],"statement":{"en":"The conjunction aine (derived from a-hine) indicates the result of an action continuing for some time, with meanings such as 'in the course of doing...' or 'in the end'.","ja":"aine (a-hine) は動作が若干時継続したその結果を示し、「……するほどに」「あげくに」等の意味である。"},"type":"form-function","scope":{"doculects":[],"quantifier":"unstated","modality":"actual","conditions":[]},"forms":["aine","a-hine"],"statements":[{"id":"stmt:kindaichi1936@gemini-3-flash-preview/l0160-06","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-13-12-354Z","status":"grouped"}
{"id":"claim:complex/sequential-wa-and-clause-chaining--ayne-relates-two-predicates-temporally-such-that-the","revision":1,"topic":"topic:complex/sequential-wa-and-clause-chaining","topics":["topic:complex/sequential-wa-and-clause-chaining","topic:complex/sequential-wa-and-clause-chaining--ayne-culminative"],"statement":{"en":"Ayne relates two predicates temporally such that the main predicate is realized after the events of the embedded clause have been going on for some time, carrying a nuance of impatience on behalf of the speaker ('and then finally').","ja":"ayneは2つの述語を時間的に結びつけ、従属節の出来事がしばらく続いた後に主述語が実現することを示し、話者の焦燥感のニュアンス（「…そしてとうとう…」）を伴う。"},"type":"form-function","scope":{"doculects":["doculect:hokkaido/southwest/shizunai"],"quantifier":"unstated","modality":"actual","conditions":[]},"forms":["ayne"],"statements":[{"id":"stmt:refsing1986@gemini-3-flash-preview/l0240-13","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-13-12-354Z","status":"grouped"}
{"id":"claim:complex/sequential-wa-and-clause-chaining--the-implication-of-ayne-that-an-act-or","revision":1,"topic":"topic:complex/sequential-wa-and-clause-chaining","topics":["topic:complex/sequential-wa-and-clause-chaining","topic:complex/sequential-wa-and-clause-chaining--ayne-culminative"],"statement":{"en":"The implication of ayne that an act or event has been going on for a long time may be further clarified by using the iterative or durative auxiliary ...-a...-a.","ja":"ayneが持つ行為や出来事が長時間続いていたという含意は、反復または継続の助動詞…-a…-aを用いることによってさらに明確にされ得る。"},"type":"distribution","scope":{"doculects":["doculect:hokkaido/southwest/shizunai"],"quantifier":"unstated","modality":"possible","conditions":[]},"forms":["ayne","-a"],"statements":[{"id":"stmt:refsing1986@gemini-3-flash-preview/l0240-14","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-13-12-354Z","status":"grouped"}
{"id":"claim:complex/sequential-wa-and-clause-chaining--when-the-predicate-of-a-clause-conjunctionalized-with","revision":1,"topic":"topic:complex/sequential-wa-and-clause-chaining","topics":["topic:complex/sequential-wa-and-clause-chaining","topic:complex/sequential-wa-and-clause-chaining--disambiguation"],"statement":{"en":"When the predicate of a clause conjunctionalized with wa is the copula ne, it functions together with wa as an emphatic definition of the subject (or occasionally the object) of the final predicate.","ja":"接続文化された節の述語が係辞neである場合、waとともに機能して、最終述語の主語（またはときに目的語）の強調的な限定を形成する。"},"type":"form-function","scope":{"doculects":["doculect:hokkaido/southwest/shizunai"],"quantifier":"generic","modality":"possible","conditions":["predicate is the copula ne"]},"forms":["ne wa","ne","wa"],"statements":[{"id":"stmt:refsing1986@gemini-3-flash-preview/l0234-02","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-13-12-354Z","status":"grouped"}
{"id":"claim:complex/sequential-wa-and-clause-chaining--the-ne-wa-emphatic-definition-construction-is-very","revision":1,"topic":"topic:complex/sequential-wa-and-clause-chaining","topics":["topic:complex/sequential-wa-and-clause-chaining","topic:complex/sequential-wa-and-clause-chaining--disambiguation"],"statement":{"en":"The ne wa emphatic definition construction is very common with numerical expressions.","ja":"数詞表現を伴う場合、このne wa構文は非常に一般的である。"},"type":"frequency","scope":{"doculects":["doculect:hokkaido/southwest/shizunai"],"quantifier":"generic","modality":"actual","conditions":["with numerical expressions"]},"forms":["ne wa"],"statements":[{"id":"stmt:refsing1986@gemini-3-flash-preview/l0234-03","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-13-12-354Z","status":"grouped"}
{"id":"claim:complex/sequential-wa-and-clause-chaining--the-connective-particle-wa-is-thought-to-derive","revision":1,"topic":"topic:complex/sequential-wa-and-clause-chaining","topics":["topic:complex/sequential-wa-and-clause-chaining","topic:complex/sequential-wa-and-clause-chaining--overview"],"statement":{"en":"The connective particle wa is thought to derive from the ablative particle wa transferred to temporal relations, indicating that an action concludes and another action follows it.","ja":"接続助詞 wa は奪格の wa が時間関係に転用されたものと考えられ、ある動作が終わって他の動作がそれに続くことを示す。"},"type":"form-function","scope":{"doculects":[],"quantifier":"unstated","modality":"actual","conditions":[]},"forms":["wa"],"statements":[{"id":"stmt:kindaichi1936@gemini-3-flash-preview/l0159-02","stance":"proposes"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-13-12-354Z","status":"grouped"}
{"id":"claim:complex/sequential-wa-and-clause-chaining--wa-connects-clauses-with-the-meaning-of-sequential","revision":1,"topic":"topic:complex/sequential-wa-and-clause-chaining","topics":["topic:complex/sequential-wa-and-clause-chaining","topic:complex/sequential-wa-and-clause-chaining--overview"],"statement":{"en":"wa connects clauses with the meaning of sequential action (\"doing ... and then doing ...\").","ja":"wa は「～して～する」という前後の動作の接続を表す。"},"type":"form-function","scope":{"doculects":["doculect:sakhalin"],"quantifier":"unstated","modality":"actual","conditions":[]},"forms":["wa"],"statements":[{"id":"stmt:murasaki2025@gemini-3-flash-preview/l0066-05","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-13-12-354Z","status":"grouped"}
{"id":"claim:complex/sequential-wa-and-clause-chaining--when-two-action-verbs-are-conjoined-the-conjunctive","revision":1,"topic":"topic:complex/sequential-wa-and-clause-chaining","topics":["topic:complex/sequential-wa-and-clause-chaining","topic:complex/sequential-wa-and-clause-chaining--overview"],"statement":{"en":"When two action verbs are conjoined, the conjunctive particle wa is used, but when the first verb expresses a property or state, no is used.","ja":"2つの動作動詞を接続する際には接続助詞waが用いられるが、第1の動詞が属性や状態を表す場合にはnoが用いられる。"},"type":"distribution","scope":{"doculects":["doculect:ainu"],"quantifier":"usually","modality":"necessary","conditions":[]},"forms":["wa","no"],"statements":[{"id":"stmt:nakagawa2022pos@handbook-epub/l0091-10","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-13-12-354Z","status":"grouped"}
{"id":"claim:complex/sequential-wa-and-clause-chaining--in-the-horobetsu-saru-and-chitose-dialects-successive","revision":1,"topic":"topic:complex/sequential-wa-and-clause-chaining","topics":["topic:complex/sequential-wa-and-clause-chaining","topic:complex/sequential-wa-and-clause-chaining--overview"],"statement":{"en":"In the Horobetsu, Saru, and Chitose dialects, successive events are primarily linked with wa and hine, while tek is overwhelmingly used as an auxiliary verb indicating that an action occurred in a light, short time.","ja":"幌別、沙流、千歳方言では、継起は主に wa および hine で表され、tek は動作が軽微で短い時間で行われたことを表す補助動詞として圧倒的に用いられる。"},"type":"form-function","scope":{"doculects":["doculect:hokkaido/southwest/horobetsu","doculect:hokkaido/southwest/saru","doculect:hokkaido/chitose"],"quantifier":"usually","modality":"actual","conditions":[]},"forms":["wa","hine","tek"],"statements":[{"id":"stmt:nakagawafukazawa2022@handbook-epub/l0051-14","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-13-12-354Z","status":"grouped"}
{"id":"claim:complex/sequential-wa-and-clause-chaining--in-the-shizunai-samani-tokachi-kushiro-shiranuka-and","revision":1,"topic":"topic:complex/sequential-wa-and-clause-chaining","topics":["topic:complex/sequential-wa-and-clause-chaining","topic:complex/sequential-wa-and-clause-chaining--overview"],"statement":{"en":"In the Shizunai, Samani, Tokachi, Kushiro, Shiranuka, and Ishikari dialects, tek is frequently used as a conjunctional particle linking successive events.","ja":"静内、様似、十勝、釧路、白糠、石狩などの諸方言では、tek は継起の接続助詞として頻繁に用いられる。"},"type":"distribution","scope":{"doculects":["doculect:hokkaido/southwest/shizunai","doculect:hokkaido/southwest/samani","doculect:hokkaido/central/tokachi","doculect:hokkaido/northeast/kushiro","doculect:hokkaido/central/ishikari"],"quantifier":"usually","modality":"actual","conditions":[]},"forms":["tek"],"statements":[{"id":"stmt:nakagawafukazawa2022@handbook-epub/l0051-15","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-13-12-354Z","status":"grouped"}
{"id":"claim:complex/sequential-wa-and-clause-chaining--the-conjunctive-particle-wa-is-one-of-the","revision":1,"topic":"topic:complex/sequential-wa-and-clause-chaining","topics":["topic:complex/sequential-wa-and-clause-chaining","topic:complex/sequential-wa-and-clause-chaining--overview"],"statement":{"en":"The conjunctive particle wa is one of the most frequently used words in Ainu.","ja":"接続助詞 wa は，アイヌ語の単語の中でも最も使用頻度が高い語の一つである。"},"type":"frequency","scope":{"doculects":["doculect:hokkaido"],"quantifier":"generic","modality":"actual","conditions":[]},"forms":["wa"],"statements":[{"id":"stmt:sato2008@gemini-3-flash-preview/l0062-02","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-13-12-354Z","status":"grouped"}
{"id":"claim:complex/sequential-wa-and-clause-chaining--wa-functions-as-a-coordinate-conjunctive-particle-linking","revision":1,"topic":"topic:complex/sequential-wa-and-clause-chaining","topics":["topic:complex/sequential-wa-and-clause-chaining","topic:complex/sequential-wa-and-clause-chaining--overview"],"statement":{"en":"Wa functions as a coordinate conjunctive particle linking clauses.","ja":"wa は節を連結する等位接続不変化詞として機能する。"},"type":"form-function","scope":{"doculects":["doculect:ainu"],"quantifier":"all","modality":"actual","conditions":[]},"forms":["wa"],"statements":[{"id":"stmt:shibatani1990@gemini-3-flash-preview/l0019-08","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-13-12-354Z","status":"grouped"}
{"id":"claim:complex/sequential-wa-and-clause-chaining--in-the-sakhalin-dialect-wa-is-used-to","revision":1,"topic":"topic:complex/sequential-wa-and-clause-chaining","topics":["topic:complex/sequential-wa-and-clause-chaining","topic:complex/sequential-wa-and-clause-chaining--overview"],"statement":{"en":"In the Sakhalin dialect, wa is used to link two simultaneous activities that are perceived as forming one coherent action.","ja":"樺太方言では、wa は単一のまとまった動作として知覚される2つの同時的な活動を表すのにも用いられる。"},"type":"form-function","scope":{"doculects":["doculect:sakhalin"],"quantifier":"generic","modality":"actual","conditions":["two simultaneous activities perceived as one coherent action"]},"forms":["wa"],"statements":[{"id":"stmt:shibatani1990@gemini-3-flash-preview/l0019-09","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-13-12-354Z","status":"grouped"}
{"id":"claim:complex/sequential-wa-and-clause-chaining--the-conjunctive-particle-wa-is-limited-to-conjoining","revision":1,"topic":"topic:complex/sequential-wa-and-clause-chaining","topics":["topic:complex/sequential-wa-and-clause-chaining","topic:complex/sequential-wa-and-clause-chaining--overview"],"statement":{"en":"The conjunctive particle wa is limited to conjoining sentences and verbal phrases.","ja":"接続助詞 wa は文および動詞句の結合に限定される。"},"type":"distribution","scope":{"doculects":["doculect:ainu"],"quantifier":"all","modality":"actual","conditions":[]},"forms":["wa"],"statements":[{"id":"stmt:shibatani1990@gemini-3-flash-preview/l0020-01","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-13-12-354Z","status":"grouped"}
{"id":"claim:complex/sequential-wa-and-clause-chaining--in-northern-dialects-the-sequential-connective-function-of","revision":1,"topic":"topic:complex/sequential-wa-and-clause-chaining","topics":["topic:complex/sequential-wa-and-clause-chaining","topic:complex/sequential-wa-and-clause-chaining--readings"],"statement":{"en":"In northern dialects, the sequential connective function of wa is sometimes expressed by tek.","ja":"北部方言では接続助詞 wa の働きを tek で表すことがある。"},"type":"variation","scope":{"doculects":[],"quantifier":"unstated","modality":"actual","conditions":["in northern dialects (北部方言)"]},"forms":["tek","wa"],"statements":[{"id":"stmt:kindaichi1936@gemini-3-flash-preview/l0159-03","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-13-12-354Z","status":"grouped"}
{"id":"claim:complex/sequential-wa-and-clause-chaining--the-conjunction-wa-generally-indicates-sequential-coordination-of","revision":1,"topic":"topic:complex/sequential-wa-and-clause-chaining","topics":["topic:complex/sequential-wa-and-clause-chaining","topic:complex/sequential-wa-and-clause-chaining--readings"],"statement":{"en":"The conjunction wa generally indicates sequential coordination of events, but can also indicate simultaneous events in constructions such as kotan epunkine wa an 'is watching over the village'.","ja":"wa は一般に異時並列の関係であるが、kotan epunkine wa an のような場合には同時である。"},"type":"form-function","scope":{"doculects":[],"quantifier":"usually","modality":"actual","conditions":[]},"forms":["wa"],"statements":[{"id":"stmt:kindaichi1936@gemini-3-flash-preview/l0160-02","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-13-12-354Z","status":"grouped"}
{"id":"claim:complex/sequential-wa-and-clause-chaining--in-colloquial-iburi-ainu-wa-is-omitted-only","revision":1,"topic":"topic:complex/sequential-wa-and-clause-chaining","topics":["topic:complex/sequential-wa-and-clause-chaining","topic:complex/sequential-wa-and-clause-chaining--readings"],"statement":{"en":"In colloquial Iburi Ainu, wa is omitted only in the combinations rai (wa) oman, kor (wa) oman, and kor (wa) ek.","ja":"胆振地方の口語では、rai (wa) oman、kor (wa) oman、kor (wa) ek の場合に限って wa を省く。"},"type":"distribution","scope":{"doculects":["doculect:hokkaido/southwest/horobetsu"],"quantifier":"unstated","modality":"actual","conditions":["colloquial speech","only with rai oman, kor oman, kor ek"]},"forms":["wa","rai oman","kor oman","kor ek"],"statements":[{"id":"stmt:kindaichi1936@gemini-3-flash-preview/l0160-03","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-13-12-354Z","status":"grouped"}
{"id":"claim:complex/sequential-wa-and-clause-chaining--the-conjunctive-particle-wa-indicates-that-the-preceding","revision":1,"topic":"topic:complex/sequential-wa-and-clause-chaining","topics":["topic:complex/sequential-wa-and-clause-chaining","topic:complex/sequential-wa-and-clause-chaining--readings"],"statement":{"en":"The conjunctive particle wa indicates that the preceding and following actions combine into a single integrated action ('doing ~ and ~').","ja":"接続助詞 wa は《〜して〜する》を表し、前の行動と後の行動が一体となって一つのまとまった行動として表現し、混然として一つになった二つの動作に用いられる。"},"type":"form-function","scope":{"doculects":["doculect:sakhalin"],"quantifier":"generic","modality":"actual","conditions":[]},"forms":["wa"],"statements":[{"id":"stmt:murasaki2025@gemini-3-flash-preview/l0103-01","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-13-12-354Z","status":"grouped"}
{"id":"claim:complex/sequential-wa-and-clause-chaining--while-wa-and-can-be-used-similarly-to","revision":1,"topic":"topic:complex/sequential-wa-and-clause-chaining","topics":["topic:complex/sequential-wa-and-clause-chaining","topic:complex/sequential-wa-and-clause-chaining--readings"],"statement":{"en":"While wa ('and') can be used similarly to hine, wa is used when the actions of the preceding and following verb phrases are more closely related and unified into a single action, such as in cause-and-effect relations, manner/state descriptions, or continuous action chains.","ja":"接続助詞 wa「〜して」は hine と同じようにも使われるが、前後の動詞句の表す行為が因果関係や状態・方法、一連の動作など、より密接に関連して一体化している場合に用いられる。"},"type":"form-function","scope":{"doculects":["doculect:hokkaido"],"quantifier":"generic","modality":"actual","conditions":[]},"forms":["wa"],"statements":[{"id":"stmt:nakagawa2024@gemini-3-flash-preview/l0336-01","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-13-12-354Z","status":"grouped"}
{"id":"claim:complex/sequential-wa-and-clause-chaining--in-saru-ainu-wa-kor-and-no-can","revision":1,"topic":"topic:complex/sequential-wa-and-clause-chaining","topics":["topic:complex/sequential-wa-and-clause-chaining","topic:complex/sequential-wa-and-clause-chaining--readings"],"statement":{"en":"In Saru Ainu, wa, kor, and no can be distinguished based on the temporal phase of the preceding verb phrase: wa indicates a resulting state after an action has ended, kor indicates being in the middle of an action, and no indicates a state with no temporal change.","ja":"沙流方言において、wa, kor, no は、前に来る動詞句の時間的な局面によって使い分けられていると言え、wa は動作・行為が終わったあとの結果の状態、kor は動作・行為が行われている最中、no は時間的な変化がない状態を表す。"},"type":"form-function","scope":{"doculects":["doculect:hokkaido/southwest/saru"],"quantifier":"generic","modality":"actual","conditions":[]},"forms":["wa","kor","no"],"statements":[{"id":"stmt:nakagawa2024@gemini-3-flash-preview/l0338-02","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-13-12-354Z","status":"grouped"}
{"id":"claim:complex/sequential-wa-and-clause-chaining--verbs-like-se-express-the-motion-up-to","revision":1,"topic":"topic:complex/sequential-wa-and-clause-chaining","topics":["topic:complex/sequential-wa-and-clause-chaining","topic:complex/sequential-wa-and-clause-chaining--readings"],"statement":{"en":"Verbs like se express the motion up to carrying something on one's back, so that 'going with a load on one's back' is expressed as se wa arpa rather than *se kor arpa, which would mean setting off while loading the burden onto one's back.","ja":"se「～を背負う」のような動詞は背負っていないものを背中に負うまでの動作を表しているため、「背中に荷物がある状態で行く」のは se wa arpa であり、se kor arpa は荷物を背中に担ぎ上げながら出発することを表すことになる。"},"type":"analysis","scope":{"doculects":["doculect:hokkaido/southwest/saru"],"quantifier":"generic","modality":"actual","conditions":[]},"forms":["se wa arpa","se kor arpa"],"statements":[{"id":"stmt:nakagawa2024@gemini-3-flash-preview/l0338-04","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-13-12-354Z","status":"grouped"}
{"id":"claim:complex/sequential-wa-and-clause-chaining--wa-usually-links-two-actions-states-or-events","revision":1,"topic":"topic:complex/sequential-wa-and-clause-chaining","topics":["topic:complex/sequential-wa-and-clause-chaining","topic:complex/sequential-wa-and-clause-chaining--readings"],"statement":{"en":"Wa usually links two actions, states, or events by simply enumerating them without prioritizing one over the other.","ja":"wa は通常、2つの動作、状態、または出来事を一方を他方より強調することなく単に列挙して結びつける。"},"type":"form-function","scope":{"doculects":["doculect:ainu"],"quantifier":"usually","modality":"actual","conditions":[]},"forms":["wa"],"statements":[{"id":"stmt:refsing1986@gemini-3-flash-preview/l0233-09","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-13-12-354Z","status":"grouped"}
{"id":"claim:complex/sequential-wa-and-clause-chaining--wa-may-sometimes-indicate-a-slight-temporal-relationship","revision":1,"topic":"topic:complex/sequential-wa-and-clause-chaining","topics":["topic:complex/sequential-wa-and-clause-chaining","topic:complex/sequential-wa-and-clause-chaining--readings"],"statement":{"en":"Wa may sometimes indicate a slight temporal relationship, where the event in the conjunctionalized clause precedes the final predicate.","ja":"wa は時にわずかな時間的関係を表すことがあり、その場合、接続語化された節の事象は主述語の事象より先行して生起する。"},"type":"form-function","scope":{"doculects":["doculect:ainu"],"quantifier":"exists","modality":"possible","conditions":[]},"forms":["wa"],"statements":[{"id":"stmt:refsing1986@gemini-3-flash-preview/l0233-10","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-13-12-354Z","status":"grouped"}
{"id":"claim:complex/sequential-wa-and-clause-chaining--a-clause-conjunctionalized-with-wa-may-appear-as","revision":1,"topic":"topic:complex/sequential-wa-and-clause-chaining","topics":["topic:complex/sequential-wa-and-clause-chaining","topic:complex/sequential-wa-and-clause-chaining--readings"],"statement":{"en":"A clause conjunctionalized with wa may appear as a prerequisite describing the circumstances under which the action, event, or state expressed in the final predicate is realized.","ja":"waによって接続文化された節は前提として現れることがあり、最終述語で表現される動作・出来事・状態が実現する状況を述べる。"},"type":"form-function","scope":{"doculects":["doculect:hokkaido/southwest/shizunai"],"quantifier":"generic","modality":"possible","conditions":[]},"forms":["wa"],"statements":[{"id":"stmt:refsing1986@gemini-3-flash-preview/l0234-01","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-13-12-354Z","status":"grouped"}
{"id":"claim:complex/sequential-wa-and-clause-chaining--in-all-cases-where-wa-is-used-a","revision":1,"topic":"topic:complex/sequential-wa-and-clause-chaining","topics":["topic:complex/sequential-wa-and-clause-chaining","topic:complex/sequential-wa-and-clause-chaining--readings"],"statement":{"en":"In all cases where wa is used, a very close connection between the conjunctionalized clause and the final predicate is indicated.","ja":"waが用いられるすべての場合において、接続文化された節と最終述語との間の極めて緊密な関係が示される。"},"type":"form-function","scope":{"doculects":["doculect:hokkaido/southwest/shizunai"],"quantifier":"all","modality":"actual","conditions":[]},"forms":["wa"],"statements":[{"id":"stmt:refsing1986@gemini-3-flash-preview/l0234-04","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-13-12-354Z","status":"grouped"}
{"id":"claim:complex/sequential-wa-and-clause-chaining--western-and-southern-hokkaido-dialects-use-wa-or","revision":1,"topic":"topic:complex/sequential-wa-and-clause-chaining","topics":["topic:complex/sequential-wa-and-clause-chaining","topic:complex/sequential-wa-and-clause-chaining--readings"],"statement":{"en":"Western and southern Hokkaido dialects use wa or orwa instead of tek to express 'after (doing A, to do B)'.","ja":"北海道西部・南部方言では、「（Aをして）から（Bをする）」という意味を表すのにtekではなくwaまたはorwaを用いる。"},"type":"variation","scope":{"doculects":["doculect:hokkaido/southwest"],"quantifier":"unstated","modality":"actual","conditions":[]},"forms":["wa","orwa"],"statements":[{"id":"stmt:refsing1986@gemini-3-flash-preview/l0240-10","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-13-12-354Z","status":"grouped"}
{"id":"claim:complex/sequential-wa-and-clause-chaining--expressions-linked-by-wa-tend-more-strongly-to","revision":1,"topic":"topic:complex/sequential-wa-and-clause-chaining","topics":["topic:complex/sequential-wa-and-clause-chaining","topic:complex/sequential-wa-and-clause-chaining--readings"],"statement":{"en":"Expressions linked by wa tend more strongly to represent a single cohesive unit of action as a whole, whereas expressions linked by hine show weaker cohesion.","ja":"wa で結ばれた表現は全体としてひとまとまりの行為を表す傾向が強く，それに比べると hine で結ばれた表現はまとまりが弱い。"},"type":"form-function","scope":{"doculects":["doculect:hokkaido"],"quantifier":"generic","modality":"actual","conditions":[]},"forms":["wa","hine"],"statements":[{"id":"stmt:sato2008@gemini-3-flash-preview/l0061-04","stance":"proposes"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-13-12-354Z","status":"grouped"}
{"id":"claim:complex/sequential-wa-and-clause-chaining--the-conjunctive-particle-wa-expresses-that-an-action","revision":1,"topic":"topic:complex/sequential-wa-and-clause-chaining","topics":["topic:complex/sequential-wa-and-clause-chaining","topic:complex/sequential-wa-and-clause-chaining--readings"],"statement":{"en":"The conjunctive particle wa expresses that an action is performed consecutively following another action, and this sequential meaning can be made explicit by a following adverbial phrase oro wa 'then'.","ja":"接続助詞 wa は，ある行為に引き続いて別な行為が行われることを表し，副詞句 oro wa 「それから」が後続して継起の意味が明示されることもある。"},"type":"form-function","scope":{"doculects":["doculect:hokkaido"],"quantifier":"generic","modality":"actual","conditions":[]},"forms":["wa","oro wa"],"statements":[{"id":"stmt:sato2008@gemini-3-flash-preview/l0062-03","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-13-12-354Z","status":"grouped"}
{"id":"claim:complex/sequential-wa-and-clause-chaining--the-conjunctive-particle-wa-expresses-that-another-action","revision":1,"topic":"topic:complex/sequential-wa-and-clause-chaining","topics":["topic:complex/sequential-wa-and-clause-chaining","topic:complex/sequential-wa-and-clause-chaining--readings"],"statement":{"en":"The conjunctive particle wa expresses that another action occurs because of a certain action, sometimes followed by the adverb kusu 'therefore'.","ja":"接続助詞 wa は，ある行為が原因で別な行為が生ずることを表し，副詞 kusu 「それ故に」が後続することもある。"},"type":"form-function","scope":{"doculects":["doculect:hokkaido"],"quantifier":"generic","modality":"actual","conditions":[]},"forms":["wa","kusu"],"statements":[{"id":"stmt:sato2008@gemini-3-flash-preview/l0062-04","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-13-12-354Z","status":"grouped"}
{"id":"claim:complex/sequential-wa-and-clause-chaining--the-conjunctive-particle-wa-expresses-attendant-circumstance-and","revision":1,"topic":"topic:complex/sequential-wa-and-clause-chaining","topics":["topic:complex/sequential-wa-and-clause-chaining","topic:complex/sequential-wa-and-clause-chaining--readings"],"statement":{"en":"The conjunctive particle wa expresses attendant circumstance and the manner in which an action is performed.","ja":"接続助詞 wa は，付帯状況，動作の行われ方を表す。"},"type":"form-function","scope":{"doculects":["doculect:hokkaido"],"quantifier":"generic","modality":"actual","conditions":[]},"forms":["wa"],"statements":[{"id":"stmt:sato2008@gemini-3-flash-preview/l0063-01","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-13-12-354Z","status":"grouped"}
{"id":"claim:complex/sequential-wa-and-clause-chaining--when-wa-indicates-attendant-circumstances-it-often-implies","revision":1,"topic":"topic:complex/sequential-wa-and-clause-chaining","topics":["topic:complex/sequential-wa-and-clause-chaining","topic:complex/sequential-wa-and-clause-chaining--readings"],"statement":{"en":"When wa indicates attendant circumstances, it often implies a certain chronological order rather than completely simultaneous actions.","ja":"wa は付帯状況を示すことがあるが，全く同時進行の動作というよりはむしろ，ある程度の前後関係を含意する場合が多いようである。"},"type":"form-function","scope":{"doculects":["doculect:hokkaido"],"quantifier":"usually","modality":"actual","conditions":["attendant circumstance"]},"forms":["wa"],"statements":[{"id":"stmt:sato2008@gemini-3-flash-preview/l0063-03","stance":"proposes"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-13-12-354Z","status":"grouped"}
{"id":"claim:complex/sequential-wa-and-clause-chaining--the-coordinating-conjunction-wa-and-is-the-most","revision":1,"topic":"topic:complex/sequential-wa-and-clause-chaining","topics":["topic:complex/sequential-wa-and-clause-chaining","topic:complex/sequential-wa-and-clause-chaining--subject-continuity"],"statement":{"en":"The coordinating conjunction wa 'and' is the most commonly used coordinator and can join clauses even when their subjects are non-coreferential.","ja":"等位接続詞 wa「そして」は最も頻繁に用いられる等位接続詞であり、主語が同一でない場合にも用いることができる。"},"type":"distribution","scope":{"doculects":["doculect:hokkaido/southwest"],"quantifier":"generic","modality":"actual","conditions":[]},"forms":["wa"],"statements":[{"id":"stmt:bugaeva2012@gemini-3-flash-preview/l0020-17","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-13-12-354Z","status":"grouped"}
{"id":"claim:complex/sequential-wa-and-clause-chaining--in-about-90-of-the-examples-in-the","revision":1,"topic":"topic:complex/sequential-wa-and-clause-chaining","topics":["topic:complex/sequential-wa-and-clause-chaining","topic:complex/sequential-wa-and-clause-chaining--subject-continuity"],"statement":{"en":"In about 90% of the examples in the author's Shizunai corpus, the predicates joined by wa share the same subject.","ja":"著者の静内方言資料における用例の約90%において、waによって結ばれた述語は同一の主語を持つ。"},"type":"frequency","scope":{"doculects":["doculect:hokkaido/southwest/shizunai"],"quantifier":"measured","modality":"actual","conditions":[]},"forms":["wa"],"statements":[{"id":"stmt:refsing1986@gemini-3-flash-preview/l0234-05","stance":"asserts"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-13-12-354Z","status":"grouped"}
{"id":"claim:complex/sequential-wa-and-clause-chaining--unlike-japanese-te-which-requires-the-omitted-subject","revision":1,"topic":"topic:complex/sequential-wa-and-clause-chaining","topics":["topic:complex/sequential-wa-and-clause-chaining","topic:complex/sequential-wa-and-clause-chaining--subject-continuity"],"statement":{"en":"Unlike Japanese -te, which requires the omitted subject of the main clause to be coreferential with the subject of the -te clause, Ainu wa appears to have no such constraint.","ja":"日本語の「〜て」は省略されている主節の主語が「〜て」節の中の主語と同一であることを要求するが，アイヌ語の wa にはそのような制約がないようである。"},"type":"distribution","scope":{"doculects":["doculect:hokkaido"],"quantifier":"generic","modality":"actual","conditions":[]},"forms":["wa"],"statements":[{"id":"stmt:sato2008@gemini-3-flash-preview/l0063-02","stance":"proposes"}],"relations":[],"grouped_by":"act:group/2026-09-10T15-13-12-354Z","status":"grouped"}

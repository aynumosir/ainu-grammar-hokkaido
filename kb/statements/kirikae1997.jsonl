{"id":"stmt:kirikae1997@gemini-3-flash-preview/l0003-05","source":"source:kirikae1997","asset":"asset:kirikae1997@gemini-3-flash-preview","locator":{"leaf":3,"printed":null,"section":null,"example":null},"anchor":{"exact":"口蓋化・非口蓋化（拗音・直音）の対立がない。","match":1,"method":"exact","leaf":3},"statement":{"en":"Ainu lacks a contrast between palatalized and non-palatalized consonants (youon vs. chokuon).","ja":"アイヌ語には口蓋化・非口蓋化（拗音・直音）の対立がない。"},"type":"absence","stance":"asserts","scope":{"doculects":["doculect:ainu"],"quantifier":"none","modality":"actual","conditions":[]},"hedge":null,"reported":null,"forms":[],"topics":["topic:phon/consonant-inventory","topic:phon/syllable-template","topic:phon/consonant-inventory--phonemes"],"extracted_by":"act:extract/kirikae1997/2026-09-10T14-20-10-766Z","verification":{"anchor":"pass","image":"not-applicable","entailment":{"verdict":"yes","quote":"● 口蓋化・非口蓋化（拗音・直音）の対立がない。","note":null,"model":"deepseek/deepseek-v4-flash","prompt_version":"verify-v1.0","date":"2026-09-10"},"human":null},"status":"checked","routing":{"section":"topic:phon/consonant-inventory--phonemes","model":"deepseek/deepseek-v4-flash","prompt_version":"route-v1.0","date":"2026-09-10"}}
{"id":"stmt:kirikae1997@gemini-3-flash-preview/l0004-01","source":"source:kirikae1997","asset":"asset:kirikae1997@gemini-3-flash-preview","locator":{"leaf":4,"printed":4,"section":null,"example":null},"anchor":{"exact":"音節末で多くの子音が対立する。特に弾き音が現われる。","match":1,"method":"exact","leaf":4},"statement":{"en":"Many consonants contrast in syllable-coda position in Ainu, and the tap consonant r in particular occurs there.","ja":"アイヌ語では音節末で多くの子音が対立し、特に弾き音（r）が現われる。"},"type":"distribution","stance":"asserts","scope":{"doculects":["doculect:ainu"],"quantifier":"generic","modality":"actual","conditions":["in syllable-coda position"]},"hedge":null,"reported":null,"forms":["r"],"topics":["topic:phon/rhotic-r","topic:phon/syllable-template","topic:phon/rhotic-r--overview"],"extracted_by":"act:extract/kirikae1997/2026-09-10T14-20-10-766Z","verification":{"anchor":"pass","image":"not-applicable","entailment":{"verdict":"yes","quote":"音節末で多くの子音が対立する。特に弾き音が現われる。","note":null,"model":"deepseek/deepseek-v4-flash","prompt_version":"verify-v1.0","date":"2026-09-10"},"human":null},"status":"checked","routing":{"section":"topic:phon/rhotic-r--overview","model":"deepseek/deepseek-v4-flash","prompt_version":"route-v1.0","date":"2026-09-10"}}
{"id":"stmt:kirikae1997@gemini-3-flash-preview/l0004-02","source":"source:kirikae1997","asset":"asset:kirikae1997@gemini-3-flash-preview","locator":{"leaf":4,"printed":4,"section":null,"example":null},"anchor":{"exact":"音節末の子音の出わたりが顕著ではない。特に閉鎖音は破裂を伴わない。","match":1,"method":"exact","leaf":4},"statement":{"en":"The transition/release of syllable-coda consonants is not prominent in Ainu, and stop consonants in particular lack plosion.","ja":"アイヌ語では音節末の子音の出わたりが顕著ではなく、特に閉鎖音は破裂を伴わない。"},"type":"distribution","stance":"asserts","scope":{"doculects":["doculect:ainu"],"quantifier":"generic","modality":"actual","conditions":["in syllable-coda position"]},"hedge":null,"reported":null,"forms":[],"topics":["topic:phon/consonant-inventory","topic:phon/syllable-template","topic:phon/consonant-inventory--coda"],"extracted_by":"act:extract/kirikae1997/2026-09-10T14-20-10-766Z","verification":{"anchor":"pass","image":"not-applicable","entailment":{"verdict":"yes","quote":"音節末の子音の出わたりが顕著ではない。特に閉鎖音は破裂を伴わない。","note":null,"model":"deepseek/deepseek-v4-flash","prompt_version":"verify-v1.0","date":"2026-09-10"},"human":null},"status":"checked","routing":{"section":"topic:phon/consonant-inventory--coda","model":"deepseek/deepseek-v4-flash","prompt_version":"route-v1.0","date":"2026-09-10"}}
